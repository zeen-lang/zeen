fn combine(a: [4]i32, b: [4]i32) [4]i32 {
  return a + b;
}

fn main() {
  const a: [4]i32 = {1, 2, 3, 4};
  const b: [4]i32 = {5, 6, 7, 8};

  @println("sum: {:?}", a + b);
  @println("diff: {:?}", b - a);
  @println("prod: {:?}", a * b);
  @println("div: {:?}", b / a);
  @println("mod: {:?}", b % a);

  @println("scale: {:?}", a * 3);
  @println("shift: {:?}", a + 10);
  @println("half: {:?}", b / 2);

  @println("combine: {:?}", combine(a, b));

  let acc: [4]i32 = {0; 4};
  acc = acc + a;
  acc = acc * 2;
  @println("acc: {:?}", acc);

  const p: *[4]i32 = &a;
  const q: *[4]i32 = &b;

  @println("ptr sum: {:?}", p + q);
  @println("ptr diff: {:?}", q - p);
  @println("ptr scale: {:?}", p * 4);

  const f: [4]f32 = {1.5, 2.5, 3.5, 4.5};
  const g: [4]f32 = {0.5, 1.0, 2.0, 4.0};

  @println("f sum: {:?}", f + g);
  @println("f mul: {:?}", f * g);
  @println("f mod: {:?}", f % g);
  @println("f scale: {:?}", f * 2.0);

  const small: [8]u8 = {1, 2, 3, 4, 5, 6, 7, 8};
  @println("u8: {:?}", small * 2);
}
