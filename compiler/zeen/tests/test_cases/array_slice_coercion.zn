struct Buf {
  pub items: []const i32,
}

fn sum(values: []const i32) i32 {
  let total = 0;

  for (value : values) {
    total += value;
  }

  return total;
}

fn generic_len[T](values: []const T) usize {
  return values.len;
}

fn main() {
  let a: [3]i32 = {1, 2, 3};
  let b: []const i32 = a;
  let c: []const i32 = {10, 20, 30};
  let wrapped = Buf { .items = a };
  let picked = if (true) { a } else { c };
  let chosen = switch (1) {
    1 => {4, 5},
    _ => c,
  };
  let cast = @as([]const i32, a);

  @println("{} {} {}", b[0], c[2], wrapped.items[1]);
  @println("{} {}", sum(a), sum({7, 8}));
  @println("{} {}", generic_len({1, 2, 3, 4}), picked[2]);
  @println("{} {}", chosen[1], String.from("hello"));
  @println("{} {}", cast[1], sum(@as([]const i32, {8, 9})));
}
