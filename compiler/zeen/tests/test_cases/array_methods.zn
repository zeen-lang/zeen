fn main() {
  const a: [4]i32 = {1, 2, 3, 4};

  @println("{} {} {}", a.is_empty(), *a.first().unwrap(), *a.last().unwrap());
  @println("{} {} {}", *a.get(1).unwrap(), a.get(9).is_none(), a.position(3).unwrap());
  @println("{} {}", a.contains(2), a.contains(7));

  const doubled: [4]i32 = a.map(|v| v * 2);
  const repeated: [8]i32 = a.repeat();
  @println("{:?} {:?}", doubled, repeated);

  let filled: [3]u8 = @uninit();
  filled.fill(7);
  @println("{:?}", filled);

  let b: [3]i32 = {5, 6, 7};
  *b.get_mut(1).unwrap() = 60;
  b.swap(0, 2);
  @println("{:?}", b);
  b.reverse();
  @println("{:?}", b);
}
