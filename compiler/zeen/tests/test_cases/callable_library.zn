use std.collections.list;

fn main() {
  let some: Option[i32] = Option.Some(3);
  let none: Option[i32] = Option.None;

  @println("{} {}", some.map(|x| x * 2).unwrap_or(0), none.map(|x| x * 2).unwrap_or(0));
  @println("{}", some.and_then(|x| Option.Some(x + 1)).unwrap_or(0));
  @println("{} {}", some.filter(|x| *x > 2).is_some(), some.filter(|x| *x > 3).is_some());

  let ok: Result[i32, i32] = Result.Ok(4);
  let err: Result[i32, i32] = Result.Err(2);

  @println("{}", ok.map(|x| x + 1).unwrap());
  @println("{}", err.map_err(|e| e * 10).unwrap_err());

  let nums: List[i32] = List.new();
  nums.push(1);
  nums.push(2);
  nums.push(3);
  nums.push(4);

  const evens: List[i32] = nums
    .iter()
    .map(|x| *x * 2)
    .filter(|x| x > 4)
    .collect();

  const total: i32 = nums
    .iter()
    .map(|x| *x * 2)
    .filter(|x| x > 4)
    .fold(0, |acc, x| acc + x);

  @println("{} {}", evens.len(), total);
  @println("{} {}", nums.iter().any(|x| *x > 3), nums.iter().all(|x| *x > 0));
}
