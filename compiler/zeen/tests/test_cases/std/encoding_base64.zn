use std.encoding.base64;

fn main() i32 {
  @println("[{}][{}][{}][{}][{}][{}][{}]", Base64.encode(""), Base64.encode("f"), Base64.encode("fo"), Base64.encode("foo"), Base64.encode("foob"), Base64.encode("fooba"), Base64.encode("foobar"));
  let back = Base64.decode("Zm9vYmFy");
  if (back.is_some()) {
    @println("roundtrip={}", back.unwrap());
  };
  @println("bad={} {}", Base64.decode("!!!!").is_none(), Base64.decode("a").is_none());
  @println("nopad={} {}", Base64.decode("Zg").unwrap(), Base64.decode("Zm8").unwrap());
  @println("strict={} {} {}", Base64.decode("Z===").is_none(), Base64.decode("Zg=").is_none(), Base64.decode("Zh==").is_none());
  const raw: [2]char = {@as(char, 251), @as(char, 255)};
  const url = Base64.encode_url(raw[..]);
  @println("url={} back={}", url, Base64.decode_url(url.trim()).unwrap().len());
  @println("urlbad={}", Base64.decode_url("+/8=").is_none());
  return 0;
}
