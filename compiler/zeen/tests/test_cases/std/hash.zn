use std.hash;

fn main() i32 {
  const empty: []const char = "";
  @println("{}|{}|{}|{}", Fnv1a64.hash(empty), Fnv1a64.hash("a"), Fnv1a64.hash("foobar"), Fnv1a64.hash("hello world"));
  @println("{}|{}|{}|{}", Fnv1a32.hash(empty), Fnv1a32.hash("a"), Fnv1a32.hash("foobar"), Fnv1a32.hash("hello world"));
  @println("{}|{}|{}", Crc32.hash(empty), Crc32.hash("123456789"), Crc32.hash("hello world"));
  @println("{}|{}|{}", Crc64.hash(empty), Crc64.hash("123456789"), Crc64.hash("hello world"));
  @println("{}|{}|{}", XxHash64.hash(empty), XxHash64.hash("abc"), XxHash64.hash("hello world"));
  const key: [2]u64 = {0x0706050403020100, 0x0F0E0D0C0B0A0908};
  @println("{}|{}|{}", SipHash64.hash(key, empty), SipHash64.hash(key, "a"), SipHash64.hash(key, "hello world"));
  return 0;
}
