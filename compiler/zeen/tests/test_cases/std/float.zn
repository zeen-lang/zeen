use std.math;

fn sqrt_of[T: Float](x: T) T {
  return x.sqrt();
}

fn cbrt_of[T: Float](x: T) T {
  return x.cbrt();
}

fn hypot_of[T: Float](x: T, y: T) T {
  return x.hypot(y);
}

fn pow_of[T: Float](x: T, y: T) T {
  return x.pow(y);
}

fn powi_of[T: Float](x: T, n: i32) T {
  return x.powi(n);
}

fn exp_of[T: Float](x: T) T {
  return x.exp();
}

fn ln_of[T: Float](x: T) T {
  return x.ln();
}

fn log_of[T: Float](x: T, base: T) T {
  return x.log(base);
}

fn rem_of[T: Float](x: T, y: T) T {
  return x.rem(y);
}

fn sin_of[T: Float](x: T) T {
  return x.sin();
}

fn atan2_of[T: Float](y: T, x: T) T {
  return y.atan2(x);
}

fn floor_of[T: Float](x: T) T {
  return x.floor();
}

fn abs_of[T: Float](x: T) T {
  return x.abs();
}

fn signum_of[T: Float](x: T) T {
  return x.signum();
}

fn copysign_of[T: Float](x: T, sign: T) T {
  return x.copysign(sign);
}

fn mul_add_of[T: Float](x: T, a: T, b: T) T {
  return x.mul_add(a, b);
}

fn lerp_of[T: Float](a: T, b: T, t: T) T {
  return a.lerp(b, t);
}

fn degrees_of[T: Float](x: T) T {
  return x.to_degrees();
}

fn is_nan_of[T: Float](x: T) bool {
  return x.is_nan();
}

fn is_inf_of[T: Float](x: T) bool {
  return x.is_inf();
}

fn is_finite_of[T: Float](x: T) bool {
  return x.is_finite();
}

fn is_sign_positive_of[T: Float](x: T) bool {
  return x.is_sign_positive();
}

fn is_sign_negative_of[T: Float](x: T) bool {
  return x.is_sign_negative();
}

fn main() {
  const a: f64 = 36.0;
  const b: f32 = 36.0;

  @println("{:.4} {:.4}", sqrt_of(a), sqrt_of(b));
  @println("{:.4} {:.4}", cbrt_of(27.0), cbrt_of(@as(f32, 27.0)));
  @println("{:.4} {:.4}", hypot_of(3.0, 4.0), hypot_of(@as(f32, 3.0), 4.0));
  @println("{:.4} {:.4}", pow_of(2.0, 10.0), pow_of(@as(f32, 2.0), 10.0));
  @println("{:.4} {:.4}", powi_of(2.0, 10), powi_of(@as(f32, 2.0), 10));
  @println("{:.4} {:.4}", exp_of(0.0), exp_of(@as(f32, 0.0)));
  @println("{:.4} {:.4}", ln_of(E), ln_of(@as(f32, E)));
  @println("{:.4} {:.4}", log_of(8.0, 2.0), log_of(@as(f32, 8.0), 2.0));
  @println("{:.4} {:.4}", rem_of(7.0, 2.0), rem_of(@as(f32, 7.0), 2.0));
  @println("{:.4} {:.4}", sin_of(0.0), sin_of(@as(f32, 0.0)));
  @println("{:.4} {:.4}", atan2_of(1.0, 1.0), atan2_of(@as(f32, 1.0), 1.0));
  @println("{:.4} {:.4}", floor_of(2.7), floor_of(@as(f32, 2.7)));
  @println("{:.4} {:.4}", abs_of(0.0 - 7.5), abs_of(@as(f32, 0.0 - 7.5)));
  @println("{:.4} {:.4}", signum_of(0.0 - 3.0), signum_of(@as(f32, 0.0 - 3.0)));
  @println("{:.4} {:.4}", copysign_of(3.0, 0.0 - 1.0), copysign_of(@as(f32, 3.0), 0.0 - 1.0));
  @println("{:.4} {:.4}", mul_add_of(2.0, 3.0, 1.0), mul_add_of(@as(f32, 2.0), 3.0, 1.0));
  @println("{:.4} {:.4}", lerp_of(1.0, 3.0, 0.5), lerp_of(@as(f32, 1.0), 3.0, 0.5));
  @println("{:.4} {:.4}", degrees_of(PI), degrees_of(@as(f32, PI)));

  @println("{} {}", is_nan_of(a), is_nan_of(b));
  @println("{} {}", is_inf_of(a), is_inf_of(b));
  @println("{} {}", is_finite_of(a), is_finite_of(b));
  @println("{} {}", is_sign_positive_of(a), is_sign_positive_of(b));
  @println("{} {}", is_sign_negative_of(a), is_sign_negative_of(b));
}
