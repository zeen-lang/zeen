use std.string;
use std.strconv;
use std.testing;

/// @test
pub fn parse_i32_checks_range() {
  assert_eq(parse_i32("42").unwrap(), 42);
  assert_eq(parse_i32("  -17  ").unwrap(), -17);
  assert_eq(parse_i32("+8").unwrap(), 8);
  assert_eq(parse_i32("2147483647").unwrap(), 2147483647);
  assert(parse_i32("2147483648").is_none());
  assert_eq(parse_i32("-2147483648").unwrap(), -2147483648);
  assert(parse_i32("-2147483649").is_none());
  assert(parse_i32("").is_none());
  assert(parse_i32("12x").is_none());
  assert(parse_i32("--5").is_none());
}

/// @test
pub fn parse_i64_checks_range() {
  assert_eq(parse_i64("9223372036854775807").unwrap(), i64.max_value());
  assert(parse_i64("9223372036854775808").is_none());
  assert_eq(parse_i64("-9223372036854775808").unwrap(), i64.min_value());
  assert(parse_i64("-9223372036854775809").is_none());
}

/// @test
pub fn parse_unsigned_rejects_negative() {
  assert_eq(parse_u32("4294967295").unwrap(), @as(u32, 4294967295));
  assert(parse_u32("4294967296").is_none());
  assert(parse_u32("-1").is_none());
  assert_eq(parse_u32("+7").unwrap(), @as(u32, 7));

  assert_eq(parse_u64("18446744073709551615").unwrap(), u64.max_value());
  assert(parse_u64("18446744073709551616").is_none());
  assert_eq(parse_u64("0").unwrap(), @as(u64, 0));
}

/// @test
pub fn parse_float_accepts_common_forms() {
  assert_eq(parse_f64("3.14").unwrap(), 3.14);
  assert_eq(parse_f64("-0.5").unwrap(), -0.5);
  assert_eq(parse_f64(".5").unwrap(), 0.5);
  assert_eq(parse_f64("5.").unwrap(), 5.0);
  assert_eq(parse_f64("1e3").unwrap(), 1000.0);
  assert_eq(parse_f64("1.5E-2").unwrap(), 0.015);
  assert_eq(parse_f64("  +2.0e+1  ").unwrap(), 20.0);
  assert(parse_f64("abc").is_none());
  assert(parse_f64("1e").is_none());
  assert(parse_f64("1.2.3").is_none());

  assert_eq(parse_f32("2.5").unwrap(), @as(f32, 2.5));
  assert(parse_f32("oops").is_none());
}
