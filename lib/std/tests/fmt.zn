use std.fmt;
use std.string;
use std.testing;

fn render_uint(value: u64) String {
  let out = String.new();

  Fmt.write_uint(&out, value);

  return out;
}

fn render_int(value: i64) String {
  let out = String.new();

  Fmt.write_int(&out, value);

  return out;
}

fn render_hex(value: u64) String {
  let out = String.new();

  Fmt.write_hex(&out, value);

  return out;
}

/// @test
pub fn write_uint_renders_decimal() {
  assert_eq(render_uint(0), String.from("0"));
  assert_eq(render_uint(7), String.from("7"));
  assert_eq(render_uint(4294967295), String.from("4294967295"));
  assert_eq(render_uint(u64.max_value()), String.from("18446744073709551615"));
}

/// @test
pub fn write_int_renders_sign() {
  assert_eq(render_int(0), String.from("0"));
  assert_eq(render_int(42), String.from("42"));
  assert_eq(render_int(-42), String.from("-42"));
  assert_eq(render_int(i64.max_value()), String.from("9223372036854775807"));
  assert_eq(render_int(i64.min_value()), String.from("-9223372036854775808"));
}

/// @test
pub fn write_hex_renders_lowercase() {
  assert_eq(render_hex(0), String.from("0"));
  assert_eq(render_hex(15), String.from("f"));
  assert_eq(render_hex(255), String.from("ff"));
  assert_eq(render_hex(48879), String.from("beef"));
  assert_eq(render_hex(u64.max_value()), String.from("ffffffffffffffff"));
}

/// @test
pub fn parse_i32_checks_range() {
  assert_eq(Fmt.parse_i32("42").unwrap(), 42);
  assert_eq(Fmt.parse_i32("  -17  ").unwrap(), -17);
  assert_eq(Fmt.parse_i32("+8").unwrap(), 8);
  assert_eq(Fmt.parse_i32("2147483647").unwrap(), 2147483647);
  assert(Fmt.parse_i32("2147483648").is_none());
  assert_eq(Fmt.parse_i32("-2147483648").unwrap(), -2147483648);
  assert(Fmt.parse_i32("-2147483649").is_none());
  assert(Fmt.parse_i32("").is_none());
  assert(Fmt.parse_i32("12x").is_none());
  assert(Fmt.parse_i32("--5").is_none());
}

/// @test
pub fn parse_i64_checks_range() {
  assert_eq(Fmt.parse_i64("9223372036854775807").unwrap(), i64.max_value());
  assert(Fmt.parse_i64("9223372036854775808").is_none());
  assert_eq(Fmt.parse_i64("-9223372036854775808").unwrap(), i64.min_value());
  assert(Fmt.parse_i64("-9223372036854775809").is_none());
}

/// @test
pub fn parse_unsigned_rejects_negative() {
  assert_eq(Fmt.parse_u32("4294967295").unwrap(), @as(u32, 4294967295));
  assert(Fmt.parse_u32("4294967296").is_none());
  assert(Fmt.parse_u32("-1").is_none());
  assert_eq(Fmt.parse_u32("+7").unwrap(), @as(u32, 7));

  assert_eq(Fmt.parse_u64("18446744073709551615").unwrap(), u64.max_value());
  assert(Fmt.parse_u64("18446744073709551616").is_none());
  assert_eq(Fmt.parse_u64("0").unwrap(), @as(u64, 0));
}

/// @test
pub fn parse_float_accepts_common_forms() {
  assert_eq(Fmt.parse_f64("3.14").unwrap(), 3.14);
  assert_eq(Fmt.parse_f64("-0.5").unwrap(), -0.5);
  assert_eq(Fmt.parse_f64(".5").unwrap(), 0.5);
  assert_eq(Fmt.parse_f64("5.").unwrap(), 5.0);
  assert_eq(Fmt.parse_f64("1e3").unwrap(), 1000.0);
  assert_eq(Fmt.parse_f64("1.5E-2").unwrap(), 0.015);
  assert_eq(Fmt.parse_f64("  +2.0e+1  ").unwrap(), 20.0);
  assert(Fmt.parse_f64("abc").is_none());
  assert(Fmt.parse_f64("1e").is_none());
  assert(Fmt.parse_f64("1.2.3").is_none());

  assert_eq(Fmt.parse_f32("2.5").unwrap(), @as(f32, 2.5));
  assert(Fmt.parse_f32("oops").is_none());
}

/// @test
pub fn parse_small_integers_check_range() {
  assert_eq(Fmt.parse_i8("127").unwrap(), 127);
  assert_eq(Fmt.parse_i8("-128").unwrap(), -128);
  assert(Fmt.parse_i8("128").is_none());
  assert(Fmt.parse_i8("-129").is_none());

  assert_eq(Fmt.parse_i16("32767").unwrap(), 32767);
  assert_eq(Fmt.parse_i16("-32768").unwrap(), i16.min_value());
  assert(Fmt.parse_i16("32768").is_none());

  assert_eq(Fmt.parse_u8("255").unwrap(), 255);
  assert(Fmt.parse_u8("256").is_none());
  assert(Fmt.parse_u8("-1").is_none());

  assert_eq(Fmt.parse_u16("65535").unwrap(), 65535);
  assert(Fmt.parse_u16("65536").is_none());
}
