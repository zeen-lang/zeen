use std.string;
use std.testing;
use std.uuid;

/// @test
pub fn nil_renders_zeroes() {
  const id = Uuid.nil();

  assert(id.is_nil());
  assert_eq(@format("{}", id), String.from("00000000-0000-0000-0000-000000000000"));
  assert(!Uuid.v4().is_nil());
}

/// @test
pub fn v4_sets_version_and_variant() {
  const id = Uuid.v4();
  const bytes = id.bytes();

  assert_eq(bytes[6] >> 4, @as(u8, 4));
  assert_eq(bytes[8] & 192, @as(u8, 128));
  assert(Uuid.v4() != id);
}

/// @test
pub fn parse_round_trips_display() {
  const id = Uuid.from_str("f81d4fae-7dec-11d0-a765-00a0c91e6bf6").unwrap();

  assert_eq(@format("{}", id), String.from("f81d4fae-7dec-11d0-a765-00a0c91e6bf6"));
  assert_eq(id.bytes()[0], @as(u8, 248));
  assert_eq(id.bytes()[15], @as(u8, 246));

  const compact = Uuid.from_str("F81D4FAE7DEC11D0A76500A0C91E6BF6").unwrap();

  assert_eq(compact, id);
}

/// @test
pub fn parse_rejects_bad_input() {
  assert(Uuid.from_str("").is_none());
  assert(Uuid.from_str("f81d4fae-7dec-11d0-a765-00a0c91e6bf").is_none());
  assert(Uuid.from_str("f81d4fae-7dec-11d0-a765-00a0c91e6bf60").is_none());
  assert(Uuid.from_str("g81d4fae-7dec-11d0-a765-00a0c91e6bf6").is_none());
}
