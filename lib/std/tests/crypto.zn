use std.crypto.hash;
use std.crypto.hmac;
use std.crypto.random;
use std.crypto.sha256;
use std.crypto.sha512;
use std.crypto.util;
use std.string;
use std.testing;

/// @test
pub fn sha256_vectors() {
  assert_eq(Sha256.hexdigest(""), String.from("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"));
  assert_eq(Sha256.hexdigest("abc"), String.from("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"));
}

/// @test
pub fn sha256_streaming_matches_one_shot() {
  let hasher = Sha256.new();

  hasher.update("a");
  hasher.update("bc");

  const out = hasher.finalize();

  assert_eq(Hashing.hexdigest(out[..]), String.from("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"));
}

/// @test
pub fn sha224_vectors() {
  assert_eq(Sha224.hexdigest(""), String.from("d14a028c2a3a2bc9476102bb288234c415a2b01f828ea62ac5b3e42f"));
  assert_eq(Sha224.hexdigest("abc"), String.from("23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7"));
}

/// @test
pub fn hash_helpers() {
  assert(Hashing.digest_eq("abc", "abc"));
  assert(!Hashing.digest_eq("abc", "abd"));
  assert(!Hashing.digest_eq("abc", "ab"));
  assert_eq(Hashing.hexdigest("abc"), String.from("616263"));
}

/// @test
pub fn sha512_vectors() {
  assert_eq(Sha512.hexdigest(""), String.from("cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e"));
  assert_eq(Sha512.hexdigest("abc"), String.from("ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"));
}

/// @test
pub fn sha384_vectors() {
  assert_eq(Sha384.hexdigest(""), String.from("38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b"));
  assert_eq(Sha384.hexdigest("abc"), String.from("cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7"));
}

/// @test
pub fn sha512_streaming_matches_one_shot() {
  let hasher = Sha512.new();

  hasher.update("a");
  hasher.update("bc");

  const out = hasher.finalize();

  assert_eq(Hashing.hexdigest(out[..]), String.from("ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"));
}

/// @test
pub fn hmac_sha256_rfc4231() {
  const tag = HmacSha256.digest("Jefe", "what do ya want for nothing?");

  assert_eq(Hashing.hexdigest(tag[..]), String.from("5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"));
  assert(HmacSha256.verify("Jefe", "what do ya want for nothing?", tag[..]));
  assert(!HmacSha256.verify("Jefe", "what do ya want for nothing", tag[..]));
}

/// @test
pub fn hmac_sha512_rfc4231() {
  const tag = HmacSha512.digest("Jefe", "what do ya want for nothing?");

  assert_eq(Hashing.hexdigest(tag[..]), String.from("164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737"));
  assert(HmacSha512.verify("Jefe", "what do ya want for nothing?", tag[..]));
}

/// @test
pub fn hmac_long_key_is_hashed() {
  let key: [131]char = {'\0'; 131};
  let i: usize = 0;

  while (i < 131) {
    key[i] = @as(char, 170);
    i += 1;
  };

  const tag256 = HmacSha256.digest(key[..], "Test Using Larger Than Block-Size Key - Hash Key First");
  const tag512 = HmacSha512.digest(key[..], "Test Using Larger Than Block-Size Key - Hash Key First");

  assert_eq(Hashing.hexdigest(tag256[..]), String.from("60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54"));
  assert_eq(Hashing.hexdigest(tag512[..]), String.from("80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f3526b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598"));
}

/// @test
pub fn hmac_streaming_matches_one_shot() {
  let mac = HmacSha512.new("Jefe");

  mac.update("what do ya want ");
  mac.update("for nothing?");

  const out = mac.finalize();

  assert_eq(Hashing.hexdigest(out[..]), String.from("164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737"));
}

/// @test
pub fn crypto_util_helpers() {
  assert(constant_time_eq("abc", "abc"));
  assert(!constant_time_eq("abc", "abd"));
  assert(!constant_time_eq("abc", "ab"));

  let buf: [4]char = {'a', 'b', 'c', 'd'};

  secure_zero(buf[..]);
  assert(buf[0] == '\0');
  assert(buf[3] == '\0');
}

/// @test
pub fn crypto_random_fills_bytes() {
  let a: [32]char = {'\0'; 32};
  let b: [32]char = {'\0'; 32};
  const zeros: [32]char = {'\0'; 32};

  Random.fill_bytes(a[..]);
  Random.fill_bytes(b[..]);

  assert(!constant_time_eq(a[..], zeros[..]));
  assert(!constant_time_eq(a[..], b[..]));
  assert(Random.next_u64() != Random.next_u64());
}

/// @test
pub fn crypto_random_ranges() {
  assert(Random.below(1) == 0);
  assert(Random.int_range(5, 6) == 5);

  let i: usize = 0;

  while (i < 256) {
    assert(Random.below(10) < 10);
    assert(Random.below(4294967296) < 4294967296);

    const value = Random.int_range(7, 11);

    assert(value >= 7);
    assert(value < 11);
    i += 1;
  };
}

/// @test
pub fn crypto_random_shuffle_keeps_elements() {
  let items: [8]i32 = {1, 2, 3, 4, 5, 6, 7, 8};

  Random.shuffle(items[..]);

  let sum: i32 = 0;
  let i: usize = 0;

  while (i < 8) {
    sum += items[i];
    i += 1;
  };

  assert_eq(sum, 36);
}
