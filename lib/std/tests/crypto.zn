use std.crypto.blake2;
use std.crypto.blake3;
use std.crypto.hash;
use std.crypto.hmac;
use std.crypto.md5;
use std.crypto.random;
use std.crypto.sha1;
use std.crypto.sha256;
use std.crypto.sha3;
use std.crypto.sha512;
use std.crypto.util;
use std.string;
use std.testing;

/// @test
pub fn sha256_vectors() {
  assert_eq(Sha256.hexdigest(""), String.from("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"));
  assert_eq(Sha256.hexdigest("abc"), String.from("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"));
}

/// @test
pub fn sha256_streaming_matches_one_shot() {
  let hasher = Sha256.new();

  hasher.update("a");
  hasher.update("bc");

  const out = hasher.finalize();

  assert_eq(Hashing.hexdigest(out[..]), String.from("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"));
}

/// @test
pub fn sha224_vectors() {
  assert_eq(Sha224.hexdigest(""), String.from("d14a028c2a3a2bc9476102bb288234c415a2b01f828ea62ac5b3e42f"));
  assert_eq(Sha224.hexdigest("abc"), String.from("23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7"));
}

/// @test
pub fn hash_helpers() {
  assert(Hashing.digest_eq("abc", "abc"));
  assert(!Hashing.digest_eq("abc", "abd"));
  assert(!Hashing.digest_eq("abc", "ab"));
  assert_eq(Hashing.hexdigest("abc"), String.from("616263"));
}

/// @test
pub fn sha512_vectors() {
  assert_eq(Sha512.hexdigest(""), String.from("cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e"));
  assert_eq(Sha512.hexdigest("abc"), String.from("ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"));
}

/// @test
pub fn sha384_vectors() {
  assert_eq(Sha384.hexdigest(""), String.from("38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b"));
  assert_eq(Sha384.hexdigest("abc"), String.from("cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7"));
}

/// @test
pub fn sha512_streaming_matches_one_shot() {
  let hasher = Sha512.new();

  hasher.update("a");
  hasher.update("bc");

  const out = hasher.finalize();

  assert_eq(Hashing.hexdigest(out[..]), String.from("ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"));
}

/// @test
pub fn hmac_sha256_rfc4231() {
  const tag = HmacSha256.digest("Jefe", "what do ya want for nothing?");

  assert_eq(Hashing.hexdigest(tag[..]), String.from("5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"));
  assert(HmacSha256.verify("Jefe", "what do ya want for nothing?", tag[..]));
  assert(!HmacSha256.verify("Jefe", "what do ya want for nothing", tag[..]));
}

/// @test
pub fn hmac_sha512_rfc4231() {
  const tag = HmacSha512.digest("Jefe", "what do ya want for nothing?");

  assert_eq(Hashing.hexdigest(tag[..]), String.from("164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737"));
  assert(HmacSha512.verify("Jefe", "what do ya want for nothing?", tag[..]));
}

/// @test
pub fn hmac_long_key_is_hashed() {
  let key: [131]char = {'\0'; 131};
  let i: usize = 0;

  while (i < 131) {
    key[i] = @as(char, 170);
    i += 1;
  };

  const tag256 = HmacSha256.digest(key[..], "Test Using Larger Than Block-Size Key - Hash Key First");
  const tag512 = HmacSha512.digest(key[..], "Test Using Larger Than Block-Size Key - Hash Key First");

  assert_eq(Hashing.hexdigest(tag256[..]), String.from("60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54"));
  assert_eq(Hashing.hexdigest(tag512[..]), String.from("80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f3526b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598"));
}

/// @test
pub fn hmac_streaming_matches_one_shot() {
  let mac = HmacSha512.new("Jefe");

  mac.update("what do ya want ");
  mac.update("for nothing?");

  const out = mac.finalize();

  assert_eq(Hashing.hexdigest(out[..]), String.from("164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737"));
}

/// @test
pub fn crypto_util_helpers() {
  assert(constant_time_eq("abc", "abc"));
  assert(!constant_time_eq("abc", "abd"));
  assert(!constant_time_eq("abc", "ab"));

  let buf: [4]char = {'a', 'b', 'c', 'd'};

  secure_zero(buf[..]);
  assert(buf[0] == '\0');
  assert(buf[3] == '\0');
}

/// @test
pub fn crypto_random_fills_bytes() {
  let a: [32]char = {'\0'; 32};
  let b: [32]char = {'\0'; 32};
  const zeros: [32]char = {'\0'; 32};

  Random.fill_bytes(a[..]);
  Random.fill_bytes(b[..]);

  assert(!constant_time_eq(a[..], zeros[..]));
  assert(!constant_time_eq(a[..], b[..]));
  assert(Random.next_u64() != Random.next_u64());
}

/// @test
pub fn crypto_random_ranges() {
  assert(Random.below(1) == 0);
  assert(Random.int_range(5, 6) == 5);

  let i: usize = 0;

  while (i < 256) {
    assert(Random.below(10) < 10);
    assert(Random.below(4294967296) < 4294967296);

    const value = Random.int_range(7, 11);

    assert(value >= 7);
    assert(value < 11);
    i += 1;
  };
}

/// @test
pub fn crypto_random_shuffle_keeps_elements() {
  let items: [8]i32 = {1, 2, 3, 4, 5, 6, 7, 8};

  Random.shuffle(items[..]);

  let sum: i32 = 0;
  let i: usize = 0;

  while (i < 8) {
    sum += items[i];
    i += 1;
  };

  assert_eq(sum, 36);
}

/// @test
pub fn sha3_224_vectors() {
  assert_eq(Sha3_224.hexdigest(""), String.from("6b4e03423667dbb73b6e15454f0eb1abd4597f9a1b078e3f5b5a6bc7"));
  assert_eq(Sha3_224.hexdigest("abc"), String.from("e642824c3f8cf24ad09234ee7d3c766fc9a3a5168d0c94ad73b46fdf"));
}

/// @test
pub fn sha3_256_vectors() {
  assert_eq(Sha3_256.hexdigest(""), String.from("a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a"));
  assert_eq(Sha3_256.hexdigest("abc"), String.from("3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532"));
  assert_eq(Sha3_256.hexdigest("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"), String.from("cce34485baf2bf2aca99b94833892a4f52896d3d153f7b840cc4f9fe695f1387"));
}

/// @test
pub fn sha3_384_vectors() {
  assert_eq(Sha3_384.hexdigest(""), String.from("0c63a75b845e4f7d01107d852e4c2485c51a50aaaa94fc61995e71bbee983a2ac3713831264adb47fb6bd1e058d5f004"));
  assert_eq(Sha3_384.hexdigest("abc"), String.from("ec01498288516fc926459f58e2c6ad8df9b473cb0fc08c2596da7cf0e49be4b298d88cea927ac7f539f1edf228376d25"));
}

/// @test
pub fn sha3_512_vectors() {
  assert_eq(Sha3_512.hexdigest(""), String.from("a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a615b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26"));
  assert_eq(Sha3_512.hexdigest("abc"), String.from("b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0"));
}

/// @test
pub fn sha3_streaming_matches_one_shot() {
  let hasher = Sha3_256.new();

  hasher.update("a");
  hasher.update("bc");

  const out = hasher.finalize();

  assert_eq(Hashing.hexdigest(out[..]), String.from("3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532"));

  hasher.update("abc");

  const again = hasher.finalize();

  assert_eq(Hashing.hexdigest(again[..]), String.from("3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532"));
}

/// @test
pub fn shake128_vectors() {
  let out: [32]char = {'\0'; 32};

  Shake128.hash("abc", out[..]);
  assert_eq(Hashing.hexdigest(out[..]), String.from("5881092dd818bf5cf8a3ddb793fbcba74097d5c526a6d35f97b83351940f2cc8"));

  let long: [200]char = {'\0'; 200};

  Shake128.hash("abc", long[..]);
  assert_eq(Hashing.hexdigest(long[..]), String.from(""));
}

/// @test
pub fn shake256_vectors() {
  let out: [64]char = {'\0'; 64};

  Shake256.hash("", out[..]);
  assert_eq(Hashing.hexdigest(out[..]), String.from("46b9dd2b0ba88d13233b3feb743eeb243fcd52ea62b81b82b50c27646ed5762fd75dc4ddd8c0f200cb05019d67b592f6fc821c49479ab48640292eacb3b7c4be"));

  Shake256.hash("abc", out[..]);
  assert_eq(Hashing.hexdigest(out[..]), String.from("483366601360a8771c6863080cc4114d8db44530f8f1e1ee4f94ea37e78b5739d5a15bef186a5386c75744c0527e1faa9f8726e462a12a4feb06bd8801e751e4"));
}

/// @test
pub fn blake2b_vectors() {
  let data: [200]char = {'a'; 200};

  assert_eq(Blake2b.hexdigest(""), String.from("786a02f742015903c6c6fd852552d272912f4740e15847618a86e217f71f5419d25e1031afee585313896444934eb04b903a685b1448b755d56f701afe9be2ce"));
  assert_eq(Blake2b.hexdigest("abc"), String.from("ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d17d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923"));
  assert_eq(Blake2b.hexdigest(data[..]), String.from("932355851d75f09c18646a9da87c25e055bc57f113121ad1ec63d45e7a1d62ab9133f8b7d1d7de9e0afa784eb6a8a11d78683013d0a672611f17668d9577d209"));
}

/// @test
pub fn blake2s_vectors() {
  let data: [200]char = {'a'; 200};

  assert_eq(Blake2s.hexdigest(""), String.from("69217a3079908094e11121d042354a7c1f55b6482ca1a51e1b250dfd1ed0eef9"));
  assert_eq(Blake2s.hexdigest("abc"), String.from("508c5e8c327c14e2e1a72ba34eeb452f37458b209ed63a294d999b4c86675982"));
  assert_eq(Blake2s.hexdigest(data[..]), String.from("2b033f9f5ba9cf20671da79e492f41545e673b562603945ffed09662fd92321a"));
}

/// @test
pub fn blake2_streaming_matches_one_shot() {
  let big = Blake2b.new();
  let small = Blake2s.new();

  big.update("a");
  big.update("bc");
  small.update("a");
  small.update("bc");

  assert_eq(Hashing.hexdigest(big.finalize()[..]), String.from("ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d17d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923"));
  assert_eq(Hashing.hexdigest(small.finalize()[..]), String.from("508c5e8c327c14e2e1a72ba34eeb452f37458b209ed63a294d999b4c86675982"));
}

fn fill_blake3_pattern(data: []char) {
  let i: usize = 0;

  while (i < data.len) {
    data[i] = @as(char, i % 251);
    i += 1;
  };
}

/// @test
pub fn blake3_vectors() {
  let a64: [64]char = {'\0'; 64};
  let a1024: [1024]char = {'\0'; 1024};

  fill_blake3_pattern(a64[..]);
  fill_blake3_pattern(a1024[..]);

  assert_eq(Blake3.hexdigest(""), String.from("af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262"));
  assert_eq(Blake3.hexdigest("abc"), String.from("6437b3ac38465133ffb63b75273a8db548c558465d79db03fd359c6cd5bd9d85"));
  assert_eq(Blake3.hexdigest(a64[..]), String.from("4eed7141ea4a5cd4b788606bd23f46e212af9cacebacdc7d1f4c6dc7f2511b98"));
  assert_eq(Blake3.hexdigest(a1024[..]), String.from("42214739f095a406f3fc83deb889744ac00df831c10daa55189b5d121c855af7"));
}

/// @test
pub fn blake3_tree_vectors() {
  let a1025: [1025]char = {'\0'; 1025};
  let a2048: [2048]char = {'\0'; 2048};
  let a2049: [2049]char = {'\0'; 2049};
  let a3072: [3072]char = {'\0'; 3072};
  let a4096: [4096]char = {'\0'; 4096};

  fill_blake3_pattern(a1025[..]);
  fill_blake3_pattern(a2048[..]);
  fill_blake3_pattern(a2049[..]);
  fill_blake3_pattern(a3072[..]);
  fill_blake3_pattern(a4096[..]);

  assert_eq(Blake3.hexdigest(a1025[..]), String.from("d00278ae47eb27b34faecf67b4fe263f82d5412916c1ffd97c8cb7fb814b8444"));
  assert_eq(Blake3.hexdigest(a2048[..]), String.from("e776b6028c7cd22a4d0ba182a8bf62205d2ef576467e838ed6f2529b85fba24a"));
  assert_eq(Blake3.hexdigest(a2049[..]), String.from("5f4d72f40d7a5f82b15ca2b2e44b1de3c2ef86c426c95c1af0b6879522563030"));
  assert_eq(Blake3.hexdigest(a3072[..]), String.from("b98cb0ff3623be03326b373de6b9095218513e64f1ee2edd2525c7ad1e5cffd2"));
  assert_eq(Blake3.hexdigest(a4096[..]), String.from("015094013f57a5277b59d8475c0501042c0b642e531b0a1c8f58d2163229e969"));
}

/// @test
pub fn sha1_vectors() {
  let data: [200]char = {'a'; 200};

  assert_eq(Sha1.hexdigest(""), String.from("da39a3ee5e6b4b0d3255bfef95601890afd80709"));
  assert_eq(Sha1.hexdigest("abc"), String.from("a9993e364706816aba3e25717850c26c9cd0d89d"));
  assert_eq(Sha1.hexdigest(data[..]), String.from("e61cfffe0d9195a525fc6cf06ca2d77119c24a40"));
}

/// @test
pub fn sha1_streaming_matches_one_shot() {
  let hasher = Sha1.new();

  hasher.update("a");
  hasher.update("bc");

  assert_eq(Hashing.hexdigest(hasher.finalize()[..]), String.from("a9993e364706816aba3e25717850c26c9cd0d89d"));
}

/// @test
pub fn md5_vectors() {
  let data: [200]char = {'a'; 200};

  assert_eq(Md5.hexdigest(""), String.from("d41d8cd98f00b204e9800998ecf8427e"));
  assert_eq(Md5.hexdigest("abc"), String.from("900150983cd24fb0d6963f7d28e17f72"));
  assert_eq(Md5.hexdigest(data[..]), String.from("887f30b43b2867f4a9accceee7d16e6c"));
}

/// @test
pub fn md5_streaming_matches_one_shot() {
  let hasher = Md5.new();

  hasher.update("a");
  hasher.update("bc");

  assert_eq(Hashing.hexdigest(hasher.finalize()[..]), String.from("900150983cd24fb0d6963f7d28e17f72"));
}
