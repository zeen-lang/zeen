/// @test
pub fn sha3_streaming_matches_one_shot() {
  let hasher = Sha3_256.new();

  hasher.update("a");
  hasher.update("bc");

  const out = hasher.finalize();

  assert_eq(Hashing.hexdigest(out[..]), String.from("3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532"));

  hasher.update("abc");

  const again = hasher.finalize();

  assert_eq(Hashing.hexdigest(again[..]), String.from("3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532"));
}

/// @test
pub fn shake128_vectors() {
  let out: [32]char = {'\0'; 32};

  Shake128.hash("abc", out[..]);
  assert_eq(Hashing.hexdigest(out[..]), String.from("5881092dd818bf5cf8a3ddb793fbcba74097d5c526a6d35f97b83351940f2cc8"));

  let long: [200]char = {'\0'; 200};

  Shake128.hash("abc", long[..]);
  assert_eq(Hashing.hexdigest(long[..]), String.from(""));
}

/// @test
pub fn shake256_vectors() {
  let out: [64]char = {'\0'; 64};

  Shake256.hash("", out[..]);
  assert_eq(Hashing.hexdigest(out[..]), String.from("46b9dd2b0ba88d13233b3feb743eeb243fcd52ea62b81b82b50c27646ed5762fd75dc4ddd8c0f200cb05019d67b592f6fc821c49479ab48640292eacb3b7c4be"));

  Shake256.hash("abc", out[..]);
  assert_eq(Hashing.hexdigest(out[..]), String.from("483366601360a8771c6863080cc4114d8db44530f8f1e1ee4f94ea37e78b5739d5a15bef186a5386c75744c0527e1faa9f8726e462a12a4feb06bd8801e751e4"));
}

/// @test
pub fn blake2b_vectors() {
  let data: [200]char = {'a'; 200};

  assert_eq(Blake2b.hexdigest(""), String.from("786a02f742015903c6c6fd852552d272912f4740e15847618a86e217f71f5419d25e1031afee585313896444934eb04b903a685b1448b755d56f701afe9be2ce"));
  assert_eq(Blake2b.hexdigest("abc"), String.from("ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d17d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923"));
  assert_eq(Blake2b.hexdigest(data[..]), String.from("932355851d75f09c18646a9da87c25e055bc57f113121ad1ec63d45e7a1d62ab9133f8b7d1d7de9e0afa784eb6a8a11d78683013d0a672611f17668d9577d209"));
}

/// @test
pub fn blake2s_vectors() {
  let data: [200]char = {'a'; 200};

  assert_eq(Blake2s.hexdigest(""), String.from("69217a3079908094e11121d042354a7c1f55b6482ca1a51e1b250dfd1ed0eef9"));
  assert_eq(Blake2s.hexdigest("abc"), String.from("508c5e8c327c14e2e1a72ba34eeb452f37458b209ed63a294d999b4c86675982"));
  assert_eq(Blake2s.hexdigest(data[..]), String.from("2b033f9f5ba9cf20671da79e492f41545e673b562603945ffed09662fd92321a"));
}

/// @test
pub fn blake2_streaming_matches_one_shot() {
  let big = Blake2b.new();
  let small = Blake2s.new();

  big.update("a");
  big.update("bc");
  small.update("a");
  small.update("bc");

  assert_eq(Hashing.hexdigest(big.finalize()[..]), String.from("ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d17d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923"));
  assert_eq(Hashing.hexdigest(small.finalize()[..]), String.from("508c5e8c327c14e2e1a72ba34eeb452f37458b209ed63a294d999b4c86675982"));
}

fn fill_blake3_pattern(data: []char) {
  let i: usize = 0;

  while (i < data.len) {
    data[i] = @as(char, i % 251);
    i += 1;
  };
}

/// @test
pub fn blake3_vectors() {
  let a64: [64]char = {'\0'; 64};
  let a1024: [1024]char = {'\0'; 1024};

  fill_blake3_pattern(a64[..]);
  fill_blake3_pattern(a1024[..]);

  assert_eq(Blake3.hexdigest(""), String.from("af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262"));
  assert_eq(Blake3.hexdigest("abc"), String.from("6437b3ac38465133ffb63b75273a8db548c558465d79db03fd359c6cd5bd9d85"));
  assert_eq(Blake3.hexdigest(a64[..]), String.from("4eed7141ea4a5cd4b788606bd23f46e212af9cacebacdc7d1f4c6dc7f2511b98"));
  assert_eq(Blake3.hexdigest(a1024[..]), String.from("42214739f095a406f3fc83deb889744ac00df831c10daa55189b5d121c855af7"));
}

/// @test
pub fn blake3_tree_vectors() {
  let a1025: [1025]char = {'\0'; 1025};
  let a2048: [2048]char = {'\0'; 2048};
  let a2049: [2049]char = {'\0'; 2049};
  let a3072: [3072]char = {'\0'; 3072};
  let a4096: [4096]char = {'\0'; 4096};

  fill_blake3_pattern(a1025[..]);
  fill_blake3_pattern(a2048[..]);
  fill_blake3_pattern(a2049[..]);
  fill_blake3_pattern(a3072[..]);
  fill_blake3_pattern(a4096[..]);

  assert_eq(Blake3.hexdigest(a1025[..]), String.from("d00278ae47eb27b34faecf67b4fe263f82d5412916c1ffd97c8cb7fb814b8444"));
  assert_eq(Blake3.hexdigest(a2048[..]), String.from("e776b6028c7cd22a4d0ba182a8bf62205d2ef576467e838ed6f2529b85fba24a"));
  assert_eq(Blake3.hexdigest(a2049[..]), String.from("5f4d72f40d7a5f82b15ca2b2e44b1de3c2ef86c426c95c1af0b6879522563030"));
  assert_eq(Blake3.hexdigest(a3072[..]), String.from("b98cb0ff3623be03326b373de6b9095218513e64f1ee2edd2525c7ad1e5cffd2"));
  assert_eq(Blake3.hexdigest(a4096[..]), String.from("015094013f57a5277b59d8475c0501042c0b642e531b0a1c8f58d2163229e969"));
}

/// @test
pub fn sha1_vectors() {
  let data: [200]char = {'a'; 200};

  assert_eq(Sha1.hexdigest(""), String.from("da39a3ee5e6b4b0d3255bfef95601890afd80709"));
  assert_eq(Sha1.hexdigest("abc"), String.from("a9993e364706816aba3e25717850c26c9cd0d89d"));
  assert_eq(Sha1.hexdigest(data[..]), String.from("e61cfffe0d9195a525fc6cf06ca2d77119c24a40"));
}

