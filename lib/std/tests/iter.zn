use std.collections.list;
use std.string;
use std.testing;

fn numbers() List[i32] {
  let nums: List[i32] = List.new();

  nums.push(1);
  nums.push(2);
  nums.push(3);
  nums.push(4);

  return nums;
}

/// @test
pub fn iterator_chain_filters_and_collects() {
  let nums = numbers();
  const evens: List[i32] = nums
    .iter()
    .map(|x: *const i32| -> i32 { return *x * 2; })
    .filter(|x: i32| -> bool { return x > 4; })
    .collect();

  assert_eq(evens.len(), @as(usize, 2));
  assert_eq(nums.iter().count(), @as(usize, 4));
  assert_eq(nums.iter().fold(0, |acc: i32, x: *const i32| -> i32 { return acc + *x; }), 10);
  assert(nums.iter().any(|x: *const i32| -> bool { return *x > 3; }));
  assert(nums.iter().all(|x: *const i32| -> bool { return *x > 0; }));
  assert(!nums.iter().any(|x: *const i32| -> bool { return *x > 9; }));
  assert(!nums.iter().all(|x: *const i32| -> bool { return *x > 9; }));
}

/// @test
pub fn iterator_take_skip_nth_last() {
  let nums = numbers();

  assert_eq(nums.iter().take(2).count(), @as(usize, 2));
  assert_eq(nums.iter().skip(2).count(), @as(usize, 2));
  assert_eq(*nums.iter().last_item().unwrap(), 4);
  assert_eq(*nums.iter().nth(2).unwrap(), 3);
}

/// @test
pub fn iterator_collects_strings_and_chars() {
  let words: List[String] = List.new();

  words.push(String.from("a"));
  words.push(String.from("b"));
  assert_eq(words.into_iter().count(), @as(usize, 2));

  let chars: List[char] = List.new();

  chars.push('a');
  chars.push('b');
  chars.push('c');

  const text: String = chars.into_iter().collect();

  assert_eq(text, String.from("abc"));

  let letters: List[String] = List.new();

  letters.push(String.from("a"));
  letters.push(String.from("b"));

  assert_eq(letters.into_iter().last_item().unwrap(), String.from("b"));
}
