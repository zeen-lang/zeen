use std.path;
use std.string;
use std.testing;

/// @test
pub fn path_splits_posix_paths() {
  @os[windows] {
    return;
  }

  assert(Path.is_absolute("/a"));
  assert(!Path.is_absolute("a"));
  assert(!Path.is_absolute(""));

  const file: []const char = "/a/b.txt";
  const bare: []const char = "b.txt";
  const trailing: []const char = "/a/";

  assert_eq(String.from(Path.basename(&file)), String.from("b.txt"));
  assert_eq(String.from(Path.basename(&bare)), String.from("b.txt"));
  assert_eq(String.from(Path.basename(&trailing)), String.from("a"));
  assert_eq(String.from(Path.dirname(&file)), String.from("/a"));
  assert_eq(String.from(Path.dirname(&bare)), String.from(""));
}

/// @test
pub fn path_joins_and_normalizes() {
  @os[windows] {
    return;
  }

  assert_eq(Path.join("a", "b"), String.from("a/b"));
  assert_eq(Path.join("a/", "/b"), String.from("a/b"));
  assert_eq(Path.normalize("/a//./b/../c"), String.from("/a/c"));
}

/// @test
pub fn path_reads_extension() {
  @os[windows] {
    return;
  }

  const file: []const char = "/a/b.txt";
  const bare: []const char = "b.txt";
  const extension = Path.extension(&file);
  const bare_extension = Path.extension(&bare);

  assert(extension.is_some());
  assert_eq(String.from(extension.unwrap()), String.from("txt"));
  assert(bare_extension.is_some());
  assert_eq(String.from(bare_extension.unwrap()), String.from("txt"));
}
