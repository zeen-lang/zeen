use std.fs;
use std.io;
use std.string;
use std.testing;

fn base() []const char {
  return "/tmp/zeen_test_fs_basic";
}

fn file() []const char {
  return "/tmp/zeen_test_fs_basic/hello.txt";
}

fn moved() []const char {
  return "/tmp/zeen_test_fs_basic/moved.txt";
}

fn clean() {
  let _ = Fs.remove_file(moved());
  let _ = Fs.remove_file(file());
  let _ = Fs.remove_dir(base());
}

/// @test
pub fn fs_writes_and_reads() {
  @os[windows] {
    return;
  }

  clean();
  Fs.create_dir(base()).unwrap();

  assert(Fs.exists(base()));
  assert_eq(Fs.write(file(), "hello fs\nsecond\n").unwrap(), @as(usize, 16));

  const meta = Fs.metadata(file()).unwrap();

  assert_eq(meta.len(), @as(u64, 16));
  assert(!meta.is_empty());
  assert(meta.is_file());
  assert(!meta.is_dir());

  assert_eq(Fs.read_to_string(file()).unwrap().len(), @as(usize, 16));

  let part = String.new();
  let reader = File.open(file()).unwrap();

  assert_eq(reader.read_exact(&part, 5).unwrap(), @as(usize, 5));
  assert_eq(part.len(), @as(usize, 5));
  assert_eq(part, String.from("hello"));

  Fs.remove_file(file()).unwrap();
  Fs.remove_dir(base()).unwrap();
  assert(!Fs.exists(file()));
}

/// @test
pub fn fs_lists_directory_entries() {
  @os[windows] {
    return;
  }

  clean();
  Fs.create_dir(base()).unwrap();
  Fs.write(file(), "hello fs\nsecond\n").unwrap();

  const listed = Fs.read_dir(base()).unwrap();

  assert_eq(listed.len(), @as(usize, 1));

  let rest = listed;
  let files: i32 = 0;
  let seen_hello = false;

  while (true) {
    const next = rest.pop();

    if (next.is_none()) {
      break;
    };

    const entry = next.unwrap();

    if (entry.is_file()) {
      files += 1;
    };

    if (entry.into_name() == String.from("hello.txt")) {
      seen_hello = true;
    };
  };

  assert_eq(files, 1);
  assert(seen_hello);

  clean();
}

/// @test
pub fn fs_open_options_and_rename() {
  @os[windows] {
    return;
  }

  clean();
  Fs.create_dir(base()).unwrap();
  Fs.write(file(), "hello fs\nsecond\n").unwrap();

  let writer = OpenOptions.new().write(true).create(true).truncate(true).open(moved()).unwrap();

  assert_eq(writer.write_all("moved\n").unwrap(), @as(usize, 6));
  writer.sync_all().unwrap();

  Fs.rename(moved(), file()).unwrap();
  Fs.remove_file(file()).unwrap();
  Fs.remove_dir(base()).unwrap();

  assert(!Fs.exists(file()));
}

/// @test
pub fn fs_reports_missing_file() {
  @os[windows] {
    return;
  }

  const missing = File.open("/tmp/zeen_test_fs_nope/x");

  assert(missing.is_err());
  assert_eq(missing.unwrap_err().kind(), IoErrorKind.NotFound);
}

/// @test
pub fn fs_seeks_and_truncates() {
  @os[windows] {
    return;
  }

  clean();
  Fs.create_dir(base()).unwrap();
  Fs.write(file(), "hello fs\nsecond\n").unwrap();

  let handle = OpenOptions.new().read(true).write(true).open(file()).unwrap();

  assert_eq(handle.seek(SeekFrom.Start(6)).unwrap(), @as(u64, 6));

  let part = String.new();
  assert_eq(handle.read_exact(&part, 2).unwrap(), @as(usize, 2));
  assert_eq(part, String.from("fs"));

  assert_eq(handle.seek(SeekFrom.End(-1)).unwrap(), @as(u64, 15));
  assert_eq(handle.seek(SeekFrom.Current(-2)).unwrap(), @as(u64, 13));

  handle.set_len(5).unwrap();
  handle.sync_all().unwrap();
  assert_eq(Fs.metadata(file()).unwrap().len(), @as(u64, 5));

  clean();
}

/// @test
pub fn fs_reads_lines() {
  @os[windows] {
    return;
  }

  clean();
  Fs.create_dir(base()).unwrap();
  Fs.write(file(), "hello fs\nsecond\n").unwrap();

  let handle = File.open(file()).unwrap();
  let line = String.new();

  assert_eq(handle.read_line(&line).unwrap(), @as(usize, 9));
  assert_eq(line, String.from("hello fs\n"));

  let rest = String.new();
  assert_eq(handle.read_line(&rest).unwrap(), @as(usize, 7));
  assert_eq(rest, String.from("second\n"));

  let end = String.new();
  assert_eq(handle.read_line(&end).unwrap(), @as(usize, 0));

  clean();
}

/// @test
pub fn fs_reports_types_and_times() {
  @os[windows] {
    return;
  }

  clean();
  Fs.create_dir(base()).unwrap();
  Fs.write(file(), "hello").unwrap();

  const meta = Fs.metadata(file()).unwrap();

  assert(switch (meta.file_type()) {
    .File => true,
    _ => false,
  });
  assert(meta.modified() > 0);

  let handle = File.open(file()).unwrap();
  let clone = handle.try_clone().unwrap();
  let buf = String.new();

  assert_eq(clone.read_exact(&buf, 5).unwrap(), @as(usize, 5));
  assert_eq(buf, String.from("hello"));

  clean();
}

/// @test
pub fn fs_creates_and_removes_trees() {
  @os[windows] {
    return;
  }

  clean();
  Fs.create_dir_all("/tmp/zeen_test_fs_basic/a/b").unwrap();
  Fs.write(file(), "hello").unwrap();
  Fs.write("/tmp/zeen_test_fs_basic/a/b/nested.txt", "nested").unwrap();

  assert(Fs.exists("/tmp/zeen_test_fs_basic/a/b/nested.txt"));

  const listed = Fs.walk(base()).unwrap();

  assert_eq(listed.len(), @as(usize, 4));

  Fs.remove_dir_all(base()).unwrap();
  assert(!Fs.exists(base()));
}

/// @test
pub fn fs_copies_and_hard_links() {
  @os[windows] {
    return;
  }

  clean();
  Fs.create_dir(base()).unwrap();
  Fs.write(file(), "hello").unwrap();

  assert_eq(Fs.copy(file(), moved()).unwrap(), @as(u64, 5));
  assert_eq(Fs.read_to_string(moved()).unwrap(), String.from("hello"));

  Fs.hard_link(moved(), "/tmp/zeen_test_fs_basic/hard.txt").unwrap();
  assert_eq(Fs.read_to_string("/tmp/zeen_test_fs_basic/hard.txt").unwrap(), String.from("hello"));

  Fs.remove_file("/tmp/zeen_test_fs_basic/hard.txt").unwrap();
  Fs.remove_file(moved()).unwrap();
  Fs.remove_file(file()).unwrap();
  Fs.remove_dir(base()).unwrap();
}

/// @test
pub fn fs_links_and_canonicalizes() {
  @os[windows] {
    return;
  }

  clean();
  Fs.create_dir(base()).unwrap();
  Fs.write(file(), "hello").unwrap();
  Fs.symlink(file(), "/tmp/zeen_test_fs_basic/link.txt").unwrap();

  assert_eq(Fs.read_link("/tmp/zeen_test_fs_basic/link.txt").unwrap(), String.from(file()));

  const resolved = Fs.canonicalize(base()).unwrap();

  assert(resolved.slice(..).ends_with("zeen_test_fs_basic"));

  Fs.remove_file("/tmp/zeen_test_fs_basic/link.txt").unwrap();
  clean();
}

/// @test
pub fn fs_sets_permissions() {
  @os[windows] {
    return;
  }

  clean();
  Fs.create_dir(base()).unwrap();
  Fs.write(file(), "hello").unwrap();

  Fs.set_permissions(file(), Permissions.from_readonly(true)).unwrap();
  assert_eq(Fs.metadata(file()).unwrap().mode() & 0o222, @as(u32, 0));

  Fs.set_permissions(file(), Permissions.new()).unwrap();
  assert((Fs.metadata(file()).unwrap().mode() & 0o200) != 0);

  clean();
}
