use std.cell;
use std.sync;
use std.thread;
use std.testing;
use std.time;

/// @test
pub fn rwlock_allows_writer_then_readers() {
  @os[windows] {
    return;
  }

  let shared = Arc.new(RwLock.new(0));
  let writer_shared = shared.clone();

  let writer = Thread.spawn(|| -> i32 {
    let i: i32 = 0;

    while (i < 50) {
      let guard = writer_shared.get_mut().write();

      *guard += 1;
      i += 1;
    };

    return 1;
  });

  assert_eq(writer.join(), 1);

  let reader_shared = shared.clone();

  let reader = Thread.spawn(|| -> i32 {
    const guard = reader_shared.get_mut().read();

    return *guard;
  });

  assert_eq(reader.join(), 50);

  {
    const guard = shared.get_mut().read();

    assert_eq(*guard, 50);
  };

  {
    const read = shared.get_mut().try_read();

    assert(read.is_some());
  };

  {
    const write = shared.get_mut().try_write();

    assert(write.is_some());
  };

  assert(shared.get_mut().try_write().is_some());
  assert(shared.get_mut().try_write().is_some());
  assert_eq(RwLock.new(7).into_inner(), 7);
}

/// @test
pub fn once_runs_a_single_time() {
  let counter = Arc.new(Cell.new(0));
  let shared = counter.clone();
  let once = Once.new();

  assert(!once.is_done());

  once.call_once(|| -> void {
    let cell = shared.get_mut();

    cell.set(cell.get() + 1);
  });

  let shared_again = counter.clone();

  once.call_once(|| -> void {
    let cell = shared_again.get_mut();

    cell.set(cell.get() + 10);
  });

  assert(once.is_done());
  assert_eq(counter.get_mut().get(), 1);
}

/// @test
pub fn condvar_wakes_a_waiter() {
  @os[windows] {
    return;
  }

  let state = Arc.new(Mutex.new(false));
  let signal = Arc.new(Condvar.new());
  let worker_state = state.clone();
  let worker_signal = signal.clone();

  let worker = Thread.spawn(|| -> i32 {
    Time.sleep(Duration.from_millis(50));

    {
      const guard = worker_state.get_mut().lock();

      *guard = true;
    };

    worker_signal.get_mut().notify_one();

    return 1;
  });

  {
    let guard = state.get_mut().lock();

    while (!*guard) {
      signal.get_mut().wait(&guard);
    };
  };

  assert_eq(worker.join(), 1);
  assert(*state.get_mut().lock());
}

/// @test
pub fn channel_bounds_and_closes() {
  let channel: Channel[i32] = Channel.new(2);

  assert(channel.try_send(1));
  assert(channel.try_send(2));
  assert(!channel.try_send(3));
  assert_eq(channel.len(), 2);
  assert_eq(channel.try_recv().unwrap(), 1);
  assert(channel.try_send(3));
  assert_eq(channel.try_recv().unwrap(), 2);
  assert_eq(channel.try_recv().unwrap(), 3);
  assert(channel.try_recv().is_none());

  channel.close();
  assert(channel.is_closed());
  assert(!channel.try_send(4));
  assert(channel.recv().is_none());
}

/// @test
pub fn channel_passes_values_between_threads() {
  @os[windows] {
    return;
  }

  const inner: Channel[i32] = Channel.new(2);
  let channel: Arc[Channel[i32]] = Arc.new(inner);
  let producer_channel = channel.clone();
  let consumer_channel = channel.clone();

  let producer = Thread.spawn(|| -> i32 {
    let i: i32 = 0;

    while (i < 5) {
      producer_channel.get_mut().send(i);
      i += 1;
    };

    producer_channel.get_mut().close();

    return 1;
  });

  let consumer = Thread.spawn(|| -> i32 {
    let total: i32 = 0;

    while (true) {
      switch (consumer_channel.get_mut().recv()) {
        .Some(value) => { total += value; },
        .None => { break; },
      }
    };

    return total;
  });

  assert_eq(producer.join(), 1);
  assert_eq(consumer.join(), 10);
}
