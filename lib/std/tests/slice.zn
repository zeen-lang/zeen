use std.testing;

fn by_desc(a: *const i32, b: *const i32) Ordering {
  return (*b).cmp(a);
}

/// @test
pub fn slice_sorts_and_searches() {
  let items: [7]i32 = {5, 1, 4, 2, 8, 3, 9};

  items[..].sort();
  assert_eq(items[0], 1);
  assert_eq(items[3], 4);
  assert_eq(items[6], 9);
  assert(items[..].binary_search(&items[2]).unwrap() == 2);
  assert(items[..].binary_search(&@as(i32, 42)).is_none());
}

/// @test
pub fn slice_sort_by_and_reverse() {
  let items: [6]i32 = {5, 1, 4, 2, 8, 3};

  items[..].sort_by(by_desc);
  assert_eq(items[0], 8);
  assert_eq(items[5], 1);

  items[..].reverse();
  assert_eq(items[0], 1);
  assert_eq(items[5], 8);

  items[..].swap(0, 1);
  assert_eq(items[0], 2);
  assert_eq(items[1], 1);
}

/// @test
pub fn slice_windows_and_chunks() {
  let items: [5]u8 = {1, 2, 3, 4, 5};
  let windows = items[..].windows(3);

  switch (windows.next()) {
    .Some(view) => {
      assert_eq(view.len, 3);
      assert_eq(view[0], 1);
      assert_eq(view[2], 3);
    },
    .None => { assert(false); },
  };

  assert_eq(items[..].windows(3).count(), 3);
  assert_eq(items[..].chunks(2).count(), 3);
  assert_eq(items[..].windows(0).count(), 0);
}

/// @test
pub fn slice_chunks_keep_the_tail() {
  let items: [5]u8 = {1, 2, 3, 4, 5};
  let chunks = items[..].chunks(2);

  chunks.next();
  chunks.next();

  switch (chunks.next()) {
    .Some(tail) => {
      assert_eq(tail.len, 1);
      assert_eq(tail[0], 5);
    },
    .None => { assert(false); },
  };

  assert(chunks.next().is_none());
}

/// @test
pub fn slice_split_and_copy() {
  let items: [5]i32 = {1, 2, 3, 4, 5};
  const parts = items[..].split_at(2);

  assert_eq(parts.left.len, 2);
  assert_eq(parts.right.len, 3);
  assert_eq(parts.right[0], 3);

  let filled: [3]i32 = {0; 3};
  const source: [3]i32 = {9, 8, 7};

  filled[..].fill(7);
  assert_eq(filled[2], 7);

  filled[..].copy_from_slice(source[..]);
  assert_eq(filled[0], 9);
  assert_eq(filled[2], 7);
  assert(items[0..0].is_empty());
  assert(items[0..0].first().is_none());
}

/// @test
pub fn slice_search_helpers() {
  let items: [4]i32 = {1, 2, 3, 4};

  assert_eq(items[..].position(3).unwrap(), 2);
  assert(items[..].contains(4));
  assert(!items[..].contains(9));
  assert_eq(*(items[..].first().unwrap()), 1);
  assert_eq(*(items[..].last().unwrap()), 4);

  const prefix: [2]i32 = {1, 2};
  const suffix: [2]i32 = {3, 4};
  const same: [4]i32 = {1, 2, 3, 4};

  assert(items[..].eql(same[..]));
  assert(!items[..].eql(prefix[..]));

  assert(items[..].starts_with(prefix[..]));
  assert(items[..].ends_with(suffix[..]));
  assert(!items[..].starts_with(suffix[..]));
}
