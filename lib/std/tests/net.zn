use std.net;
use std.io;
use std.string;
use std.testing;
use std.time;

/// @test
pub fn socket_addr_parses_ipv4() {
  const parsed = SocketAddr.from_str("127.0.0.1:8080").unwrap();

  assert_eq(parsed.ip(), @as(u32, 2130706433));
  assert_eq(parsed.port(), @as(u16, 8080));
  assert_eq(SocketAddr.loopback(80).port(), @as(u16, 80));
  assert(SocketAddr.from_str("nope").is_err());
}

/// @test
pub fn tcp_round_trip() {
  @os[windows] {
    return;
  }

  let listener = TcpListener.bind(&SocketAddr.loopback(0)).unwrap();
  const addr = listener.local_addr().unwrap();

  assert(addr.port() != 0);

  let client = TcpStream.connect(&addr).unwrap();
  let server = listener.accept().unwrap();

  assert(client.peer_addr().unwrap().port() != 0);

  assert_eq(client.write_all("ping").unwrap(), @as(usize, 4));

  let incoming = String.new();

  assert_eq(server.read_exact(&incoming, 4).unwrap(), @as(usize, 4));
  assert_eq(incoming, String.from("ping"));

  assert_eq(server.write_all("pong").unwrap(), @as(usize, 4));

  let back = String.new();

  assert_eq(client.read_exact(&back, 4).unwrap(), @as(usize, 4));
  assert_eq(back, String.from("pong"));

  client.shutdown().unwrap();
}

/// @test
pub fn udp_round_trip() {
  @os[windows] {
    return;
  }

  let sender = UdpSocket.bind(&SocketAddr.loopback(0)).unwrap();
  let receiver = UdpSocket.bind(&SocketAddr.loopback(0)).unwrap();
  const receiver_addr = receiver.local_addr().unwrap();

  assert_eq(sender.send_to("udp-hi", &receiver_addr).unwrap(), @as(usize, 6));

  let buffer = String.new();
  const from = receiver.recv_from(&buffer).unwrap();

  assert_eq(from.port(), sender.local_addr().unwrap().port());
  assert_eq(buffer, String.from("udp-hi"));
}

/// @test
pub fn tcp_read_times_out() {
  @os[windows] {
    return;
  }

  let listener = TcpListener.bind(&SocketAddr.loopback(0)).unwrap();
  const addr = listener.local_addr().unwrap();
  let client = TcpStream.connect(&addr).unwrap();
  let server = listener.accept().unwrap();

  client.set_read_timeout(Duration.from_millis(50)).unwrap();
  client.set_write_timeout(Duration.from_millis(50)).unwrap();
  server.set_read_timeout(Duration.from_millis(50)).unwrap();

  let buffer: [16]char = {'\0'; 16};

  assert(client.read(buffer[..]).is_err());
  assert(server.read(buffer[..]).is_err());
}

/// @test
pub fn udp_read_times_out() {
  @os[windows] {
    return;
  }

  let socket = UdpSocket.bind(&SocketAddr.loopback(0)).unwrap();

  socket.set_read_timeout(Duration.from_millis(50)).unwrap();

  let buffer = String.new();

  assert(socket.recv_from(&buffer).is_err());
}
