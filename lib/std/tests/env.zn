use std.env;
use std.testing;

/// @test
pub fn env_round_trips_a_variable() {
  @os[windows] {
    return;
  }

  const before = Env.vars().len();

  Env.set_var("ZEEN_TEST_ENV", "yes").unwrap();
  const value = Env.var("ZEEN_TEST_ENV");

  assert(value.is_some());
  assert_eq(value.unwrap().len(), 3);
  assert_eq(Env.vars().len(), before + 1);

  Env.unset_var("ZEEN_TEST_ENV").unwrap();
  assert(Env.var("ZEEN_TEST_ENV").is_none());
}

/// @test
pub fn env_exposes_directories() {
  @os[windows] {
    return;
  }

  assert(Env.temp_dir().len() > 0);
  assert(Env.current_dir().is_ok());
  assert(Env.current_exe().is_ok());

  Env.set_current_dir("/tmp").unwrap();
}
