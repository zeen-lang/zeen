      .body = String.from(body),
    }
  }

  /// Writes the response into the stream.
  pub fn send(*self, stream: *TcpStream) Result[void, IoError] {
    let head = @format(
      "HTTP/1.1 {} {}\r\nContent-Type: text/plain\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",
      self.status,
      status_text(self.status),
      self.body.len(),
    );

    (*stream).write_all(head.slice(..))?;
    (*stream).write_all(self.body.slice(..))?;

    return Result.Ok(.{});
  }
}

fn status_text(status: u16) []const char {
  switch (status) {
    100 => "Continue",
    101 => "Switching Protocols",
    102 => "Processing",
    103 => "Early Hints",
    200 => "OK",
    201 => "Created",
    202 => "Accepted",
    203 => "Non-Authoritative Information",
    204 => "No Content",
    205 => "Reset Content",
    206 => "Partial Content",
    207 => "Multi-Status",
    208 => "Already Reported",
    226 => "IM Used",
    300 => "Multiple Choices",
    301 => "Moved Permanently",
    302 => "Found",
    303 => "See Other",
    304 => "Not Modified",
    305 => "Use Proxy",
    307 => "Temporary Redirect",
    308 => "Permanent Redirect",
    400 => "Bad Request",
    401 => "Unauthorized",
    402 => "Payment Required",
    403 => "Forbidden",
    404 => "Not Found",
    405 => "Method Not Allowed",
    406 => "Not Acceptable",
    407 => "Proxy Authentication Required",
    408 => "Request Timeout",
    409 => "Conflict",
    410 => "Gone",
    411 => "Length Required",
    412 => "Precondition Failed",
    413 => "Payload Too Large",
    414 => "URI Too Long",
    415 => "Unsupported Media Type",
    416 => "Range Not Satisfiable",
    417 => "Expectation Failed",
    418 => "I Am A Teapot",
    421 => "Misdirected Request",
    422 => "Unprocessable Content",
    423 => "Locked",
    424 => "Failed Dependency",
    425 => "Too Early",
    426 => "Upgrade Required",
    428 => "Precondition Required",
    429 => "Too Many Requests",
    431 => "Request Header Fields Too Large",
    451 => "Unavailable For Legal Reasons",
    500 => "Internal Server Error",
    501 => "Not Implemented",
    502 => "Bad Gateway",
    503 => "Service Unavailable",
    504 => "Gateway Timeout",
    505 => "HTTP Version Not Supported",
    506 => "Variant Also Negotiates",
    507 => "Insufficient Storage",
    508 => "Loop Detected",
    510 => "Not Extended",
    511 => "Network Authentication Required",
    _ => "Unknown",
  }
}

/// Plain HTTP/1.1 client. Only `http://` URLs are supported.
pub struct Client {}

/// Parsed client response.
pub struct ClientResponse {
  status: u16,
  headers: Headers,
  _body: String,
}

implement ClientResponse {
  pub fn status_code(*const self) u16 {
    return self.status;
  }

  pub fn header(*const self, name: []const char) Option[String] {
    return self.headers.get(name);
  }

  pub fn body(*const self) []const char {
    return self._body.slice(..);
  }
}

implement Client {
  pub fn new() Self {
    return Self {};
  }

  pub fn get(*const self, url: []const char) Result[ClientResponse, IoError] {
    const headers = Headers.new();
    return self.request(Method.Get, url, &headers, "");
  }

  pub fn post(*const self, url: []const char, body: []const char) Result[ClientResponse, IoError] {
    const headers = Headers.new();
    return self.request(Method.Post, url, &headers, body);
  }

  pub fn request(
    *const self,
    method: Method,
    url: []const char,
    headers: *const Headers,
    body: []const char,
  ) Result[ClientResponse, IoError] {
    const parsed = Url.parse(url);

    if (parsed.is_none()) {
      return Result.Err(IoError.new(IoErrorKind.InvalidInput, "bad url"));
    };

    const target = parsed.unwrap();

    if (!is_http_scheme(target.scheme())) {
      return Result.Err(IoError.new(IoErrorKind.Unsupported, "only http is supported"));
    };

    const port = if (target.port().is_some()) { target.port().unwrap() } else { @as(u16, 80) };
    const addr = SocketAddr.resolve(target.host(), port)?;
    let stream = TcpStream.connect(&addr)?;

    const request = build_request(method, &target, headers, body);
    stream.write_all(request.slice(..))?;

    const raw = String.new();
    stream.read_to_string(&raw)?;

    return parse_response(method, &raw);
  }
}

fn is_http_scheme(scheme: []const char) bool {
  if (scheme.len != 4) {
    return false;
  };

  return lower_byte(scheme.ptr[0]) == 'h'
    && lower_byte(scheme.ptr[1]) == 't'
    && lower_byte(scheme.ptr[2]) == 't'
    && lower_byte(scheme.ptr[3]) == 'p';
}

fn method_name(method: Method) []const char {
  return switch (method) {
    .Get => "GET",
    .Post => "POST",
    .Put => "PUT",
    .Delete => "DELETE",
    .Patch => "PATCH",
    .Head => "HEAD",
    .Options => "OPTIONS",
    .Unknown => "GET",
  };
}

fn build_request(method: Method, url: *const Url, headers: *const Headers, body: []const char) String {
  let out = String.new();
  out.push_str(method_name(method));
  out.push(' ');
  out.push_str(url.path());

  switch (url.query()) {
    .Some(query) => {
      out.push('?');
      out.push_str(query);
    },
    .None => {},
  };

  out.push_str(" HTTP/1.1\r\n");

  if (headers.get("host").is_none()) {
    out.push_str("Host: ");
    out.push_str(url.host());

    if (url.port().is_some() && url.port().unwrap() != 80) {
      out.push(':');
      Fmt.write_uint(&out, @as(u64, url.port().unwrap()));
    };

    out.push_str("\r\n");
  };

  let i: usize = 0;

  while (i < headers.len()) {
    const header = headers.at(i).unwrap();
    out.push_str((*header).name.slice(..));
    out.push_str(": ");
    out.push_str((*header).value.slice(..));
    out.push_str("\r\n");
    i += 1;
  };

  out.push_str("Connection: close\r\n");

  if (body.len > 0 || method == Method.Post || method == Method.Put || method == Method.Patch) {
    out.push_str("Content-Length: ");
    Fmt.write_uint(&out, @as(u64, body.len));
    out.push_str("\r\n");
  };

  out.push_str("\r\n");
  out.push_str(body);

  return out;
}

fn parse_response(method: Method, raw: *const String) Result[ClientResponse, IoError] {
  const split = (*raw).find_str("\r\n\r\n");

  if (split.is_none()) {
    return Result.Err(IoError.new(IoErrorKind.InvalidData, "bad response"));
  };

  const at = split.unwrap();
  const body_start = at + 4;
  const head = String.from((*raw).slice(..)[0..at]);
  const body_raw = (*raw).slice(..)[body_start..(*raw).len()];

  const lines = head.split('\n');

  if (lines.is_empty()) {
    return Result.Err(IoError.new(IoErrorKind.InvalidData, "empty response"));
  };

  const status_line = String.from(lines.get_ptr(0).unwrap().trim_end());
  const parts = status_line.split(' ');

  if (parts.len() < 2) {
    return Result.Err(IoError.new(IoErrorKind.InvalidData, "bad status line"));
  };

  const status = parse_status(parts.get_ptr(1).unwrap())?;
  let headers = Headers.new();
  let i: usize = 1;

  while (i < lines.len()) {
    const line = lines.get_ptr(i).unwrap();
    const text = (*line).trim_end();

    if (text.len == 0) {
      break;
    };

    switch (find_colon(text)) {
      .Some(colon) => {
        const value_start = colon + 1;
        headers.push(
          String.from(trim_view(text.ptr, colon)),
          String.from(trim_view(text.ptr + value_start, text.len - value_start)),
        );
      },
      .None => {
        return Result.Err(IoError.new(IoErrorKind.InvalidData, "bad header line"));
      },
    };

    i += 1;
  };

  if (method == Method.Head || status == 204 || status == 304) {
    return Result.Ok(ClientResponse { .status = status, .headers = headers, ._body = String.new() });
  };

  let chunked = false;
  const encoding = headers.get("transfer-encoding");

  if (encoding.is_some()) {
    const encoding_text = encoding.unwrap();

    if (contains_ci(encoding_text.slice(..), "chunked")) {
      chunked = true;
    };
  };

  if (chunked) {
    const body = decode_chunked(body_raw)?;
    return Result.Ok(ClientResponse { .status = status, .headers = headers, ._body = body });
  };

  const length = headers.get("content-length");

  if (length.is_some()) {
    const length_text = length.unwrap();
    const parsed = Fmt.parse_u64(length_text.slice(..));

    if (parsed.is_none()) {
      return Result.Err(IoError.new(IoErrorKind.InvalidData, "bad content length"));
    };

    const want = parsed.unwrap();

    if (want > @as(u64, body_raw.len)) {
      return Result.Err(IoError.new(IoErrorKind.UnexpectedEof, "short response body"));
    };

    const body = String.from(body_raw[0..@as(usize, want)]);
    return Result.Ok(ClientResponse { .status = status, .headers = headers, ._body = body });
  };

  return Result.Ok(ClientResponse { .status = status, .headers = headers, ._body = String.from(body_raw) });
}

fn parse_status(text: *String) Result[u16, IoError] {
  if ((*text).len() != 3) {
    return Result.Err(IoError.new(IoErrorKind.InvalidData, "bad status code"));
  };

  let value: u32 = 0;
  let i: usize = 0;

  while (i < 3) {
    const c = @as(u32, (*text).get(i).unwrap());

    if (c < @as(u32, '0') || c > @as(u32, '9')) {
      return Result.Err(IoError.new(IoErrorKind.InvalidData, "bad status code"));
    };

    value = value * 10 + (c - @as(u32, '0'));
    i += 1;
  };

  return Result.Ok(@as(u16, value));
}

fn decode_chunked(raw: []const char) Result[String, IoError] {
  let out = String.new();
  let pos: usize = 0;

  while (true) {
    const line_end = find_crlf(raw, pos);

    if (line_end.is_none()) {
      return Result.Err(IoError.new(IoErrorKind.InvalidData, "bad chunk"));
    };

    const line = raw[pos..line_end.unwrap()];
    const size = parse_chunk_size(line, raw.len)?;
    pos = line_end.unwrap() + 2;

    if (size == 0) {
      break;
    };

    if (pos + size + 2 > raw.len) {
      return Result.Err(IoError.new(IoErrorKind.UnexpectedEof, "short chunk"));
    };

    out.push_str(raw[pos..pos + size]);
    pos += size;

    if (raw.ptr[pos] != '\r' || raw.ptr[pos + 1] != '\n') {
      return Result.Err(IoError.new(IoErrorKind.InvalidData, "bad chunk terminator"));
    };

    pos += 2;
  };

  return Result.Ok(out);
}

fn parse_chunk_size(line: []const char, limit: usize) Result[usize, IoError] {
  let value: u64 = 0;
  let digits: usize = 0;
  let i: usize = 0;

  while (i < line.len) {
    const c = line.ptr[i];

    if (c == ';' || c == ' ' || c == '\t') {
      break;
    };

    const digit = hex_value(c);

    if (digit.is_none()) {
      return Result.Err(IoError.new(IoErrorKind.InvalidData, "bad chunk size"));
    };

    if (value > @as(u64, limit) / 16) {
      return Result.Err(IoError.new(IoErrorKind.InvalidData, "chunk too large"));
    };

    value = value * 16 + @as(u64, digit.unwrap());

    if (value > @as(u64, limit)) {
      return Result.Err(IoError.new(IoErrorKind.InvalidData, "chunk too large"));
    };

    digits += 1;
    i += 1;
  };

  if (digits == 0) {
    return Result.Err(IoError.new(IoErrorKind.InvalidData, "bad chunk size"));
  };

  return Result.Ok(@as(usize, value));
}

fn hex_value(c: char) Option[u32] {
  const value = @as(u32, c);

  if (value >= @as(u32, '0') && value <= @as(u32, '9')) {
    return Option.Some(value - @as(u32, '0'));
  };

  if (value >= @as(u32, 'a') && value <= @as(u32, 'f')) {
    return Option.Some(value - @as(u32, 'a') + 10);
  };

  if (value >= @as(u32, 'A') && value <= @as(u32, 'F')) {
    return Option.Some(value - @as(u32, 'A') + 10);
  };

  return Option.None;
}

fn find_crlf(text: []const char, from: usize) Option[usize] {
  let i = from;

  while (i + 1 < text.len) {
    if (text.ptr[i] == '\r' && text.ptr[i + 1] == '\n') {
      return Option.Some(i);
    };

    i += 1;
  };

  return Option.None;
}

fn contains_ci(text: []const char, needle: []const char) bool {
  if (needle.len == 0 || text.len < needle.len) {
    return false;
  };

  let i: usize = 0;

  while (i + needle.len <= text.len) {
    let same = true;
    let k: usize = 0;

    while (k < needle.len) {
      if (lower_byte(text.ptr[i + k]) != lower_byte(needle.ptr[k])) {
        same = false;
        break;
      };

      k += 1;
    };

    if (same) {
      return true;
    };

    i += 1;
  };

  return false;
}

/// Blocking single threaded HTTP server.
pub struct HttpServer {
  listener: TcpListener,
}

implement HttpServer {
  /// Listener for the address.
  pub fn bind(addr: *const SocketAddr) Result[Self, IoError] {
    switch (TcpListener.bind(addr)) {
      .Ok(listener) => Result.Ok(Self { .listener = listener }),
      .Err(e) => {
        return Result.Err(e);
      },
    };
  }

  /// Next incoming connection, waits until one arrives.
  pub fn accept(*const self) Result[TcpStream, IoError] {
    self.listener.accept()
  }

  /// Read one request head and an optional body.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.ConnectionReset
  /// * IoErrorKind.Interrupted
  /// * IoErrorKind.InvalidData
  /// * IoErrorKind.UnexpectedEof
  /// * IoErrorKind.Uncategorized
  pub fn read_request(stream: *TcpStream) Result[Request, IoError] {
    let head = String.new();

    while (true) {
      let chunk: [256]char = @uninit();

      switch ((*stream).read(chunk[..])) {
        .Ok(got) => if (got == 0) {
          break;
        } else {
          head.push_str(chunk[0..got]);
        },
        .Err(e) => {
          return Result.Err(e);
        },
      };

      if (head.contains_str("\r\n\r\n")) {
        break;
      };

      if (head.len() > 8192) {
        return Result.Err(IoError.new(IoErrorKind.InvalidData, "header too large"));
      };
    };

    return parse_request(&head, stream);
  }
}

fn parse_request(head: *String, stream: *TcpStream) Result[Request, IoError] {
  const lines = (*head).split('\n');

  if (lines.is_empty()) {
    return Result.Err(IoError.new(IoErrorKind.InvalidData, "empty request"));
  };

  const request_line = String.from(lines.get_ptr(0).unwrap().trim_end());
  const parts = request_line.split(' ');

  switch (parts.get_ptr(0)) {
    .Some(_) => {},
    .None => {
      return Result.Err(IoError.new(IoErrorKind.InvalidData, "bad request line"));
    },
  };

  switch (parts.get_ptr(1)) {
    .Some(_) => {},
    .None => {
      return Result.Err(IoError.new(IoErrorKind.InvalidData, "bad request line"));
    },
  };

  const method = parse_method(parts.get_ptr(0).unwrap());
  const path = parts.get_ptr(1).unwrap().clone();

  const headers = Headers { .inner = List#[Header].new() };
  let mut_headers = headers;
  let i: usize = 1;

  while (i < lines.len()) {
    switch (lines.get_ptr(i)) {
      .Some(line) => {
        const text = (*line).trim_end();

        if (text.len == 0) {
          break;
        };

        switch (find_colon(text)) {
          .Some(at) => {
            const vs = at + 1;
            mut_headers.push(String.from(trim_view(text.ptr, at)), String.from(trim_view(text.ptr + vs, text.len - vs)));
          },
          .None => {
            return Result.Err(IoError.new(IoErrorKind.InvalidData, "bad header line"));
          },
        };
      },
      .None => {},
    };

    i += 1;
  };

  let need: usize = 0;

  switch (mut_headers.get("content-length")) {
    .Some(raw) => {
      switch (parse_digits(&raw)) {
        .Some(n) => {
          need = n;
        },
        .None => {
          return Result.Err(IoError.new(IoErrorKind.InvalidData, "bad content length"));
        },
      };
    },
    .None => {},
  };

  let from: usize = 0;

  switch ((*head).find_str("\r\n\r\n")) {
    .Some(at) => {
      from = at + 4;
    },
    .None => {
      return Result.Err(IoError.new(IoErrorKind.InvalidData, "bad request"));
    },
  };
  const buffered = (*head).len() - from;
  let body = String.from((*head).slice(..)[from..(*head).len()]);

  if (buffered < need) {
    switch ((*stream).read_exact(&body, need - buffered)) {
      .Ok(_) => {},
      .Err(e) => {
        return Result.Err(e);
      },
    };
  };

  return Result.Ok(Request {
    .method = method,
    .path = path,
    .headers = mut_headers,
    .body = body,
  });
}

fn parse_method(token: *String) Method {
  if ((*token) == String.from("GET")) {
    return Method.Get;
  };

  if ((*token) == String.from("POST")) {
    return Method.Post;
  };

  if ((*token) == String.from("PUT")) {
    return Method.Put;
  };

  if ((*token) == String.from("DELETE")) {
    return Method.Delete;
  };

  if ((*token) == String.from("PATCH")) {
    return Method.Patch;
  };

  if ((*token) == String.from("HEAD")) {
    return Method.Head;
  };

  if ((*token) == String.from("OPTIONS")) {
    return Method.Options;
  };

  return Method.Unknown;
}

fn find_colon(s: []const char) Option[usize] {
  let i: usize = 0;

  while (i < s.len) {
    if (s.ptr[i] == ':') {
      return Option.Some(i);
    };

    i += 1;
  };

  return Option.None;
}

fn trim_view(ptr: [*]const char, len: usize) []const char {
  let start: usize = 0;

  while (start < len) {
    if (ptr[start] != ' ' && ptr[start] != '\t') {
      break;
    };

    start += 1;
  };

  let end = len;

  while (end > start) {
    if (ptr[end - 1] != ' ' && ptr[end - 1] != '\t') {
      break;
    };

    end -= 1;
  };

  ptr[start..end]
}

fn parse_digits(s: *const String) Option[usize] {
  const len = (*s).len();

  if (len == 0) {
    return Option.None;
  };

  const max: u64 = @as(u64, MaxRequestBodySize);
  const cutoff = max / @as(u64, 10);
  const cutlim = max % @as(u64, 10);

  let num: u64 = 0;
  let i: usize = 0;

  while (i < len) {
    const d = @as(u64, (*s).get(i).unwrap());

    if (d < @as(u64, '0') || d > @as(u64, '9')) {
      return Option.None;
    };

    const digit = d - @as(u64, '0');

    if (num > cutoff || (num == cutoff && digit > cutlim)) {
      return Option.None;
    };

    num = num * 10 + digit;
    i += 1;
  };

  return Option.Some(@as(usize, num));
}
