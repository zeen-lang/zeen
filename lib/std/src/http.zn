use std.string;
use std.collections.list;
use std.io;
use std.net;
use std.fmt;
use std.url;

comptime MaxRequestBodySize = 8 * 1024 * 1024;

/// HTTP request method.
pub enum Method {
  Get,
  Post,
  Put,
  Delete,
  Patch,
  Head,
  Options,
  Unknown,
}

/// One `Name: value` header line.
pub struct Header {
  pub name: String,
  pub value: String,
}

/// Header map. Lookup is case insensitive and clones the value.
pub struct Headers {
  inner: List[Header],
}

implement Headers {
  pub fn new() Self {
    return Self { .inner = List#[Header].new() };
  }

  pub fn len(*const self) usize {
    return self.inner.len();
  }

  pub fn at(*const self, index: usize) Option[*Header] {
    return self.inner.get_ptr(index);
  }

  /// Adds one header field.
  pub fn push(*self, name: String, value: String) {
    self.inner.push(Header { .name = name, .value = value });
  }

  /// Value of the first header with `name`.
  pub fn get(*const self, name: []const char) Option[String] {
    let i: usize = 0;

    while (i < self.inner.len()) {
      switch (self.inner.get_ptr(i)) {
        .Some(h) => if (header_name_eq(&(*h).name, name)) {
          return Option.Some((*h).value.clone());
        },
        .None => {},
      };

      i += 1;
    };

    return Option.None;
  }
}

fn lower_byte(c: char) char {
  const v = @as(u32, c);

  if (v >= @as(u32, 'A') && v <= @as(u32, 'Z')) {
    return @as(char, v + 32);
  };

  return c;
}

fn header_name_eq(a: *const String, b: []const char) bool {
  if ((*a).len() != b.len) {
    return false;
  };

  let i: usize = 0;

  while (i < b.len) {
    if (lower_byte((*a).get(i).unwrap()) != lower_byte(b.ptr[i])) {
      return false;
    };

    i += 1;
  };

  return true;
}

/// Parsed HTTP request.
pub struct Request {
  pub method: Method,
  pub path: String,
  pub headers: Headers,
  pub body: String,
}

implement Request {
  /// Value of the first header with `name`.
  pub fn header(*const self, name: []const char) Option[String] {
    self.headers.get(name)
  }
}

/// HTTP response builder.
pub struct Response {
  status: u16,
  body: String,
}

implement Response {
  /// Response with `status` and `body`.
  pub fn new(status: u16, body: []const char) Self {
    Self {
      .status = status,
      .body = String.from(body),
    }
  }

  /// Response with `status` and an empty body.
  pub fn empty(status: u16) Self {
    Self {
      .status = status,
      .body = String.new(),
    }
  }

  /// Status code.
  pub fn status_code(*const self) u16 {
    self.status
  }

  /// Changes the status code.
  pub fn set_status_code(*self, code: u16) {
    self.status = code;
  }

  /// `200 OK` response.
  pub fn ok(body: []const char) Self {
    Self {
      .status = 200,
      .body = String.from(body),
    }
  }

  /// `404 Not Found` response.
  pub fn not_found() Self {
    Self {
      .status = 404,
      .body = String.from("Not Found\n"),
    }
  }

