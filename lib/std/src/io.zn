use std.alloc;
use std.string;
use std.c.types;
use std.c.stdio;
use std.c.string;
use std.c.errno;
use std.c.windows.windef;
use std.c.windows.winbase;
use std.c.windows.fileapi;

/// IO error kind.
pub enum IoErrorKind {
  NotFound,
  PermissionDenied,
  AlreadyExists,
  InvalidInput,
  InvalidData,
  UnexpectedEof,
  WriteZero,
  Interrupted,
  WouldBlock,
  TimedOut,
  BrokenPipe,
  ConnectionRefused,
  ConnectionReset,
  ConnectionAborted,
  NotConnected,
  AddrInUse,
  AddrNotAvailable,
  IsADirectory,
  NotADirectory,
  Unsupported,
  OutOfMemory,
  Uncategorized,
}

/// IO error with a kind and a human readable message.
pub struct IoError {
  _kind: IoErrorKind,
  _message: String,
}

implement IoError {
  /// Error with a kind and a message.
  pub fn new(kind: IoErrorKind, message: []const char) Self {
    Self {
      ._kind = kind,
      ._message = String.from(message),
    }
  }

  /// Error kind.
  pub fn kind(*const self) IoErrorKind {
    self._kind
  }

  /// Human readable message.
  pub fn message(self) String {
    self._message
  }

  /// Build an error from an OS error code.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.NotFound
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.AlreadyExists
  /// * IoErrorKind.InvalidInput
  /// * IoErrorKind.BrokenPipe
  /// * IoErrorKind.ConnectionRefused
  /// * IoErrorKind.ConnectionReset
  /// * IoErrorKind.NotConnected
  /// * IoErrorKind.AddrInUse
  /// * IoErrorKind.AddrNotAvailable
  /// * IoErrorKind.Interrupted
  /// * IoErrorKind.WouldBlock
  /// * IoErrorKind.TimedOut
  /// * IoErrorKind.OutOfMemory
  /// * IoErrorKind.IsADirectory
  /// * IoErrorKind.NotADirectory
  /// * IoErrorKind.Unsupported
  /// * IoErrorKind.InvalidData
  /// * IoErrorKind.Uncategorized
  pub fn from_errno(code: c_int) Self {
    const kind = switch (code) {
      ENOENT => IoErrorKind.NotFound,
      EACCES => IoErrorKind.PermissionDenied,
      EPERM => IoErrorKind.PermissionDenied,
      EEXIST => IoErrorKind.AlreadyExists,
      EINVAL => IoErrorKind.InvalidInput,
      EPIPE => IoErrorKind.BrokenPipe,
      ECONNREFUSED => IoErrorKind.ConnectionRefused,
      ECONNRESET => IoErrorKind.ConnectionReset,
      ENOTCONN => IoErrorKind.NotConnected,
      EADDRINUSE => IoErrorKind.AddrInUse,
      EADDRNOTAVAIL => IoErrorKind.AddrNotAvailable,
      ETIMEDOUT => IoErrorKind.TimedOut,
      EINTR => IoErrorKind.Interrupted,
      EAGAIN => IoErrorKind.WouldBlock,
      ENOMEM => IoErrorKind.OutOfMemory,
      EISDIR => IoErrorKind.IsADirectory,
      ENOTDIR => IoErrorKind.NotADirectory,
      ENOSYS => IoErrorKind.Unsupported,
      EILSEQ => IoErrorKind.InvalidData,
      _ => IoErrorKind.Uncategorized,
    };

    Self {
      ._kind = kind,
      ._message = String.from_cstr(@as([*]char, strerror(code))),
    }
  }

  /// Build an error from the last OS error.
  ///
  /// Possible IoError variants:
  /// * any IoErrorKind the OS reports (see from_errno on posix, win_error on Windows)
  pub fn last_os_error() Self {
    @os[windows] {
      return win_error(GetLastError());
    } else {
      const slot = __errno_location();
      return Self.from_errno(*slot);
    }
  }
}

@os[windows] {
  /// Build an error from a Windows error code.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.NotFound
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.AlreadyExists
  /// * IoErrorKind.InvalidInput
  /// * IoErrorKind.BrokenPipe
  /// * IoErrorKind.ConnectionRefused
  /// * IoErrorKind.ConnectionReset
  /// * IoErrorKind.NotConnected
  /// * IoErrorKind.AddrInUse
  /// * IoErrorKind.AddrNotAvailable
  /// * IoErrorKind.TimedOut
  /// * IoErrorKind.OutOfMemory
  /// * IoErrorKind.Uncategorized
  pub fn win_error(code: WinDWORD) IoError {
    let kind = switch (code) {
      ERROR_FILE_NOT_FOUND => IoErrorKind.NotFound,
      ERROR_PATH_NOT_FOUND => IoErrorKind.NotFound,
      ERROR_ACCESS_DENIED => IoErrorKind.PermissionDenied,
      ERROR_ALREADY_EXISTS => IoErrorKind.AlreadyExists,
      ERROR_FILE_EXISTS => IoErrorKind.AlreadyExists,
      ERROR_INVALID_PARAMETER => IoErrorKind.InvalidInput,
      ERROR_INVALID_HANDLE => IoErrorKind.InvalidInput,
      ERROR_BROKEN_PIPE => IoErrorKind.BrokenPipe,
      ERROR_CONN_REFUSED => IoErrorKind.ConnectionRefused,
      ERROR_CONN_RESET => IoErrorKind.ConnectionReset,
      ERROR_NOT_CONNECTED => IoErrorKind.NotConnected,
      ERROR_ADDR_IN_USE => IoErrorKind.AddrInUse,
      ERROR_ADDR_NOT_AVAIL => IoErrorKind.AddrNotAvailable,
      ERROR_TIMED_OUT => IoErrorKind.TimedOut,
      ERROR_NOT_ENOUGH_MEMORY => IoErrorKind.OutOfMemory,
      _ => IoErrorKind.Uncategorized,
    };

    IoError {
      ._kind = kind,
      ._message = @format("windows error {}", code),
    }
  }
}

/// Standard input handle.
pub struct Stdin {
  /// Read one line, keeping trailing newline.
  pub fn read_line(buf: *String) bool {
    @os[windows] {
      let ok = read_line_fgets(buf);
    } else {
      const ok = read_line_getline(buf);
    }

    ok
  }

  /// Read whole input into buffer.
  pub fn read_to_string(buf: *String) bool {
    let any = false;

    while (Stdin.read_line(buf)) {
      any = true;
    };

    any
  }

  /// Read exactly `n` bytes, appending to buffer.
  /// Returns `true` when all bytes read, `false` on end or error.
  pub fn read_exact(buf: *String, n: usize) bool {
    let chunk: [256]char = @uninit();
    let need = n;

    while (need > 0) {
      let take: usize = 256;

      if (need < take) {
        take = need;
      };

      const got = fread(@as(*void, &chunk[0]), 1, take, stdin);

      if (got == 0) {
        return false;
      };

      (*buf).push_str(chunk[0..got]);
      need -= got;
    };

    true
  }
}

/// Line reader through `getline` (posix).
@os[linux | android | darwin | freebsd] {
  fn read_line_getline(buf: *String) bool {
    let line: *char = @as(*char, nullptr);
    let cap: usize = 0;

    const n = getline(@as(**char, &line), @as(*usize, &cap), stdin);

    if (n < 0) {
      return false;
    };

    (*buf).push_str((@as([*]char, line))[0..@as(usize, n)]);
    Allocator.dealloc(@as(*void, line));

    true
  }
}

/// Line reader through `fgets` chunks (no `getline` here).
@os[windows] {
  fn read_line_fgets(buf: *String) bool {
    let chunk: [256]char = @uninit();
    let any = false;

    while (true) {
      let got = fgets(chunk, 256, stdin);

      if (@as(*void, got) == nullptr) {
        break;
      };

      any = true;

      let i: usize = 0;
      while (i < 256) {
        if (chunk[i] == '\0') {
          break;
        };

        (*buf).push(chunk[i]);

        if (chunk[i] == '\n') {
          return true;
        };

        i += 1;
      };
    };

    any
  }
}

/// Standard output handle.
pub struct Stdout {
  /// Write string slice to output.
  pub fn write(value: []const char) void {
    let out = OutStream {};
    out.write_str(value);
  }

  /// Write string to output.
  pub fn write_string(value: *String) void {
    Stdout.write((*value).slice(..));
  }

  /// Flush output buffer.
  pub fn flush() void {
    let _ = fflush(stdout);
  }
}

/// Standard error handle.
pub struct Stderr {
  /// Write string slice to error output.
  pub fn write(value: []const char) void {
    let _ = fwrite(@as([*]const void, value.ptr), 1, value.len, stderr);
  }

  /// Flush error output.
  pub fn flush() void {
    let _ = fflush(stderr);
  }
}

/// Offset for `Seek`.
pub enum SeekFrom {
  Start: u64,
  End: i64,
  Current: i64,
}

/// Byte source.
pub interface Read {
  /// Reads some bytes into `buf`, returning how many were read. `Ok(0)` means end.
  pub fn read(*self, buf: []char) Result[usize, IoError];

  /// Reads exactly `n` bytes, appending them to `buf`.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.Interrupted
  /// * IoErrorKind.UnexpectedEof
  /// * IoErrorKind.Uncategorized
  pub fn read_exact(*self, buf: *String, n: usize) Result[usize, IoError] {
    let total: usize = 0;

    while (total < n) {
      let chunk: [256]char = @uninit();
      let want: usize = 256;

      if (n - total < want) {
        want = n - total;
      };

      switch (self.read(chunk[0..want])) {
        .Ok(got) => if (got == 0) {
          return Result.Err(IoError.new(IoErrorKind.UnexpectedEof, "early end of file"));
        } else {
          (*buf).push_str(chunk[0..got]);
          total += got;
        },
        .Err(e) => {
          return Result.Err(e);
        },
      };
    };

    return Result.Ok(total);
  }

  /// Reads everything up to the end, appending it to `buf`.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.Interrupted
  /// * IoErrorKind.Uncategorized
  pub fn read_to_string(*self, buf: *String) Result[usize, IoError] {
    let total: usize = 0;

    while (true) {
      let chunk: [256]char = @uninit();

      switch (self.read(chunk[..])) {
        .Ok(got) => if (got == 0) {
          break;
        } else {
          (*buf).push_str(chunk[0..got]);
          total += got;
        },
        .Err(e) => {
          return Result.Err(e);
        },
      };
    };

    return Result.Ok(total);
  }

  /// Reads up to and including the next newline, appending it to `buf`.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.Interrupted
  /// * IoErrorKind.Uncategorized
  pub fn read_line(*self, buf: *String) Result[usize, IoError] {
    let total: usize = 0;

    while (true) {
      let one: [1]char = @uninit();

      switch (self.read(one[..])) {
        .Ok(got) => if (got == 0) {
          return Result.Ok(total);
        } else {
          (*buf).push(one[0]);
          total += 1;

          if (one[0] == '\n') {
            return Result.Ok(total);
          }
        },
        .Err(e) => {
          return Result.Err(e);
        },
      };
    };

    return Result.Ok(total);
  }
}

/// Byte sink.
pub interface Write {
  /// Writes some bytes from `buf`, returning how many were written.
  pub fn write(*self, buf: []const char) Result[usize, IoError];

  /// Flushes buffered bytes to the underlying sink.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.Interrupted
  /// * IoErrorKind.Uncategorized
  pub fn flush(*self) Result[void, IoError] {
    return Result.Ok(.{});
  }

  /// Writes the whole slice, retrying short writes.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.Interrupted
  /// * IoErrorKind.WriteZero
  /// * IoErrorKind.Uncategorized
  pub fn write_all(*self, buf: []const char) Result[usize, IoError] {
    let total: usize = 0;

    while (total < buf.len) {
      switch (self.write(buf[total..buf.len])) {
        .Ok(n) => if (n == 0) {
          return Result.Err(IoError.new(IoErrorKind.WriteZero, "failed to write whole buffer"));
        } else {
          total += n;
        },
        .Err(e) => {
          return Result.Err(e);
        },
      };
    };

    return Result.Ok(total);
  }
}

/// Byte cursor.
pub interface Seek {
  /// Moves the read/write position, returning the new offset.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.InvalidInput
  /// * IoErrorKind.Uncategorized
  pub fn seek(*self, from: SeekFrom) Result[u64, IoError];
}

/// Readable and seekable view over a slice.
pub struct Cursor {
  _data: []const char,
  _pos: usize,
}

implement Cursor {
  /// Cursor starting at the beginning of `data`.
  pub fn new(data: []const char) Self {
    return Self {
      ._data = data,
      ._pos = 0,
    };
  }

  /// Current offset.
  pub fn position(*const self) usize {
    return self._pos;
  }

  /// Moves the offset without bounds checks.
  pub fn set_position(*self, pos: usize) {
    self._pos = pos;
  }

  /// Borrowed contents.
  pub fn get_ref(*const self) []const char {
    return self._data;
  }
}

implement Read : Cursor {
  fn read(*self, buf: []char) Result[usize, IoError] {
    if (self._pos >= self._data.len || buf.len == 0) {
      return Result.Ok(@as(usize, 0));
    };

    let take = self._data.len - self._pos;

    if (buf.len < take) {
      take = buf.len;
    };

    let i: usize = 0;

    while (i < take) {
      buf[i] = self._data[self._pos + i];
      i += 1;
    };

    self._pos += take;

    return Result.Ok(take);
  }
}

implement Seek : Cursor {
  fn seek(*self, from: SeekFrom) Result[u64, IoError] {
    let target: i64 = 0;

    switch (from) {
      .Start(value) => {
        target = @as(i64, value);
      },
      .End(value) => {
        target = @as(i64, self._data.len) + value;
      },
      .Current(value) => {
        target = @as(i64, self._pos) + value;
      },
    };

    if (target < 0) {
      return Result.Err(IoError.new(IoErrorKind.InvalidInput, "negative seek"));
    };

    self._pos = @as(usize, target);

    return Result.Ok(@as(u64, target));
  }
}

/// Reader with an internal buffer.
pub struct BufReader[R: Read] {
  _inner: R,
  _buf: [8192]char,
  _pos: usize,
  _filled: usize,
}

implement[R: Read] BufReader[R] {
  /// Wraps `inner` with a fresh buffer.
  pub fn new(inner: R) Self {
    return Self {
      ._inner = inner,
      ._buf = @uninit(),
      ._pos = 0,
      ._filled = 0,
    };
  }
}

implement[R: Read] Read : BufReader[R] {
  fn read(*self, buf: []char) Result[usize, IoError] {
    if (buf.len == 0) {
      return Result.Ok(@as(usize, 0));
    };

    if (self._pos == self._filled) {
      switch (self._inner.read(self._buf[..])) {
        .Ok(got) => {
          if (got == 0) {
            return Result.Ok(@as(usize, 0));
          };

          self._pos = 0;
          self._filled = got;
        },
        .Err(e) => {
          return Result.Err(e);
        },
      };
    };

    let take = self._filled - self._pos;

    if (buf.len < take) {
      take = buf.len;
    };

    let i: usize = 0;

    while (i < take) {
      buf[i] = self._buf[self._pos + i];
      i += 1;
    };

    self._pos += take;

    return Result.Ok(take);
  }
}

/// Writer with an internal buffer.
pub struct BufWriter[W: Write] {
  _inner: W,
  _buf: [8192]char,
  _len: usize,
}

implement[W: Write] BufWriter[W] {
  /// Wraps `inner` with a fresh buffer.
  pub fn new(inner: W) Self {
    return Self {
      ._inner = inner,
      ._buf = @uninit(),
      ._len = 0,
    };
  }
}

implement[W: Write] BufWriter[W] {
  /// Unwraps the writer without flushing it.
  pub fn into_inner(self) W {
    return self._inner;
  }
}

implement[W: Write] Write : BufWriter[W] {
  fn write(*self, buf: []const char) Result[usize, IoError] {
    if (buf.len >= 8192) {
      switch (self.flush()) {
        .Ok(_) => {},
        .Err(e) => {
          return Result.Err(e);
        },
      };

      return self._inner.write_all(buf);
    };

    if (self._len + buf.len > 8192) {
      switch (self.flush()) {
        .Ok(_) => {},
        .Err(e) => {
          return Result.Err(e);
        },
      };
    };

    let i: usize = 0;

    while (i < buf.len) {
      self._buf[self._len + i] = buf[i];
      i += 1;
    };

    self._len += buf.len;

    return Result.Ok(buf.len);
  }

  fn flush(*self) Result[void, IoError] {
    if (self._len > 0) {
      switch (self._inner.write_all(self._buf[0..self._len])) {
        .Ok(_) => {
          self._len = 0;
        },
        .Err(e) => {
          return Result.Err(e);
        },
      };
    };

    return self._inner.flush();
  }
}

/// Copies the rest of `reader` into `writer`, returning the byte count.
///
/// Possible IoError variants:
/// * IoErrorKind.Interrupted
/// * IoErrorKind.WriteZero
/// * IoErrorKind.Uncategorized
pub fn copy[R: Read, W: Write](reader: *R, writer: *W) Result[u64, IoError] {
  let chunk: [4096]char = @uninit();
  let total: u64 = 0;

  while (true) {
    switch ((*reader).read(chunk[..])) {
      .Ok(got) => if (got == 0) {
        break;
      } else {
        switch ((*writer).write_all(chunk[0..got])) {
          .Ok(_) => {
            total += @as(u64, got);
          },
          .Err(e) => {
            return Result.Err(e);
          },
        }
      },
      .Err(e) => {
        return Result.Err(e);
      },
    };
  };

  return Result.Ok(total);
}
