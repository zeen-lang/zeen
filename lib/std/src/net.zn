use std.ffi;
use std.string;
use std.io;
use std.time;
use std.fmt;
use std.c.types;
use std.c.string;
use std.c.posix.sys.socket;

@os[windows] {
  use std.c.windows.windef;
  use std.c.windows.winbase;
  use std.c.windows.winsock2;
} else {
  use std.c.posix.unistd;
  use std.c.posix.sys.time;
}

pub struct Ipv4Addr {
  _octets: [4]u8,
}

implement Ipv4Addr {
  pub fn new(a: u8, b: u8, c: u8, d: u8) Self {
    const octets: [4]u8 = {a, b, c, d};

    return Self { ._octets = octets };
  }

  pub fn from_u32(value: u32) Self {
    const octets: [4]u8 = {
      @as(u8, value >> 24),
      @as(u8, (value >> 16) & 255),
      @as(u8, (value >> 8) & 255),
      @as(u8, value & 255),
    };

    return Self { ._octets = octets };
  }

  pub fn octets(*const self) [4]u8 {
    return self._octets;
  }

  pub fn to_u32(*const self) u32 {
    let value: u32 = 0;
    let i: usize = 0;

    while (i < 4) {
      value = value * 256 + @as(u32, self._octets[i]);
      i += 1;
    };

    return value;
  }

  pub fn is_loopback(*const self) bool {
    return self._octets[0] == 127;
  }

  pub fn is_unspecified(*const self) bool {
    return self.to_u32() == 0;
  }

  pub fn from_str(s: []const char) Option[Self] {
    let octets: [4]u8 = {0; 4};
    let part: usize = 0;
    let value: u32 = 0;
    let digits: usize = 0;
    let i: usize = 0;

    while (i < s.len) {
      const c = s.ptr[i];

      if (c == '.') {
        if (digits == 0 || part >= 3) {
          return Option.None;
        };

        octets[part] = @as(u8, value);
        part += 1;
        value = 0;
        digits = 0;
        i += 1;
        continue;
      };

      const d = @as(i32, c) - @as(i32, '0');

      if (d < 0 || d > 9) {
        return Option.None;
      };

      value = value * 10 + @as(u32, d);
      digits += 1;

      if (value > 255) {
        return Option.None;
      };

      i += 1;
    };

    if (part != 3 || digits == 0) {
      return Option.None;
    };

    octets[part] = @as(u8, value);

    return Option.Some(Self { ._octets = octets });
  }
}

implement Copy : Ipv4Addr {}

implement Eq : Ipv4Addr {
  fn eq(*const self, other: *const Self) bool {
    return self.to_u32() == other.to_u32();
  }
}

implement Display : Ipv4Addr {
  fn display[W: StrWriter](*const self, out: *W) void {
    Fmt.write_uint(out, @as(u64, self._octets[0]));
    (*out).write_str_single('.');
    Fmt.write_uint(out, @as(u64, self._octets[1]));
    (*out).write_str_single('.');
    Fmt.write_uint(out, @as(u64, self._octets[2]));
    (*out).write_str_single('.');
    Fmt.write_uint(out, @as(u64, self._octets[3]));
  }
}

pub struct Ipv6Addr {
  _octets: [16]u8,
}

implement Ipv6Addr {
  pub fn new(octets: [16]u8) Self {
    return Self { ._octets = octets };
  }

  pub fn octets(*const self) [16]u8 {
    return self._octets;
  }

  pub fn is_unspecified(*const self) bool {
    let i: usize = 0;

    while (i < 16) {
      if (self._octets[i] != 0) {
        return false;
      };

      i += 1;
    };

    return true;
  }

  pub fn is_loopback(*const self) bool {
    let i: usize = 0;

    while (i < 15) {
      if (self._octets[i] != 0) {
        return false;
      };

      i += 1;
    };

    return self._octets[15] == 1;
  }

  pub fn from_str(s: []const char) Option[Self] {
    let left_groups: [8]u16 = {0; 8};
    let right_groups: [8]u16 = {0; 8};
    let dbl: i64 = -1;
    let i: usize = 0;

    while (i + 1 < s.len) {
      if (s.ptr[i] == ':' && s.ptr[i + 1] == ':') {
        if (dbl >= 0) {
          return Option.None;
        };

        dbl = @as(i64, i);
        i += 2;
        continue;
      };

      i += 1;
    };

    const left_end = if (dbl >= 0) { @as(usize, dbl) } else { s.len };
    const left = parse_v6_groups(s.ptr[0..left_end], &left_groups);

    if (left > 8) {
      return Option.None;
    };

    let right: usize = 0;

    if (dbl >= 0) {
      const right_start = @as(usize, dbl) + 2;
      right = parse_v6_groups(s.ptr[right_start..s.len], &right_groups);

      if (right > 8) {
        return Option.None;
      };

      if (left + right > 7) {
        return Option.None;
      };
    } else if (left != 8) {
      return Option.None;
    };

    let groups: [8]u16 = {0; 8};
    let k: usize = 0;

    while (k < left) {
      groups[k] = left_groups[k];
      k += 1;
    };

    k = 0;

    while (k < right) {
      groups[8 - right + k] = right_groups[k];
      k += 1;
    };

    let octets: [16]u8 = {0; 16};
    k = 0;

    while (k < 8) {
      const at = k * 2;

      octets[at] = @as(u8, groups[k] >> 8);
      octets[at + 1] = @as(u8, groups[k] & 255);
      k += 1;
    };

    return Option.Some(Self { ._octets = octets });
  }
}

implement Copy : Ipv6Addr {}

implement Eq : Ipv6Addr {
  fn eq(*const self, other: *const Self) bool {
    let i: usize = 0;

    while (i < 16) {
      if (self._octets[i] != other._octets[i]) {
        return false;
      };

      i += 1;
    };

    return true;
  }
}

implement Display : Ipv6Addr {
  fn display[W: StrWriter](*const self, out: *W) void {
    let groups: [8]u16 = {0; 8};
    let i: usize = 0;

    while (i < 8) {
      const at = i * 2;

      groups[i] = (@as(u16, self._octets[at]) << 8) | @as(u16, self._octets[at + 1]);
      i += 1;
    };

    let best_start: usize = 0;
    let best_len: usize = 0;
    let run_start: usize = 0;
    let run_len: usize = 0;
    i = 0;

    while (i < 8) {
      if (groups[i] == 0) {
        if (run_len == 0) {
          run_start = i;
        };

        run_len += 1;

        if (run_len > best_len) {
          best_len = run_len;
          best_start = run_start;
        };
      } else {
        run_len = 0;
      };

      i += 1;
    };

    if (best_len < 2) {
      best_len = 0;
    };

    i = 0;

    while (i < 8) {
      if (best_len >= 2 && i == best_start) {
        (*out).write_str("::");
        i += best_len;
        continue;
      };

      if (i > 0 && !(best_len >= 2 && i == best_start + best_len)) {
        (*out).write_str_single(':');
      };

      Fmt.write_hex(out, @as(u64, groups[i]));
      i += 1;
    };
  }
}

fn parse_v6_groups(text: []const char, out: *[8]u16) usize {
  let count: usize = 0;
  let i: usize = 0;

  while (i < text.len) {
    if (count >= 8) {
      return 9;
    };

    let value: u32 = 0;
    let digits: usize = 0;

    while (i < text.len && text.ptr[i] != ':') {
      const digit = text.ptr[i].to_digit(16);

      if (digit.is_none() || digits >= 4) {
        return 9;
      };

      value = value * 16 + digit.unwrap();
      digits += 1;
      i += 1;
    };

    if (digits == 0) {
      return 9;
    };

    out[count] = @as(u16, value);
    count += 1;

    if (i < text.len) {
      i += 1;

      if (i == text.len) {
        return 9;
      };
    };
  };

  return count;
}

pub struct IpAddr {
  _v6: bool,
  _octets: [16]u8,
}

implement IpAddr {
  pub fn from_v4(addr: Ipv4Addr) Self {
    let octets: [16]u8 = {0; 16};
    const v4 = addr.octets();

    octets[0] = v4[0];
    octets[1] = v4[1];
    octets[2] = v4[2];
    octets[3] = v4[3];

    return Self { ._v6 = false, ._octets = octets };
  }

  pub fn from_v6(addr: Ipv6Addr) Self {
    return Self { ._v6 = true, ._octets = addr.octets() };
  }

  pub fn is_v6(*const self) bool {
    return self._v6;
  }

  pub fn as_v4(*const self) Option[Ipv4Addr] {
    if (self._v6) {
      return Option.None;
    };

    return Option.Some(Ipv4Addr.new(self._octets[0], self._octets[1], self._octets[2], self._octets[3]));
  }

  pub fn as_v6(*const self) Option[Ipv6Addr] {
    if (!self._v6) {
      return Option.None;
    };

    return Option.Some(Ipv6Addr.new(self._octets));
  }

  pub fn is_loopback(*const self) bool {
    if (self._v6) {
      return Ipv6Addr.new(self._octets).is_loopback();
    };

    return self._octets[0] == 127;
  }

  pub fn is_unspecified(*const self) bool {
    let i: usize = 0;
    const limit = if (self._v6) { @as(usize, 16) } else { @as(usize, 4) };

    while (i < limit) {
      if (self._octets[i] != 0) {
        return false;
      };

      i += 1;
    };

    return true;
  }

  pub fn from_str(s: []const char) Option[Self] {
    let i: usize = 0;
    let has_colon = false;

    while (i < s.len) {
      if (s.ptr[i] == ':') {
        has_colon = true;
        break;
      };

      i += 1;
    };

    if (has_colon) {
      return switch (Ipv6Addr.from_str(s)) {
        .Some(addr) => Option.Some(Self.from_v6(addr)),
        .None => Option.None,
      };
    };

    return switch (Ipv4Addr.from_str(s)) {
      .Some(addr) => Option.Some(Self.from_v4(addr)),
      .None => Option.None,
    };
  }
}

implement Copy : IpAddr {}

implement Eq : IpAddr {
  fn eq(*const self, other: *const Self) bool {
    if (self._v6 != other._v6) {
      return false;
    };

    const limit = if (self._v6) { @as(usize, 16) } else { @as(usize, 4) };
    let i: usize = 0;

    while (i < limit) {
      if (self._octets[i] != other._octets[i]) {
        return false;
      };

      i += 1;
    };

    return true;
  }
}

implement Display : IpAddr {
  fn display[W: StrWriter](*const self, out: *W) void {
    if (self._v6) {
      Ipv6Addr.new(self._octets).display(out);
      return;
    };

    Ipv4Addr.new(self._octets[0], self._octets[1], self._octets[2], self._octets[3]).display(out);
  }
}

/// IPv4 socket address. The ip holds octets in host order.
pub struct SocketAddr {
  _ip: u32,
  _port: u16,
}

implement SocketAddr {
  /// Address from octets in `ip` and `port`.
  pub fn new(ip: u32, port: u16) Self {
    Self { ._ip = ip, ._port = port }
  }

  /// Loopback address on `port`.
  pub fn loopback(port: u16) Self {
    Self { ._ip = 2130706433, ._port = port }
  }

  /// Address that listens on every interface.
  pub fn any(port: u16) Self {
    Self { ._ip = 0, ._port = port }
  }

  /// Socket address from an IPv4 value.
  pub fn from_ipv4(addr: *const Ipv4Addr, port: u16) Self {
    return Self { ._ip = addr.to_u32(), ._port = port };
  }

  /// IP part as a tagged address.
  pub fn ip_addr(*const self) IpAddr {
    return IpAddr.from_v4(Ipv4Addr.from_u32(self._ip));
  }

  /// Octets in host order.
  pub fn ip(*const self) u32 {
    self._ip
  }

  /// Port number.
  pub fn port(*const self) u16 {
    self._port
  }

  /// Parse `a.b.c.d:port`.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.InvalidInput
  pub fn from_str(s: []const char) Result[Self, IoError] {
    let cut: usize = 0;
    let i: usize = 0;

    while (i < s.len) {
      if (s.ptr[i] == ':') {
        cut = i;
        break;
      };

      i += 1;
    };

    if (cut == 0 || cut + 1 >= s.len) {
      return Result.Err(IoError.new(IoErrorKind.InvalidInput, "bad socket address"));
    };

    let c = CString.new(s[0..cut]);
    let raw: u32 = 0;

    if (inet_pton_ip(@as([*]const char, c.as_ptr()), &raw) != 1) {
      return Result.Err(IoError.new(IoErrorKind.InvalidInput, "bad ip address"));
    };

    let port: u32 = 0;
    let any_digit = false;
    let j = cut + 1;

    while (j < s.len) {
      const d = @as(u32, s.ptr[j]);

      if (d < @as(u32, '0') || d > @as(u32, '9')) {
        return Result.Err(IoError.new(IoErrorKind.InvalidInput, "bad port"));
      };

      any_digit = true;
      port = port * 10 + (d - @as(u32, '0'));
      j += 1;
    };

    if (!any_digit || port > 65535) {
      return Result.Err(IoError.new(IoErrorKind.InvalidInput, "bad port"));
    };

    return Result.Ok(Self { ._ip = ntohl(raw), ._port = @as(u16, port) });
  }

  pub fn resolve(host: []const char, port: u16) Result[Self, IoError] {
    const literal = Ipv4Addr.from_str(host);

    if (literal.is_some()) {
      const addr = literal.unwrap();
      return Result.Ok(Self.from_ipv4(&addr, port));
    };

    return resolve_v4(host, port);
  }
}

implement Copy : SocketAddr {}

implement Display : SocketAddr {
  fn display[W: StrWriter](*const self, out: *W) void {
    Fmt.write_uint(out, @as(u64, (self._ip >> 24) & 255));
    (*out).write_str_single('.');
    Fmt.write_uint(out, @as(u64, (self._ip >> 16) & 255));
    (*out).write_str_single('.');
    Fmt.write_uint(out, @as(u64, (self._ip >> 8) & 255));
    (*out).write_str_single('.');
    Fmt.write_uint(out, @as(u64, self._ip & 255));
    (*out).write_str_single(':');
    Fmt.write_uint(out, @as(u64, self._port));
  }
}

@os[windows] {
  fn inet_pton_ip(src: [*]const char, dst: *u32) c_int {
    inet_pton(AF_INET, @as([*]const c_char, src), @as(*void, dst))
  }
} else {
  fn inet_pton_ip(src: [*]const char, dst: *u32) c_int {
    inet_pton(AF_INET, src, @as(*void, dst))
  }
}

@os[linux | android] {
  fn fill_v4(addr: *const SocketAddr, sa: *c_SockAddrIn) void {
    @memset(@as(*[16]u8, sa), 0);
    (*sa).sin_family = @as(c_ushort, AF_INET);
    (*sa).sin_port = htons((*addr).port());
    (*sa).sin_addr.s_addr = htonl((*addr).ip());
  }

  fn read_v4(sa: *const c_SockAddrIn) SocketAddr {
    SocketAddr.new(ntohl((*sa).sin_addr.s_addr), ntohs((*sa).sin_port))
  }
}

@os[darwin | freebsd] {
  fn fill_v4(addr: *const SocketAddr, sa: *c_SockAddrIn) void {
    @memset(@as(*[16]u8, sa), 0);
    (*sa).sin_len = @as(u8, 16);
    (*sa).sin_family = @as(u8, AF_INET);
    (*sa).sin_port = htons((*addr).port());
    (*sa).sin_addr.s_addr = htonl((*addr).ip());
  }

  fn read_v4(sa: *const c_SockAddrIn) SocketAddr {
    SocketAddr.new(ntohl((*sa).sin_addr.s_addr), ntohs((*sa).sin_port))
  }
}

@os[linux | android | darwin | freebsd] {
  fn resolve_v4(host: []const char, port: u16) Result[SocketAddr, IoError] {
    const node = CString.new(host);
    const port_text = @format("{}", port);
    const service = CString.new(port_text.slice(..));

    let hints: c_AddrInfo = @uninit();
    hints.ai_flags = 0;
    hints.ai_family = AF_INET;
    hints.ai_socktype = SOCK_STREAM;
    hints.ai_protocol = 0;
    hints.ai_addrlen = 0;
    hints.ai_addr = @as(*c_SockAddr, nullptr);
    hints.ai_canonname = @as([*]c_char, nullptr);
    hints.ai_next = @as(*c_AddrInfo, nullptr);

    let res: *c_AddrInfo = @uninit();

    if (getaddrinfo(@as([*]const char, node.as_ptr()), @as([*]const char, service.as_ptr()), &hints, &res) != 0) {
      return Result.Err(IoError.new(IoErrorKind.NotFound, "cannot resolve host"));
    };

    const addr = read_v4(@as(*const c_SockAddrIn, @as(*const c_SockAddr, (*res).ai_addr)));
    freeaddrinfo(res);

    return Result.Ok(addr);
  }
}

@os[windows] {
  fn fill_v4(addr: *const SocketAddr, sa: *c_SockAddrInWin) void {
    @memset(@as(*[16]u8, sa), 0);
    (*sa).family = @as(c_ushort, AF_INET);
    (*sa).port = htons((*addr).port());
    (*sa).addr = htonl((*addr).ip());
  }

  fn read_v4_win(sa: *const c_SockAddrInWin) SocketAddr {
    SocketAddr.new(ntohl((*sa).addr), ntohs((*sa).port))
  }

  fn resolve_v4(host: []const char, port: u16) Result[SocketAddr, IoError] {
    switch (ensure_wsa()) {
      .Ok(_) => {},
      .Err(e) => {
        return Result.Err(e);
      },
    };

    const node = CString.new(host);
    const port_text = @format("{}", port);
    const service = CString.new(port_text.slice(..));

    let hints: c_AddrInfoWin = @uninit();
    hints.flags = 0;
    hints.family = AF_INET;
    hints.socktype = SOCK_STREAM;
    hints.protocol = 0;
    hints.addrlen = 0;
    hints.canonname = @as([*]c_char, nullptr);
    hints.addr = @as(*c_SockAddrWin, nullptr);
    hints.next = @as(*c_AddrInfoWin, nullptr);

    let res: *c_AddrInfoWin = @uninit();

    if (getaddrinfo(
      @as([*]const c_char, node.as_ptr()),
      @as([*]const c_char, service.as_ptr()),
      &hints,
      &res,
    ) != 0) {
      return Result.Err(IoError.new(IoErrorKind.NotFound, "cannot resolve host"));
    };

    const addr = read_v4_win(@as(*const c_SockAddrInWin, @as(*const c_SockAddrWin, (*res).addr)));
    freeaddrinfo(res);

    return Result.Ok(addr);
  }
}

@os[windows] {
  let wsa_ready: bool = false;

  fn ensure_wsa() Result[void, IoError] {
    if (wsa_ready) {
      return Result.Ok(.{});
    };

    let scratch: [512]u8 = @uninit();
    let rc = WSAStartup(514, @as(*void, &scratch[0]));

    if (rc != 0) {
      return Result.Err(win_error(@as(WinDWORD, rc)));
    };

    wsa_ready = true;

    return Result.Ok(.{});
  }

  fn new_socket(kind: c_int) Result[usize, IoError] {
    let s = socket(AF_INET, kind, 0);

    if (s == INVALID_SOCKET) {
      return Result.Err(win_error(@as(WinDWORD, WSAGetLastError())));
    };

    let one: c_int = 1;
    let _ = setsockopt(s, SOL_SOCKET_WIN, SO_REUSEADDR_WIN, @as(*const void, &one), 4);

    return Result.Ok(s);
  }

  fn socket_close(sock: usize) void {
    let _ = closesocket(sock);
  }

  fn socket_local_addr(sock: usize) Result[SocketAddr, IoError] {
    let sa: c_SockAddrInWin = @uninit();
    let len: c_int = 16;

    if (getsockname(sock, @as(*c_SockAddrWin, &sa), &len) != 0) {
      return Result.Err(win_error(@as(WinDWORD, WSAGetLastError())));
    };

    return Result.Ok(read_v4_win(&sa));
  }

  fn socket_peer_addr(sock: usize) Result[SocketAddr, IoError] {
    let sa: c_SockAddrInWin = @uninit();
    let len: c_int = 16;

    if (getpeername(sock, @as(*c_SockAddrWin, &sa), &len) != 0) {
      return Result.Err(win_error(@as(WinDWORD, WSAGetLastError())));
    };

    return Result.Ok(read_v4_win(&sa));
  }
} else {
  fn new_socket(kind: c_int) Result[usize, IoError] {
    const fd = socket(AF_INET, kind, 0);

    if (fd < 0) {
      return Result.Err(IoError.last_os_error());
    };

    let one: c_int = 1;
    let _ = setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, @as(*const void, &one), @as(c_socklen_t, 4));

    return Result.Ok(@as(usize, fd));
  }

  fn socket_close(sock: usize) void {
    let _ = close(@as(c_int, sock));
  }

  fn socket_local_addr(sock: usize) Result[SocketAddr, IoError] {
    let sa: c_SockAddrIn = @uninit();
    let len: c_socklen_t = @as(c_socklen_t, 16);

    if (getsockname(@as(c_int, sock), @as(*c_SockAddr, &sa), &len) != 0) {
      return Result.Err(IoError.last_os_error());
    };

    return Result.Ok(read_v4(&sa));
  }

  fn socket_peer_addr(sock: usize) Result[SocketAddr, IoError] {
    let sa: c_SockAddrIn = @uninit();
    let len: c_socklen_t = @as(c_socklen_t, 16);

    if (getpeername(@as(c_int, sock), @as(*c_SockAddr, &sa), &len) != 0) {
      return Result.Err(IoError.last_os_error());
    };

    return Result.Ok(read_v4(&sa));
  }
}

@os[windows] {
  fn set_socket_timeout(sock: usize, option: c_int, timeout: Duration) Result[void, IoError] {
    const ms = timeout.as_millis();
    const value: WinDWORD = if (ms > 4294967295) { 4294967295 } else { @as(WinDWORD, ms) };

    if (setsockopt(sock, SOL_SOCKET_WIN, option, @as(*const void, &value), 4) != 0) {
      return Result.Err(win_error(@as(WinDWORD, WSAGetLastError())));
    };

    return Result.Ok(.{});
  }
} else {
  fn set_socket_timeout(sock: usize, option: c_int, timeout: Duration) Result[void, IoError] {
    const tv = c_Timeval {
      .tv_sec = @as(c_long, timeout.as_secs()),
      .tv_usec = @as(c_suseconds_t, timeout.subsec_nanos() / 1000),
    };

    if (setsockopt(
      @as(c_int, sock),
      SOL_SOCKET,
      option,
      @as(*const void, &tv),
      @as(c_socklen_t, @sizeof(c_Timeval)),
    ) != 0) {
      return Result.Err(IoError.last_os_error());
    };

    return Result.Ok(.{});
  }
}

/// TCP listener bound to an address.
pub struct TcpListener {
  sock: usize,
}

implement TcpListener {
  /// Bind and listen with a 128 backlog.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.AddrInUse
  /// * IoErrorKind.AddrNotAvailable
  /// * IoErrorKind.Uncategorized
  pub fn bind(addr: *const SocketAddr) Result[Self, IoError] {
    @os[windows] {
      switch (ensure_wsa()) {
        .Ok(_) => {},
        .Err(e) => {
          return Result.Err(e);
        },
      };

      switch (new_socket(SOCK_STREAM)) {
        .Ok(sock) => {
          let sa: c_SockAddrInWin = @uninit();
          fill_v4(addr, &sa);

          if (bind(sock, @as(*const c_SockAddrWin, &sa), 16) != 0) {
            let _ = closesocket(sock);
            return Result.Err(win_error(@as(WinDWORD, WSAGetLastError())));
          };

          if (listen(sock, 128) != 0) {
            let _ = closesocket(sock);
            return Result.Err(win_error(@as(WinDWORD, WSAGetLastError())));
          };

          return Result.Ok(Self { .sock = sock });
        },
        .Err(e) => {
          return Result.Err(e);
        },
      };
    } else {
      switch (new_socket(SOCK_STREAM)) {
        .Ok(sock) => {
          let sa: c_SockAddrIn = @uninit();
          fill_v4(addr, &sa);

          if (bind(@as(c_int, sock), @as(*const c_SockAddr, &sa), @as(c_socklen_t, 16)) != 0) {
            socket_close(sock);
            return Result.Err(IoError.last_os_error());
          };

          if (listen(@as(c_int, sock), 128) != 0) {
            socket_close(sock);
            return Result.Err(IoError.last_os_error());
          };

          return Result.Ok(Self { .sock = sock });
        },
        .Err(e) => {
          return Result.Err(e);
        },
      };
    }
  }

  /// Accept one incoming connection.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.Interrupted
  /// * IoErrorKind.OutOfMemory
  /// * IoErrorKind.Uncategorized
  pub fn accept(*const self) Result[TcpStream, IoError] {
    @os[windows] {
      let sa: c_SockAddrInWin = @uninit();
      let len: c_int = 16;
      let peer = accept(self.sock, @as(*c_SockAddrWin, &sa), &len);

      if (peer == INVALID_SOCKET) {
        return Result.Err(win_error(@as(WinDWORD, WSAGetLastError())));
      };

      return Result.Ok(TcpStream { .sock = peer });
    } else {
      let sa: c_SockAddrIn = @uninit();
      let len: c_socklen_t = @as(c_socklen_t, 16);
      const peer = accept(@as(c_int, self.sock), @as(*c_SockAddr, &sa), &len);

      if (peer < 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(TcpStream { .sock = @as(usize, peer) });
    }
  }

  /// Address this listener is bound to.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.Uncategorized
  pub fn local_addr(*const self) Result[SocketAddr, IoError] {
    socket_local_addr(self.sock)
  }
}

implement Drop : TcpListener {
  fn drop(self) {
    socket_close(self.sock);
  }
}

/// Connected TCP stream.
pub struct TcpStream {
  sock: usize,
}

implement TcpStream {
  /// Connect to an address.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.ConnectionRefused
  /// * IoErrorKind.TimedOut
  /// * IoErrorKind.AddrNotAvailable
  /// * IoErrorKind.Interrupted
  /// * IoErrorKind.Uncategorized
  pub fn connect(addr: *const SocketAddr) Result[Self, IoError] {
    @os[windows] {
      switch (ensure_wsa()) {
        .Ok(_) => {},
        .Err(e) => {
          return Result.Err(e);
        },
      };

      switch (new_socket(SOCK_STREAM)) {
        .Ok(sock) => {
          let sa: c_SockAddrInWin = @uninit();
          fill_v4(addr, &sa);

          if (connect(sock, @as(*const c_SockAddrWin, &sa), 16) != 0) {
            let _ = closesocket(sock);
            return Result.Err(win_error(@as(WinDWORD, WSAGetLastError())));
          };

          return Result.Ok(Self { .sock = sock });
        },
        .Err(e) => {
          return Result.Err(e);
        },
      };
    } else {
      switch (new_socket(SOCK_STREAM)) {
        .Ok(sock) => {
          let sa: c_SockAddrIn = @uninit();
          fill_v4(addr, &sa);

          if (connect(@as(c_int, sock), @as(*const c_SockAddr, &sa), @as(c_socklen_t, 16)) != 0) {
            socket_close(sock);
            return Result.Err(IoError.last_os_error());
          };

          return Result.Ok(Self { .sock = sock });
        },
        .Err(e) => {
          return Result.Err(e);
        },
      };
    }
  }

  /// Shut down both directions of the stream.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.NotConnected
  /// * IoErrorKind.Uncategorized
  pub fn shutdown(*const self) Result[void, IoError] {
    @os[windows] {
      if (shutdown(self.sock, SD_BOTH) != 0) {
        return Result.Err(win_error(@as(WinDWORD, WSAGetLastError())));
      };

      return Result.Ok(.{});
    } else {
      if (shutdown(@as(c_int, self.sock), SHUT_RDWR) != 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(.{});
    }
  }

  /// Address this stream is bound to locally.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.Uncategorized
  pub fn local_addr(*const self) Result[SocketAddr, IoError] {
    socket_local_addr(self.sock)
  }

  /// Address the other end is bound to.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.NotConnected
  /// * IoErrorKind.Uncategorized
  pub fn peer_addr(*const self) Result[SocketAddr, IoError] {
    socket_peer_addr(self.sock)
  }

  pub fn set_read_timeout(*const self, timeout: Duration) Result[void, IoError] {
    set_socket_timeout(self.sock, SO_RCVTIMEO, timeout)
  }

  pub fn set_write_timeout(*const self, timeout: Duration) Result[void, IoError] {
    set_socket_timeout(self.sock, SO_SNDTIMEO, timeout)
  }
}

implement Read : TcpStream {
  /// Read some bytes into `buf`. `Ok(0)` means end of stream.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.ConnectionReset
  /// * IoErrorKind.Interrupted
  /// * IoErrorKind.Uncategorized
  fn read(*self, buf: []char) Result[usize, IoError] {
    @os[windows] {
      const got = recv(self.sock, @as([*]c_char, buf.ptr), @as(c_int, buf.len), 0);

      if (got < 0) {
        return Result.Err(win_error(@as(WinDWORD, WSAGetLastError())));
      };

      return Result.Ok(@as(usize, got));
    } else {
      const got = recv(@as(c_int, self.sock), @as(*void, buf.ptr), buf.len, 0);

      if (got < 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(@as(usize, got));
    }
  }
}

implement Write : TcpStream {
  /// Write some bytes from the slice.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.BrokenPipe
  /// * IoErrorKind.ConnectionReset
  /// * IoErrorKind.Interrupted
  /// * IoErrorKind.Uncategorized
  fn write(*self, buf: []const char) Result[usize, IoError] {
    @os[windows] {
      const n = send(self.sock, @as([*]const c_char, buf.ptr), @as(c_int, buf.len), 0);

      if (n < 0) {
        return Result.Err(win_error(@as(WinDWORD, WSAGetLastError())));
      };

      return Result.Ok(@as(usize, n));
    } else {
      const n = send(@as(c_int, self.sock), @as([*]const void, buf.ptr), buf.len, 0);

      if (n < 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(@as(usize, n));
    }
  }
}

implement Drop : TcpStream {
  fn drop(self) {
    socket_close(self.sock);
  }
}

/// UDP socket.
pub struct UdpSocket {
  sock: usize,
}

implement UdpSocket {
  /// Bind to an address for sending and receiving datagrams.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.AddrInUse
  /// * IoErrorKind.AddrNotAvailable
  /// * IoErrorKind.Uncategorized
  pub fn bind(addr: *const SocketAddr) Result[Self, IoError] {
    @os[windows] {
      switch (ensure_wsa()) {
        .Ok(_) => {},
        .Err(e) => {
          return Result.Err(e);
        },
      };

      switch (new_socket(SOCK_DGRAM)) {
        .Ok(sock) => {
          let sa: c_SockAddrInWin = @uninit();
          fill_v4(addr, &sa);

          if (bind(sock, @as(*const c_SockAddrWin, &sa), 16) != 0) {
            let _ = closesocket(sock);
            return Result.Err(win_error(@as(WinDWORD, WSAGetLastError())));
          };

          return Result.Ok(Self { .sock = sock });
        },
        .Err(e) => {
          return Result.Err(e);
        },
      };
    } else {
      switch (new_socket(SOCK_DGRAM)) {
        .Ok(sock) => {
          let sa: c_SockAddrIn = @uninit();
          fill_v4(addr, &sa);

          if (bind(@as(c_int, sock), @as(*const c_SockAddr, &sa), @as(c_socklen_t, 16)) != 0) {
            socket_close(sock);
            return Result.Err(IoError.last_os_error());
          };

          return Result.Ok(Self { .sock = sock });
        },
        .Err(e) => {
          return Result.Err(e);
        },
      };
    }
  }

  /// Send one datagram.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.AddrNotAvailable
  /// * IoErrorKind.InvalidInput
  /// * IoErrorKind.Interrupted
  /// * IoErrorKind.Uncategorized
  pub fn send_to(*const self, buf: []const char, addr: *const SocketAddr) Result[usize, IoError] {
    @os[windows] {
      let sa: c_SockAddrInWin = @uninit();
      fill_v4(addr, &sa);
      let n = sendto(
        self.sock,
        @as([*]const c_char, buf.ptr),
        @as(c_int, buf.len),
        0,
        @as(*const c_SockAddrWin, &sa),
        16,
      );

      if (n < 0) {
        return Result.Err(win_error(@as(WinDWORD, WSAGetLastError())));
      };

      return Result.Ok(@as(usize, n));
    } else {
      let sa: c_SockAddrIn = @uninit();
      fill_v4(addr, &sa);
      const n = sendto(
        @as(c_int, self.sock),
        @as([*]const void, buf.ptr),
        buf.len,
        0,
        @as(*const c_SockAddr, &sa),
        @as(c_socklen_t, 16),
      );

      if (n < 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(@as(usize, n));
    }
  }

  /// Receive one datagram, appending it to buffer. Returns the sender.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.Interrupted
  /// * IoErrorKind.Uncategorized
  pub fn recv_from(*self, buf: *String) Result[SocketAddr, IoError] {
    @os[windows] {
      let chunk: [2048]char = @uninit();
      let sa: c_SockAddrInWin = @uninit();
      let len: c_int = 16;
      let got = recvfrom(
        self.sock,
        @as([*]c_char, &chunk[0]),
        2048,
        0,
        @as(*c_SockAddrWin, &sa),
        &len,
      );

      if (got < 0) {
        return Result.Err(win_error(@as(WinDWORD, WSAGetLastError())));
      };

      (*buf).push_str(chunk[0..@as(usize, got)]);

      return Result.Ok(read_v4_win(&sa));
    } else {
      let chunk: [2048]char = @uninit();
      let sa: c_SockAddrIn = @uninit();
      let len: c_socklen_t = @as(c_socklen_t, 16);
      const got = recvfrom(
        @as(c_int, self.sock),
        @as(*void, &chunk[0]),
        2048,
        0,
        @as(*c_SockAddr, &sa),
        &len,
      );

      if (got < 0) {
        return Result.Err(IoError.last_os_error());
      };

      (*buf).push_str(chunk[0..@as(usize, got)]);

      return Result.Ok(read_v4(&sa));
    }
  }

  /// Address this socket is bound to.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.Uncategorized
  pub fn local_addr(*const self) Result[SocketAddr, IoError] {
    socket_local_addr(self.sock)
  }

  pub fn set_read_timeout(*const self, timeout: Duration) Result[void, IoError] {
    set_socket_timeout(self.sock, SO_RCVTIMEO, timeout)
  }
}

implement Drop : UdpSocket {
  fn drop(self) {
    socket_close(self.sock);
  }
}
