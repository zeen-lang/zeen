implement Math[i32] {
  /// `base` raised to the integer power `exp`.
  pub fn pow(base: i32, exp: u32) i32 {
    let result: i32 = 1;
    let b = base;
    let e = exp;

    while (e > 0) {
      if ((e & 1) == 1) {
        result = result * b;
      };

      b = b * b;
      e = e >> 1;
    };

    return result;
  }

  /// Greatest common divisor (always non-negative).
  pub fn gcd(a: i32, b: i32) i32 {
    let x = if (a < 0) { -a } else { a };
    let y = if (b < 0) { -b } else { b };

    while (y != 0) {
      const r = x % y;
      x = y;
      y = r;
    };

    return x;
  }

  /// Least common multiple (zero if either side is zero).
  pub fn lcm(a: i32, b: i32) i32 {
    if (a == 0 || b == 0) {
      return 0;
    };

    const d = Math.gcd(a, b);
    return (a / d) * b;
  }

  /// Sign of `x` as `-1`, `0` or `1`.
  pub fn signum(x: i32) i32 {
    if (x < 0) {
      return -1;
    };

    if (x > 0) {
      return 1;
    };

    return 0;
  }
}

