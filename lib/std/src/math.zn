use std.c.math;

/// Pi circle constant.
pub comptime PI = 3.141592653589793;
/// Full circle constant (`2 * PI`).
pub comptime TAU = 6.283185307179586;
/// Euler number.
pub comptime E = 2.718281828459045;
/// Square root of two.
pub comptime SQRT_2 = 1.4142135623730951;
/// Natural logarithm of two.
pub comptime LN_2 = 0.6931471805599453;
/// Natural logarithm of ten.
pub comptime LN_10 = 2.302585092994046;

/// Static math helpers.
pub struct Math[T] {}

implement[T: Ord] Math[T] {
  /// Smaller of two values.
  pub fn min(a: T, b: T) T {
    if (a < b) {
      return a;
    };

    return b;
  }

  /// Greater of two values.
  pub fn max(a: T, b: T) T {
    if (a > b) {
      return a;
    };

    return b;
  }

  /// Clamp value into `[lo, hi]`.
  pub fn clamp(value: T, lo: T, hi: T) T {
    if (value < lo) {
      return lo;
    };

    if (value > hi) {
      return hi;
    };

    return value;
  }
}

implement[T: Ord + Neg] Math[T] {
  /// Absolute value.
  pub fn abs(x: T) T {
    if (x < -x) {
      return -x;
    };

    return x;
  }
}

implement Math[f64] {
  /// Square root.
  pub fn sqrt(x: f64) f64 {
    return x.sqrt();
  }

  /// Cube root.
  pub fn cbrt(x: f64) f64 {
    return x.cbrt();
  }

  /// Length of the hypotenuse of a right triangle.
  pub fn hypot(x: f64, y: f64) f64 {
    return x.hypot(y);
  }

  /// `x` raised to the power `y`.
  pub fn pow(x: f64, y: f64) f64 {
    return x.powf(y);
  }

  /// `x` raised to the integer power `n`.
  pub fn powi(x: f64, n: i32) f64 {
    return x.powi(n);
  }

  /// `e` raised to the power `x`.
  pub fn exp(x: f64) f64 {
    return x.exp();
  }

  /// `2` raised to the power `x`.
  pub fn exp2(x: f64) f64 {
    return x.exp2();
  }

  /// `e` raised to the power `x` minus one.
  pub fn exp_m1(x: f64) f64 {
    return x.exp_m1();
  }

  /// Natural logarithm.
  pub fn ln(x: f64) f64 {
    return x.ln();
  }

  /// Natural logarithm of `x + 1`.
  pub fn ln_1p(x: f64) f64 {
    return x.ln_1p();
  }

  /// Base two logarithm.
  pub fn log2(x: f64) f64 {
    return x.log2();
  }

  /// Base ten logarithm.
  pub fn log10(x: f64) f64 {
    return x.log10();
  }

  /// Logarithm of `x` in `base`.
  pub fn log(x: f64, base: f64) f64 {
    return x.log(base);
  }

  /// Floating point remainder of `x` divided by `y`.
  pub fn rem(x: f64, y: f64) f64 {
    return fmod(x, y);
  }

  /// Sine.
  pub fn sin(x: f64) f64 {
    return x.sin();
  }

  /// Cosine.
  pub fn cos(x: f64) f64 {
    return x.cos();
  }

  /// Tangent.
  pub fn tan(x: f64) f64 {
    return x.tan();
  }

  /// Arcsine.
  pub fn asin(x: f64) f64 {
    return x.asin();
  }

  /// Arccosine.
  pub fn acos(x: f64) f64 {
    return x.acos();
  }

  /// Arctangent.
  pub fn atan(x: f64) f64 {
    return x.atan();
  }

  /// Arctangent of `y / x` using the signs of both values.
  pub fn atan2(y: f64, x: f64) f64 {
    return y.atan2(x);
  }

  /// Hyperbolic sine.
  pub fn sinh(x: f64) f64 {
    return x.sinh();
  }

  /// Hyperbolic cosine.
  pub fn cosh(x: f64) f64 {
    return x.cosh();
  }

  /// Hyperbolic tangent.
  pub fn tanh(x: f64) f64 {
    return x.tanh();
  }

  /// Inverse hyperbolic sine.
  pub fn asinh(x: f64) f64 {
    return x.asinh();
  }

  /// Inverse hyperbolic cosine.
  pub fn acosh(x: f64) f64 {
    return x.acosh();
  }

  /// Inverse hyperbolic tangent.
  pub fn atanh(x: f64) f64 {
    return x.atanh();
  }

  /// Largest integer not greater than `x`.
  pub fn floor(x: f64) f64 {
    return x.floor();
  }

  /// Smallest integer not less than `x`.
  pub fn ceil(x: f64) f64 {
    return x.ceil();
  }

  /// Nearest integer, halfway cases away from zero.
  pub fn round(x: f64) f64 {
    return x.round();
  }

  /// Integer part of `x`.
  pub fn trunc(x: f64) f64 {
    return x.trunc();
  }

  /// Fractional part of `x`.
  pub fn fract(x: f64) f64 {
    return x.fract();
  }

  /// Reciprocal of `x`.
  pub fn recip(x: f64) f64 {
    return x.recip();
  }

  /// Sign of `x` as `-1`, `0` or `1`.
  pub fn signum(x: f64) f64 {
    return x.signum();
  }

  /// Magnitude of `x` with the sign of `sign`.
  pub fn copysign(x: f64, sign: f64) f64 {
    return x.copysign(sign);
  }

  /// Fused multiply add, `x * a + b`.
  pub fn mul_add(x: f64, a: f64, b: f64) f64 {
    return x.mul_add(a, b);
  }

  /// Linear interpolation between `a` and `b`.
  pub fn lerp(a: f64, b: f64, t: f64) f64 {
    return a + (b - a) * t;
  }

  /// Radians converted to degrees.
  pub fn to_degrees(x: f64) f64 {
    return x.to_degrees();
  }

  /// Degrees converted to radians.
  pub fn to_radians(x: f64) f64 {
    return x.to_radians();
  }

  /// `true` for NaN values.
  pub fn is_nan(x: f64) bool {
    return x.is_nan();
  }

  /// `true` for infinite values.
  pub fn is_inf(x: f64) bool {
    return x.is_infinite();
  }

  /// `true` for finite values.
  pub fn is_finite(x: f64) bool {
    return x.is_finite();
  }

  /// `true` when the sign bit is clear.
  pub fn is_sign_positive(x: f64) bool {
    return x.is_sign_positive();
  }

  /// `true` when the sign bit is set.
  pub fn is_sign_negative(x: f64) bool {
    return x.is_sign_negative();
  }
}

