const SBOX: [256]u8 = {
  0x63, 0x7c, 0x77, 0x7b, 0xf2, 0x6b, 0x6f, 0xc5, 0x30, 0x01, 0x67, 0x2b, 0xfe, 0xd7, 0xab, 0x76,
  0xca, 0x82, 0xc9, 0x7d, 0xfa, 0x59, 0x47, 0xf0, 0xad, 0xd4, 0xa2, 0xaf, 0x9c, 0xa4, 0x72, 0xc0,
  0xb7, 0xfd, 0x93, 0x26, 0x36, 0x3f, 0xf7, 0xcc, 0x34, 0xa5, 0xe5, 0xf1, 0x71, 0xd8, 0x31, 0x15,
  0x04, 0xc7, 0x23, 0xc3, 0x18, 0x96, 0x05, 0x9a, 0x07, 0x12, 0x80, 0xe2, 0xeb, 0x27, 0xb2, 0x75,
  0x09, 0x83, 0x2c, 0x1a, 0x1b, 0x6e, 0x5a, 0xa0, 0x52, 0x3b, 0xd6, 0xb3, 0x29, 0xe3, 0x2f, 0x84,
  0x53, 0xd1, 0x00, 0xed, 0x20, 0xfc, 0xb1, 0x5b, 0x6a, 0xcb, 0xbe, 0x39, 0x4a, 0x4c, 0x58, 0xcf,
  0xd0, 0xef, 0xaa, 0xfb, 0x43, 0x4d, 0x33, 0x85, 0x45, 0xf9, 0x02, 0x7f, 0x50, 0x3c, 0x9f, 0xa8,
  0x51, 0xa3, 0x40, 0x8f, 0x92, 0x9d, 0x38, 0xf5, 0xbc, 0xb6, 0xda, 0x21, 0x10, 0xff, 0xf3, 0xd2,
  0xcd, 0x0c, 0x13, 0xec, 0x5f, 0x97, 0x44, 0x17, 0xc4, 0xa7, 0x7e, 0x3d, 0x64, 0x5d, 0x19, 0x73,
  0x60, 0x81, 0x4f, 0xdc, 0x22, 0x2a, 0x90, 0x88, 0x46, 0xee, 0xb8, 0x14, 0xde, 0x5e, 0x0b, 0xdb,
  0xe0, 0x32, 0x3a, 0x0a, 0x49, 0x06, 0x24, 0x5c, 0xc2, 0xd3, 0xac, 0x62, 0x91, 0x95, 0xe4, 0x79,
  0xe7, 0xc8, 0x37, 0x6d, 0x8d, 0xd5, 0x4e, 0xa9, 0x6c, 0x56, 0xf4, 0xea, 0x65, 0x7a, 0xae, 0x08,
  0xba, 0x78, 0x25, 0x2e, 0x1c, 0xa6, 0xb4, 0xc6, 0xe8, 0xdd, 0x74, 0x1f, 0x4b, 0xbd, 0x8b, 0x8a,
  0x70, 0x3e, 0xb5, 0x66, 0x48, 0x03, 0xf6, 0x0e, 0x61, 0x35, 0x57, 0xb9, 0x86, 0xc1, 0x1d, 0x9e,
  0xe1, 0xf8, 0x98, 0x11, 0x69, 0xd9, 0x8e, 0x94, 0x9b, 0x1e, 0x87, 0xe9, 0xce, 0x55, 0x28, 0xdf,
  0x8c, 0xa1, 0x89, 0x0d, 0xbf, 0xe6, 0x42, 0x68, 0x41, 0x99, 0x2d, 0x0f, 0xb0, 0x54, 0xbb, 0x16,
};

const RCON: [8]u32 = {0, 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40};
const SHIFTS: [4]u32 = {24, 16, 8, 0};

fn sub_word(word: u32) u32 {
  return (@as(u32, SBOX[@as(usize, @as(u8, word >> 24))]) << 24)
    | (@as(u32, SBOX[@as(usize, @as(u8, word >> 16))]) << 16)
    | (@as(u32, SBOX[@as(usize, @as(u8, word >> 8))]) << 8)
    | @as(u32, SBOX[@as(usize, @as(u8, word))]);
}

fn rot_word(word: u32) u32 {
  return (word << 8) | (word >> 24);
}

fn xtime(value: u8) u8 {
  let doubled = @as(u8, @as(u16, value) << 1);

  if ((value & @as(u8, 0x80)) != 0) {
    doubled = doubled ^ @as(u8, 0x1b);
  };

  return doubled;
}

fn add_round_key(state: *[16]u8, keys: *const [60]u32, round: usize) {
  let i: usize = 0;

  while (i < 16) {
    state[i] = state[i] ^ @as(u8, keys[round * 4 + i / 4] >> SHIFTS[i % 4]);
    i += 1;
  };
}

fn sub_shift(state: *[16]u8) {
  let mixed: [16]u8 = {0; 16};
  let r: usize = 0;

  while (r < 4) {
    let c: usize = 0;

    while (c < 4) {
      mixed[r + 4 * c] = SBOX[@as(usize, state[r + 4 * ((c + r) % 4)])];
      c += 1;
    };

    r += 1;
  };

  r = 0;

  while (r < 16) {
    state[r] = mixed[r];
    r += 1;
  };
}

fn mix_columns(state: *[16]u8) {
  let c: usize = 0;

  while (c < 4) {
    const a0 = state[4 * c];
    const a1 = state[4 * c + 1];
    const a2 = state[4 * c + 2];
    const a3 = state[4 * c + 3];
    const all = a0 ^ a1 ^ a2 ^ a3;

    state[4 * c] = state[4 * c] ^ all ^ xtime(a0 ^ a1);
    state[4 * c + 1] = state[4 * c + 1] ^ all ^ xtime(a1 ^ a2);
    state[4 * c + 2] = state[4 * c + 2] ^ all ^ xtime(a2 ^ a3);
    state[4 * c + 3] = state[4 * c + 3] ^ all ^ xtime(a3 ^ a0);
    c += 1;
  };
}

pub struct Aes256 {
  _round_keys: [60]u32,
}

implement Aes256 {
  pub fn new(key: []const char) Self {
    if (key.len != 32) {
      @panic("aes256 needs a 32-byte key");
    };

    let words: [60]u32 = {0; 60};
    let i: usize = 0;

    while (i < 8) {
      const at = i * 4;

      words[i] = (@as(u32, key[at]) << 24)
        | (@as(u32, key[at + 1]) << 16)
        | (@as(u32, key[at + 2]) << 8)
        | @as(u32, key[at + 3]);
      i += 1;
    };

    while (i < 60) {
      let temp = words[i - 1];

      if (i % 8 == 0) {
        temp = sub_word(rot_word(temp)) ^ (RCON[i / 8] << 24);
      } else if (i % 8 == 4) {
        temp = sub_word(temp);
      };

      words[i] = words[i - 8] ^ temp;
      i += 1;
    };

    return Self { ._round_keys = words };
  }

  pub fn encrypt(*const self, block: []char) void {
    if (block.len != 16) {
      @panic("aes256 encrypts one 16-byte block");
    };

    let state: [16]u8 = {0; 16};
    let i: usize = 0;

    while (i < 16) {
      state[i] = @as(u8, block[i]);
      i += 1;
    };

    add_round_key(&state, &self._round_keys, 0);

    let round: usize = 1;

    while (round < 14) {
      sub_shift(&state);
      mix_columns(&state);
      add_round_key(&state, &self._round_keys, round);
      round += 1;
    };

    sub_shift(&state);
    add_round_key(&state, &self._round_keys, 14);

    i = 0;

    while (i < 16) {
      block[i] = @as(char, state[i]);
      i += 1;
    };
  }
}
