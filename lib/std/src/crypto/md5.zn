use std.string;
use std.crypto.hash;

fn rotl32(x: u32, n: u32) u32 {
  return (x << n) | (x >> (32 - n));
}

fn compress128(state: *[4]u32, block: []const char) {
  const k: [64]u32 = {0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501, 0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821, 0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8, 0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a, 0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70, 0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665, 0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1, 0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391};
  const shifts: [64]u32 = {7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21};
  let m: [16]u32 = {0; 16};

  let word: usize = 0;
  while (word < 16) {
    const offset = word * 4;
    const byte0 = @as(u32, block[offset]);
    const byte1 = @as(u32, block[offset + 1]) << 8;
    const byte2 = @as(u32, block[offset + 2]) << 16;
    const byte3 = @as(u32, block[offset + 3]) << 24;

    m[word] = (byte0 | byte1) | (byte2 | byte3);
    word += 1;
  }

  let a = state[0];
  let b = state[1];
  let c = state[2];
  let d = state[3];

  let round: usize = 0;
  while (round < 64) {
    let f: u32 = 0;
    let g: usize = 0;

    if (round < 16) {
      f = (b & c) | ((b ^ 0xFFFFFFFF) & d);
      g = round;
    } else if (round < 32) {
      f = (d & b) | ((d ^ 0xFFFFFFFF) & c);
      g = (5 * round + 1) % 16;
    } else if (round < 48) {
      f = b ^ c ^ d;
      g = (3 * round + 5) % 16;
    } else {
      f = c ^ (b | (d ^ 0xFFFFFFFF));
      g = (7 * round) % 16;
    };

    const sum = (a + f + k[round]) + m[g];
    const temp = d;

    d = c;
    c = b;
    b = b + rotl32(sum, shifts[round]);
    a = temp;
    round += 1;
  }

  state[0] += a;
  state[1] += b;
  state[2] += c;
  state[3] += d;
}

pub struct Md5 {
  _state: [4]u32,
  _buffer: [64]char,
  _buffered: usize,
  _length: u64,
}

implement Md5 {
  pub fn new() Self {
    const state: [4]u32 = {0; 4};
    let hasher = Self { ._state = state, ._buffer = {'\0'; 64}, ._buffered = 0, ._length = 0 };

    hasher.reset();
    return hasher;
  }

  pub fn digest(data: []const char) [16]char {
    let hasher = Md5.new();

    hasher.update(data);
    return hasher.finalize();
  }

  pub fn hexdigest(data: []const char) String {
    const out = Md5.digest(data);

    return Hashing.hexdigest(out[..]);
  }
}

implement Digest : Md5 {
  alias Output = [16]char;

  pub fn update(*self, data: []const char) {
    let i: usize = 0;

    while (i < data.len) {
      self._buffer[self._buffered] = data[i];
      self._buffered += 1;
      self._length += 1;

      if (self._buffered == 64) {
        compress128(&self._state, self._buffer[..]);
        self._buffered = 0;
      };

      i += 1;
    }
  }

  pub fn finalize(*self) [16]char {
    const bit_length = self._length * 8;

    self._buffer[self._buffered] = @as(char, 128);
    self._buffered += 1;

    if (self._buffered > 56) {
      while (self._buffered < 64) {
        self._buffer[self._buffered] = '\0';
        self._buffered += 1;
      };

      compress128(&self._state, self._buffer[..]);
      self._buffered = 0;
    };

    while (self._buffered < 56) {
      self._buffer[self._buffered] = '\0';
      self._buffered += 1;
    };

    let shift: u64 = 0;
    while (true) {
      self._buffer[self._buffered] = @as(char, bit_length >> shift);
      self._buffered += 1;

      if (shift == 56) {
        break;
      };

      shift += 8;
    };

    compress128(&self._state, self._buffer[..]);

    let out: [16]char = {'\0'; 16};
    let word: usize = 0;
    while (word < 4) {
      const value = self._state[word];

      out[word * 4] = @as(char, value);
      out[word * 4 + 1] = @as(char, value >> 8);
      out[word * 4 + 2] = @as(char, value >> 16);
      out[word * 4 + 3] = @as(char, value >> 24);
      word += 1;
    };

    self.reset();
    return out;
  }

  pub fn reset(*self) {
    self._state = {0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476};
    self._buffered = 0;
    self._length = 0;
  }
}
