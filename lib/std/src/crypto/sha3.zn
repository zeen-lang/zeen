pub struct Shake128 {
  _k: Keccak,
}

implement Shake128 {
  pub fn new() Self {
    return Self { ._k = Keccak.init(168, 31) };
  }

  pub fn absorb(*self, data: []const char) {
    self._k.absorb(data);
  }

  pub fn squeeze(*self, out: []char) {
    self._k.pad();
    self._k.squeeze(out);
  }

  pub fn reset(*self) {
    self._k = Keccak.init(168, 31);
  }

  pub fn hash(data: []const char, out: []char) {
    let hasher = Shake128.new();

    hasher.absorb(data);
    hasher.squeeze(out);
  }
}

pub struct Shake256 {
  _k: Keccak,
}

implement Shake256 {
  pub fn new() Self {
