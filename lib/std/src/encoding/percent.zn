/// Percent encoding, RFC 3986.
pub struct Percent {
  /// Encode bytes, keeping unreserved characters as is.
  pub fn encode(data: []const char) String {
    const digits: []const char = "0123456789ABCDEF";
    let out = String.new();
    let i: usize = 0;

    while (i < data.len) {
      const ch = data[i];
      if (Percent.unreserved(ch)) {
        out.push(ch);
      } else {
        const byte = @as(u32, ch);
        out.push('%');
        out.push(digits[@as(usize, byte >> 4)]);
        out.push(digits[@as(usize, byte & 15)]);
      };
      i += 1;
    }

    return out;
  }

  /// Decode percent escapes, `None` on malformed input.
  pub fn decode(data: []const char) Option[String] {
    let out = String.new();
    let i: usize = 0;

    while (i < data.len) {
      if (data[i] != '%') {
        out.push(data[i]);
        i += 1;
      } else {
        if (i + 2 >= data.len) {
          return Option.None;
        };
        const hi = data[i + 1].to_digit(16);
        const lo = data[i + 2].to_digit(16);
        if (hi.is_none() || lo.is_none()) {
          return Option.None;
        };
        out.push(@as(char, (hi.unwrap() << 4) | lo.unwrap()));
        i += 3;
      };
    }

    return Option.Some(out);
  }

  fn unreserved(ch: char) bool {
    return ch.is_ascii_alphanumeric() || ch == '-' || ch == '.' || ch == '_' || ch == '~';
  }
}
