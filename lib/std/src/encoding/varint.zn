/// LEB128 variable length integers.
pub struct Varint {
  /// Write `value` as unsigned LEB128 at `offset`.
  pub fn write_u64(out: []char, offset: *usize, value: u64) void {
    let i = (*offset);
    let rest = value;

    while (rest >= 128) {
      out[i] = @as(char, @as(u8, rest & 127) | 128);
      i += 1;
      rest >>= 7;
    };

    out[i] = @as(char, @as(u8, rest));
    (*offset) = i + 1;
  }

  /// Write `value` as unsigned LEB128 at `offset`.
  pub fn write_u32(out: []char, offset: *usize, value: u32) void {
    Varint.write_u64(out, offset, @as(u64, value));
  }

  /// Write `value` as zigzag LEB128 at `offset`.
  pub fn write_i64(out: []char, offset: *usize, value: i64) void {
    const zigzag = (@as(u64, value) << 1) ^ @as(u64, value >> 63);
    Varint.write_u64(out, offset, zigzag);
  }

  /// Write `value` as zigzag LEB128 at `offset`.
  pub fn write_i32(out: []char, offset: *usize, value: i32) void {
    const zigzag = (@as(u32, value) << 1) ^ @as(u32, value >> 31);
    Varint.write_u64(out, offset, @as(u64, zigzag));
  }

  /// Read unsigned LEB128 from `data` at `offset`, advancing it.
  pub fn read_u64(data: []const char, offset: *usize) Option[u64] {
    let value: u64 = 0;
    let shift: u32 = 0;
    let i = (*offset);

    while (i < data.len) {
      const byte = @as(u64, @as(u32, data[i]) & 255);
      if (shift == 63 && (byte & 126) != 0) {
        return Option.None;
      };
      value |= (byte & 127) << @as(u64, shift);
      i += 1;
      if ((byte & 128) == 0) {
        (*offset) = i;
        return Option.Some(value);
      };
      shift += 7;
      if (shift > 63) {
        return Option.None;
      };
    }

    return Option.None;
  }

  /// Read unsigned LEB128 from `data` at `offset`, advancing it.
  pub fn read_u32(data: []const char, offset: *usize) Option[u32] {
    const value = Varint.read_u64(data, offset);
    if (value.is_none()) {
      return Option.None;
    };
    if (value.unwrap() > 4294967295) {
      return Option.None;
    };

    return Option.Some(@as(u32, value.unwrap()));
  }

  /// Read zigzag LEB128 from `data` at `offset`, advancing it.
  pub fn read_i64(data: []const char, offset: *usize) Option[i64] {
    const value = Varint.read_u64(data, offset);
    if (value.is_none()) {
      return Option.None;
    };
    const zigzag = value.unwrap();

    return Option.Some(@as(i64, (zigzag >> 1) ^ (@as(u64, 0) - (zigzag & 1))));
  }

  /// Read zigzag LEB128 from `data` at `offset`, advancing it.
  pub fn read_i32(data: []const char, offset: *usize) Option[i32] {
    const value = Varint.read_i64(data, offset);
    if (value.is_none()) {
      return Option.None;
    };
    const decoded = value.unwrap();
    if (decoded < -2147483648 || decoded > 2147483647) {
      return Option.None;
    };

    return Option.Some(@as(i32, decoded));
  }
}
