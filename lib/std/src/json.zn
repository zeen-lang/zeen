use std.string;
use std.fmt;
use std.collections.list;
use std.collections.map;

comptime MaxJsonDepth = 128;

comptime SurrogateMin = 55296;
comptime SurrogateHighMax = 56319;
comptime SurrogateLowMin = 56320;
comptime SurrogateMax = 57343;

/// JSON parse error.
pub struct JsonError {
  pub kind: JsonErrorKind,
  pub pos: usize,
}

/// JSON parse error kinds.
pub enum JsonErrorKind {
  UnexpectedChar,
  UnexpectedEnd,
  TrailingData,
  DepthExceeded,
  InvalidNumber,
  InvalidEscape,
  TypeMismatch,
  MissingField,
}

/// JSON value, numbers kept as raw text.
pub enum JsonValue {
  Null,
  Bool: bool,
  Num: String,
  Str: String,
  Array: List[JsonValue],
  Object: JsonObject,
}

implement JsonValue {
  /// Parse a JSON document.
  pub fn parse(text: []const char) Result[JsonValue, JsonError] {
    let parser = JsonParser { .text = text, .pos = 0 };
    parser.skip_ws();

    const parsed = parser.parse_value(0)?;
    parser.skip_ws();
    if (parser.pos != text.len) {
      return Result.Err(JsonError { .kind = JsonErrorKind.TrailingData, .pos = parser.pos });
    };

    return Result.Ok(parsed);
  }

  /// Render compact JSON text.
  pub fn stringify(*const self) String {
    let out = String.new();
    self.write_into(&out);
    return out;
  }

  /// Object member by key, `None` outside objects.
  pub fn get(*const self, key: []const char) Option[*const JsonValue] {
    return switch (*self) {
      .Object(&obj) => obj.get(key),
      _ => Option.None,
    };
  }

  /// Array element by index, `None` outside arrays.
  pub fn at(*const self, index: usize) Option[*const JsonValue] {
    return switch (*self) {
      .Array(&items) => JsonValue.at_index(items, index),
      _ => Option.None,
    };
  }

  fn at_index(items: *const List[JsonValue], index: usize) Option[*const JsonValue] {
    const found = items.get_ptr(index);
    if (found.is_none()) {
      return Option.None;
    };
    const slot: *const JsonValue = found.unwrap();
    return Option.Some(slot);
  }

  /// Element count of arrays and objects, zero otherwise.
  pub fn len(*const self) usize {
    return switch (*self) {
      .Array(&items) => items.len(),
      .Object(&obj) => obj.len(),
      _ => 0,
    };
  }

  /// Checks the `null` value.
  pub fn is_null(*const self) bool {
    return switch (*self) {
      .Null => true,
      _ => false,
    };
  }

  /// Checks a boolean.
  pub fn is_bool(*const self) bool {
    return switch (*self) {
      .Bool(&_) => true,
      _ => false,
    };
  }

  /// Checks a number.
  pub fn is_num(*const self) bool {
    return switch (*self) {
      .Num(&_) => true,
      _ => false,
    };
  }

  /// Checks a string.
  pub fn is_str(*const self) bool {
    return switch (*self) {
      .Str(&_) => true,
      _ => false,
    };
  }

  /// Checks an array.
  pub fn is_array(*const self) bool {
    return switch (*self) {
      .Array(&_) => true,
      _ => false,
    };
  }

  /// Checks an object.
  pub fn is_object(*const self) bool {
    return switch (*self) {
      .Object(&_) => true,
      _ => false,
    };
  }

  /// Boolean value, `None` for other kinds.
  pub fn as_bool(*const self) Option[bool] {
    return switch (*self) {
      .Bool(value) => Option.Some(value),
      _ => Option.None,
    };
  }

  /// Number text, `None` for other kinds.
  pub fn as_num(*const self) Option[String] {
    return switch (*self) {
      .Num(&text) => Option.Some(text.clone()),
      _ => Option.None,
    };
  }

  /// Integer value, `None` when the text is no integer.
  pub fn as_i64(*const self) Option[i64] {
    const text = self.as_num();
    if (text.is_none()) {
      return Option.None;
    };
    return text.unwrap().parse_i64();
  }

  /// Unsigned integer value, `None` when the text is no integer.
  pub fn as_u64(*const self) Option[u64] {
    const text = self.as_num();
    if (text.is_none()) {
      return Option.None;
    };
    return text.unwrap().parse_u64();
  }

  /// Floating point value, `None` when the text is no number.
  pub fn as_f64(*const self) Option[f64] {
    const text = self.as_num();
    if (text.is_none()) {
      return Option.None;
    };
    return text.unwrap().parse_f64();
  }

  /// String value, `None` for other kinds.
  pub fn as_str(*const self) Option[String] {
    return switch (*self) {
      .Str(&text) => Option.Some(text.clone()),
      _ => Option.None,
    };
  }

  /// Writes compact JSON text into `out`.
  pub fn write_into(*const self, out: *String) {
    switch (*self) {
      .Null => {
        out.push_str("null");
      },
      .Bool(value) => {
        if (value) {
          out.push_str("true");
        } else {
          out.push_str("false");
        };
      },
      .Num(&text) => {
        text.display(out);
      },
      .Str(&text) => {
        JsonValue.write_string(out, text);
      },
      .Array(&items) => {
        out.push('[');
        let i: usize = 0;
        while (i < items.len()) {
          if (i != 0) {
            out.push(',');
          };
          const elem = items.get_ptr(i).unwrap();
          elem.write_into(out);
          i += 1;
        }
        out.push(']');
      },
      .Object(&obj) => {
        obj.write_into(out);
      },
    };
  }

  /// Writes `text` as a quoted JSON string into `out`.
  pub fn write_text(out: *String, text: []const char) {
    const hex: []const char = "0123456789abcdef";
    const backslash = @as(char, 92);
    out.push('"');

    let i: usize = 0;
    while (i < text.len) {
      const c = text[i];
      if (c == '"') {
        out.push(backslash);
        out.push('"');
      } else if (c == backslash) {
        out.push(backslash);
        out.push(backslash);
      } else if (c == @as(char, 8)) {
        out.push(backslash);
        out.push('b');
      } else if (c == @as(char, 12)) {
        out.push(backslash);
        out.push('f');
      } else if (c == @as(char, 10)) {
        out.push(backslash);
        out.push('n');
      } else if (c == @as(char, 13)) {
        out.push(backslash);
        out.push('r');
      } else if (c == @as(char, 9)) {
        out.push(backslash);
        out.push('t');
      } else if (@as(u32, c) < 32) {
        out.push(backslash);
        out.push('u');
        out.push('0');
        out.push('0');
        out.push(hex[@as(usize, @as(u32, c) >> 4)]);
        out.push(hex[@as(usize, @as(u32, c) & 15)]);
      } else {
        out.push(c);
      };
      i += 1;
    }

    out.push('"');
  }

  /// Writes `text` as a quoted JSON string into `out`.
  pub fn write_string(out: *String, text: *String) {
    JsonValue.write_text(out, text.slice(..));
  }
}

/// Object backing in insert order, fast lookup.
struct JsonObject {
  map: HashMap[String, JsonValue],
  keys: List[String],
}

implement JsonObject {
  /// Empty object.
  pub fn new() Self {
    return JsonObject { .map = HashMap#[String, JsonValue].new(), .keys = List#[String].new() };
  }

  /// Stores the value and keeps the key order.
  pub fn insert(*self, key: String, value: JsonValue) {
    if (!self.map.contains_key(&key)) {
      self.keys.push(key.clone());
    };
    let _ = self.map.insert(key, value);
  }

  /// Borrow of the value under `key`.
  pub fn get(*const self, key: []const char) Option[*const JsonValue] {
    const owned = String.from(key);
    return self.map.get(&owned);
  }

  /// Key at `index`, panics out of range.
  pub fn key_at(*const self, index: usize) *String {
    return self.keys.get_ptr(index).unwrap();
  }

  /// Value at `index`, panics out of range.
  pub fn get_at(*const self, index: usize) *const JsonValue {
    const key = self.key_at(index);
    return self.map.get(key).unwrap();
  }

  /// Number of entries.
  pub fn len(*const self) usize {
    return self.keys.len();
  }

  /// Writes the object as JSON text.
  pub fn write_into(*const self, out: *String) {
    out.push('{');
    let i: usize = 0;
    while (i < self.keys.len()) {
      if (i != 0) {
        out.push(',');
      };
      const key = self.key_at(i);
      JsonValue.write_string(out, key);
      out.push(':');
      const value = self.get_at(i);
      value.write_into(out);
      i += 1;
    }
    out.push('}');
  }
}

struct JsonParser {
  pub text: []const char,
  pub pos: usize,
}

implement JsonParser {
  fn peek(*const self) Option[char] {
    if (self.pos >= self.text.len) {
      return Option.None;
    };
    return Option.Some(self.text[self.pos]);
  }

  fn peek_is(*const self, want: char) bool {
    const c = self.peek();
    if (c.is_none()) {
      return false;
    };
    return c.unwrap() == want;
  }

  fn bump(*self) {
    self.pos += 1;
  }

  fn bump_if(*self, want: char) bool {
    if (self.peek_is(want)) {
      self.pos += 1;
      return true;
    };
    return false;
  }

  /// Skips whitespace at the current position.
  pub fn skip_ws(*self) {
    while (self.pos < self.text.len) {
      const ch = self.text[self.pos];
      if (ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r') {
        self.bump();
      } else {
        return;
      };
    }
  }

  /// Parses one value at the current position.
  pub fn parse_value(*self, depth: usize) Result[JsonValue, JsonError] {
    if (depth > MaxJsonDepth) {
      return Result.Err(JsonError { .kind = JsonErrorKind.DepthExceeded, .pos = self.pos });
    };

    self.skip_ws();
    const head = self.peek();
    if (head.is_none()) {
      return Result.Err(JsonError { .kind = JsonErrorKind.UnexpectedEnd, .pos = self.pos });
    };

    const ch = head.unwrap();
    if (ch == '{') {
      return self.parse_object(depth);
    };
    if (ch == '[') {
      return self.parse_array(depth);
    };
    if (ch == '"') {
      const text = self.parse_string();
      if (text.is_err()) {
        return Result.Err(text.unwrap_err());
      };
      return Result.Ok(JsonValue.Str(text.unwrap()));
    };
    if (ch == 't') {
      return self.parse_literal("true", JsonValue.Bool(true));
    };
    if (ch == 'f') {
      return self.parse_literal("false", JsonValue.Bool(false));
    };
    if (ch == 'n') {
      return self.parse_literal("null", JsonValue.Null);
    };
    if (ch == '-' || JsonParser.is_digit(ch)) {
      return self.parse_number();
    };

    return Result.Err(JsonError { .kind = JsonErrorKind.UnexpectedChar, .pos = self.pos });
  }

  fn parse_literal(*self, word: []const char, value: JsonValue) Result[JsonValue, JsonError] {
    let i: usize = 0;
    while (i < word.len) {
      const c = self.peek();
      if (c.is_none() || c.unwrap() != word[i]) {
        return Result.Err(JsonError { .kind = JsonErrorKind.UnexpectedChar, .pos = self.pos });
      };
      self.bump();
      i += 1;
    }
    return Result.Ok(value);
  }

  fn parse_array(*self, depth: usize) Result[JsonValue, JsonError] {
    self.bump();
    let out = List#[JsonValue].new();

    self.skip_ws();
    if (self.bump_if(']')) {
      return Result.Ok(JsonValue.Array(out));
    };

    while (self.pos < self.text.len) {
      const item = self.parse_value(depth + 1);
      if (item.is_err()) {
        return Result.Err(item.unwrap_err());
      };
      out.push(item.unwrap());

      self.skip_ws();
      if (self.bump_if(',')) {
        self.skip_ws();
        if (self.bump_if(']')) {
          return Result.Ok(JsonValue.Array(out));
        };
        continue;
      };
      if (self.bump_if(']')) {
        return Result.Ok(JsonValue.Array(out));
      };
      return Result.Err(JsonError { .kind = JsonErrorKind.UnexpectedChar, .pos = self.pos });
    }

    return Result.Err(JsonError { .kind = JsonErrorKind.UnexpectedEnd, .pos = self.pos });
  }

  fn parse_object(*self, depth: usize) Result[JsonValue, JsonError] {
    self.bump();
    let out = JsonObject.new();

    self.skip_ws();
    if (self.bump_if('}')) {
      return Result.Ok(JsonValue.Object(out));
    };

    while (self.pos < self.text.len) {
      self.skip_ws();
      if (!self.peek_is('"')) {
        return Result.Err(JsonError { .kind = JsonErrorKind.UnexpectedChar, .pos = self.pos });
      };
      const key = self.parse_string();
      if (key.is_err()) {
        return Result.Err(key.unwrap_err());
      };

      self.skip_ws();
      if (!self.peek_is(':')) {
        return Result.Err(JsonError { .kind = JsonErrorKind.UnexpectedChar, .pos = self.pos });
      };
      self.bump();
      self.skip_ws();

      const value = self.parse_value(depth + 1);
      if (value.is_err()) {
        return Result.Err(value.unwrap_err());
      };
      out.insert(key.unwrap(), value.unwrap());

      self.skip_ws();
      if (self.bump_if(',')) {
        self.skip_ws();
        if (self.bump_if('}')) {
          return Result.Ok(JsonValue.Object(out));
        };
        continue;
      };
      if (self.bump_if('}')) {
        return Result.Ok(JsonValue.Object(out));
      };
      return Result.Err(JsonError { .kind = JsonErrorKind.UnexpectedChar, .pos = self.pos });
    }

    return Result.Err(JsonError { .kind = JsonErrorKind.UnexpectedEnd, .pos = self.pos });
  }

  fn parse_string(*self) Result[String, JsonError] {
    self.bump();
    let out = String.new();

    while (self.pos < self.text.len) {
      const ch = self.text[self.pos];
      if (ch == '"') {
        self.bump();
        return Result.Ok(out);
      };

      if (@as(u32, ch) == 92) {
        self.bump();
        const esc = self.parse_escape();
        if (esc.is_err()) {
          return Result.Err(esc.unwrap_err());
        };
        out.push_rune(esc.unwrap());
        continue;
      };

      if (@as(u32, ch) < 32) {
        return Result.Err(JsonError { .kind = JsonErrorKind.UnexpectedChar, .pos = self.pos });
      };

      out.push(ch);
      self.bump();
    }

    return Result.Err(JsonError { .kind = JsonErrorKind.UnexpectedEnd, .pos = self.pos });
  }

  fn parse_escape(*self) Result[Rune, JsonError] {
    const head = self.peek();
    if (head.is_none()) {
      return Result.Err(JsonError { .kind = JsonErrorKind.UnexpectedEnd, .pos = self.pos });
    };

    const ch = head.unwrap();
    self.bump();

    if (ch == '"') {
      return Result.Ok(Rune.from_u32_unchecked(@as(u32, ch)));
    };
    if (ch == @as(char, 92)) {
      return Result.Ok(Rune.from_u32_unchecked(@as(u32, ch)));
    };
    if (ch == '/') {
      return Result.Ok(Rune.from_u32_unchecked(@as(u32, ch)));
    };
    if (ch == 'b') {
      return Result.Ok(Rune.from_u32_unchecked(8));
    };
    if (ch == 'f') {
      return Result.Ok(Rune.from_u32_unchecked(12));
    };
    if (ch == 'n') {
      return Result.Ok(Rune.from_u32_unchecked(10));
    };
    if (ch == 'r') {
      return Result.Ok(Rune.from_u32_unchecked(13));
    };
    if (ch == 't') {
      return Result.Ok(Rune.from_u32_unchecked(9));
    };
    if (ch == 'u') {
      return self.parse_unicode();
    };
    return Result.Err(JsonError { .kind = JsonErrorKind.InvalidEscape, .pos = self.pos });
  }

  fn parse_unicode(*self) Result[Rune, JsonError] {
    const hi = self.parse_hex4();
    if (hi.is_err()) {
      return Result.Err(hi.unwrap_err());
    };
    const high = hi.unwrap();

    if (high < SurrogateMin || high > SurrogateMax) {
      return Result.Ok(Rune.from_u32_unchecked(high));
    };
    if (high > SurrogateHighMax) {
      return Result.Err(JsonError { .kind = JsonErrorKind.InvalidEscape, .pos = self.pos });
    };

    const slash = self.peek();
    if (slash.is_none() || slash.unwrap() != @as(char, 92)) {
      return Result.Err(JsonError { .kind = JsonErrorKind.InvalidEscape, .pos = self.pos });
    };
    self.bump();

    const marker = self.peek();
    if (marker.is_none() || marker.unwrap() != 'u') {
      return Result.Err(JsonError { .kind = JsonErrorKind.InvalidEscape, .pos = self.pos });
    };
    self.bump();

    const lo = self.parse_hex4();
    if (lo.is_err()) {
      return Result.Err(lo.unwrap_err());
    };
    const low = lo.unwrap();

    if (low < SurrogateLowMin || low > SurrogateMax) {
      return Result.Err(JsonError { .kind = JsonErrorKind.InvalidEscape, .pos = self.pos });
    };

    const value = 0x10000 + ((high - SurrogateMin) << 10) + (low - SurrogateLowMin);

    return Result.Ok(Rune.from_u32_unchecked(value));
  }

  fn parse_hex4(*self) Result[u32, JsonError] {
    let value: u32 = 0;
    let i: i32 = 0;
    while (i < 4) {
      const head = self.peek();
      if (head.is_none()) {
        return Result.Err(JsonError { .kind = JsonErrorKind.UnexpectedEnd, .pos = self.pos });
      };
      const digit = JsonParser.hex_value(head.unwrap());
      if (digit.is_none()) {
        return Result.Err(JsonError { .kind = JsonErrorKind.InvalidEscape, .pos = self.pos });
      };
      value = value * 16 + digit.unwrap();
      self.bump();
      i += 1;
    }
    return Result.Ok(value);
  }

  fn hex_value(c: char) Option[u32] {
    const code = @as(u32, c);
    if (code >= @as(u32, '0') && code <= @as(u32, '9')) {
      return Option.Some(code - @as(u32, '0'));
    };
    if (code >= @as(u32, 'a') && code <= @as(u32, 'f')) {
      return Option.Some(code - @as(u32, 'a') + 10);
    };
    if (code >= @as(u32, 'A') && code <= @as(u32, 'F')) {
      return Option.Some(code - @as(u32, 'A') + 10);
    };
    return Option.None;
  }

  fn parse_number(*self) Result[JsonValue, JsonError] {
    const start = self.pos;

    if (self.peek_is('-')) {
      self.bump();
    };

    if (!self.take_int_part()) {
      return Result.Err(JsonError { .kind = JsonErrorKind.InvalidNumber, .pos = start });
    };

    if (self.bump_if('.')) {
      if (!self.take_digits()) {
        return Result.Err(JsonError { .kind = JsonErrorKind.InvalidNumber, .pos = start });
      };
    };

    const mark = self.peek();
    if (mark.is_some() && (mark.unwrap() == 'e' || mark.unwrap() == 'E')) {
      self.bump();
      if (self.peek_is('-') || self.peek_is('+')) {
        self.bump();
      };
      if (!self.take_digits()) {
        return Result.Err(JsonError { .kind = JsonErrorKind.InvalidNumber, .pos = start });
      };
    };

    return Result.Ok(JsonValue.Num(String.from(self.text[start..self.pos])));
  }

  fn take_int_part(*self) bool {
    const c = self.peek();
    if (c.is_none()) {
      return false;
    };
    if (c.unwrap() == '0') {
      self.bump();
      return true;
    };
    return self.take_digits();
  }

  fn take_digits(*self) bool {
    const start = self.pos;
    while (self.pos < self.text.len) {
      const c = self.text[self.pos];
      if (!JsonParser.is_digit(c)) {
        break;
      };
      self.bump();
    }
    return self.pos > start;
  }

  fn is_digit(c: char) bool {
    const code = @as(u32, c);
    return code >= @as(u32, '0') && code <= @as(u32, '9');
  }
}

implement JsonError {
  /// Error for a value of the wrong JSON kind.
  pub fn type_mismatch() Self {
    return JsonError { .kind = JsonErrorKind.TypeMismatch, .pos = 0 };
  }

  /// Error for an absent object member.
  pub fn missing_field() Self {
    return JsonError { .kind = JsonErrorKind.MissingField, .pos = 0 };
  }
}

/// Typed JSON encoder.
pub interface JsonEncode {
  /// Writes `self` as compact JSON into `out`.
  pub fn encode_json(*const self, out: *String);
}

/// Typed JSON decoder.
pub interface JsonDecode {
  /// Reads `Self` from a parsed JSON value.
  pub fn decode_json(value: *const JsonValue) Result[Self, JsonError];
}

/// Writer for one JSON object.
pub struct JsonObjectWriter {
  out: *String,
  first: bool,
}

implement JsonObjectWriter {
  /// Starts an object in `out`.
  pub fn begin(out: *String) Self {
    out.push('{');
    return JsonObjectWriter { .out = out, .first = true };
  }

  /// Writes a member name.
  pub fn field(*self, name: []const char) {
    if (!self.first) {
      self.out.push(',');
    };
    self.first = false;
    JsonValue.write_text(self.out, name);
    self.out.push(':');
  }

  /// Writes a member name and an encoded value.
  pub fn field_value[T: JsonEncode](*self, name: []const char, value: *const T) {
    self.field(name);
    value.encode_json(self.out);
  }

  /// Closes the object.
  pub fn end(*self) {
    self.out.push('}');
  }
}

/// Typed JSON entry points.
pub struct Json {}

implement Json {
  /// Encodes `value` into compact JSON.
  pub fn encode[T: JsonEncode](value: *const T) String {
    let out = String.new();
    value.encode_json(&out);
    return out;
  }

  /// Parses `text` and decodes it into `T`.
  pub fn decode[T: JsonDecode](text: []const char) Result[T, JsonError] {
    const parsed = JsonValue.parse(text)?;
    return T.decode_json(&parsed);
  }
}

implement JsonEncode : builtin bool {
  fn encode_json(*const self, out: *String) {
    if (*self) {
      out.push_str("true");
    } else {
      out.push_str("false");
    };
  }
}

implement JsonEncode : builtin i8 {
  fn encode_json(*const self, out: *String) {
    Fmt.write_int(out, @as(i64, (*self)));
  }
}

implement JsonEncode : builtin i16 {
  fn encode_json(*const self, out: *String) {
    Fmt.write_int(out, @as(i64, (*self)));
  }
}

implement JsonEncode : builtin i32 {
  fn encode_json(*const self, out: *String) {
    Fmt.write_int(out, @as(i64, (*self)));
  }
}

implement JsonEncode : builtin i64 {
  fn encode_json(*const self, out: *String) {
    Fmt.write_int(out, (*self));
  }
}

implement JsonEncode : builtin isize {
  fn encode_json(*const self, out: *String) {
    Fmt.write_int(out, @as(i64, (*self)));
  }
}

