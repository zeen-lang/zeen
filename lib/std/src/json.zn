    (*self).display(out);
  }
}

implement JsonEncode : builtin []const char {
  fn encode_json(*const self, out: *String) {
    JsonValue.write_text(out, (*self));
  }
}

implement JsonEncode : String {
  fn encode_json(*const self, out: *String) {
    JsonValue.write_text(out, self.slice(..));
  }
}

implement[T: JsonEncode] JsonEncode : Option[T] {
  fn encode_json(*const self, out: *String) {
    switch (*self) {
      .None => {
        out.push_str("null");
      },
      .Some(&value) => {
        value.encode_json(out);
      },
    };
  }
}

implement[T: JsonEncode] JsonEncode : List[T] {
  fn encode_json(*const self, out: *String) {
    out.push('[');
    let i: usize = 0;
    while (i < self.len()) {
      if (i != 0) {
        out.push(',');
      };
      const item = self.get_ptr(i).unwrap();
      item.encode_json(out);
      i += 1;
    };
    out.push(']');
  }
}

implement JsonDecode : builtin bool {
  fn decode_json(value: *const JsonValue) Result[bool, JsonError] {
    const found = value.as_bool();
    if (found.is_none()) {
      return Result.Err(JsonError.type_mismatch());
    };
    return Result.Ok(found.unwrap());
  }
}

implement JsonDecode : builtin i8 {
  fn decode_json(value: *const JsonValue) Result[i8, JsonError] {
    const found = value.as_i64();
    if (found.is_none()) {
      return Result.Err(JsonError.type_mismatch());
    };
    const number = found.unwrap();
    if (number < -128 || number > 127) {
      return Result.Err(JsonError.type_mismatch());
    };
    return Result.Ok(@as(i8, number));
  }
}

implement JsonDecode : builtin i16 {
  fn decode_json(value: *const JsonValue) Result[i16, JsonError] {
    const found = value.as_i64();
