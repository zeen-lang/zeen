implement JsonEncode : builtin f32 {
  fn encode_json(*const self, out: *String) {
    if (!(*self).is_finite()) {
      out.push_str("null");
      return;
    };
    (*self).display(out);
  }
}

implement JsonEncode : builtin f64 {
  fn encode_json(*const self, out: *String) {
    if (!(*self).is_finite()) {
      out.push_str("null");
