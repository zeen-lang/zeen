implement JsonDecode : builtin f32 {
  fn decode_json(value: *const JsonValue) Result[f32, JsonError] {
    const found = value.as_f64();
    if (found.is_none()) {
      return Result.Err(JsonError.type_mismatch());
    };
    const number = @as(f32, found.unwrap());
    if (!number.is_finite()) {
      return Result.Err(JsonError.type_mismatch());
    };
    return Result.Ok(number);
  }
}

