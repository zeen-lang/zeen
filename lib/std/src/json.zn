implement[T: JsonDecode] JsonDecode : Option[T] {
  fn decode_json(value: *const JsonValue) Result[Option[T], JsonError] {
    if (value.is_null()) {
      return Result.Ok(Option.None);
    };
    const inner = T.decode_json(value);
    if (inner.is_err()) {
      return Result.Err(inner.unwrap_err());
    };
    return Result.Ok(Option.Some(inner.unwrap()));
  }
}

implement[T: JsonDecode] JsonDecode : List[T] {
  fn decode_json(value: *const JsonValue) Result[List[T], JsonError] {
    if (!value.is_array()) {
      return Result.Err(JsonError.type_mismatch());
    };
    let out = List#[T].new();
    let i: usize = 0;
    while (i < value.len()) {
      const item = T.decode_json(value.at(i).unwrap());
      if (item.is_err()) {
        return Result.Err(item.unwrap_err());
      };
      out.push(item.unwrap());
      i += 1;
    };
    return Result.Ok(out);
  }
}
