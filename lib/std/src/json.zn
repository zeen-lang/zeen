implement JsonDecode : builtin isize {
  fn decode_json(value: *const JsonValue) Result[isize, JsonError] {
    const found = value.as_i64();
    if (found.is_none()) {
      return Result.Err(JsonError.type_mismatch());
    };
    const number = found.unwrap();
    const limit = @as(i64, @as(isize, 0) - 1);
    if (number < -limit - 1 || number > limit) {
      return Result.Err(JsonError.type_mismatch());
    };
    return Result.Ok(@as(isize, number));
  }
}

