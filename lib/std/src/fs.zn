use std.alloc;
use std.string;
use std.path;
use std.collections.list;
use std.io;
use std.c.types;
use std.c.string;
use std.c.stdio;
use std.c.stdlib;
use std.c.errno;

@os[windows] {
  use std.c.windows.windef;
  use std.c.windows.winbase;
  use std.c.windows.fileapi;
  use std.c.windows.processthreadsapi;
} else {
  use std.c.posix.fcntl;
  use std.c.posix.unistd;
  use std.c.posix.sys.stat;
  use std.c.posix.dirent;
}

/// Null terminated copy of a path for C calls.
fn cpath(path: []const char) String {
  let s = String.from(path);
  s.push('\0');
  s
}

/// Offset for `File.seek`.
pub enum SeekFrom {
  Start: u64,
  End: i64,
  Current: i64,
}

/// Kind of a filesystem entry.
pub enum FileType {
  File,
  Dir,
  Symlink,
  Other,
}

@os[windows] {
  fn filetime_seconds(value: c_FileTime) i64 {
    const ticks = (@as(u64, value.high) << @as(u64, 32)) | @as(u64, value.low);

    return @as(i64, ticks / 10000000) - 11644473600;
  }
}

/// Owned file handle. Closes itself on drop.
pub struct File {
  fd: c_int,
  handle: *void,
}

implement File {
  /// Open an existing file for reading.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.NotFound
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.NotADirectory
  /// * IoErrorKind.Uncategorized
  pub fn open(path: []const char) Result[File, IoError] {
    @os[windows] {
      let c = cpath(path);
      let arg = @as([*]const c_char, c.slice(..).ptr);
      let handle = CreateFileA(
        arg,
        GENERIC_READ,
        FILE_SHARE_READ | FILE_SHARE_WRITE,
        nullptr,
        OPEN_EXISTING,
        FILE_ATTRIBUTE_NORMAL,
        nullptr,
      );

      if (handle == INVALID_HANDLE_VALUE) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(File { .fd = -1, .handle = @as(*void, handle) });
    } else {
      let c = cpath(path);
      const fd = open(@as([*]const char, c.slice(..).ptr), O_RDONLY, 0);

      if (fd < 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(File { .fd = fd, .handle = nullptr });
    }
  }

  /// Create or truncate a file for writing.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.IsADirectory
  /// * IoErrorKind.NotADirectory
  /// * IoErrorKind.Uncategorized
  pub fn create(path: []const char) Result[File, IoError] {
    @os[windows] {
      let c = cpath(path);
      let arg = @as([*]const c_char, c.slice(..).ptr);
      let handle = CreateFileA(
        arg,
        GENERIC_WRITE,
        FILE_SHARE_READ | FILE_SHARE_WRITE,
        nullptr,
        CREATE_ALWAYS,
        FILE_ATTRIBUTE_NORMAL,
        nullptr,
      );

      if (handle == INVALID_HANDLE_VALUE) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(File { .fd = -1, .handle = @as(*void, handle) });
    } else {
      let c = cpath(path);
      const fd = open(@as([*]const char, c.slice(..).ptr), O_CREAT | O_WRONLY | O_TRUNC, 0o666);

      if (fd < 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(File { .fd = fd, .handle = nullptr });
    }
  }

  /// Read some bytes, appending them to buffer. `Ok(0)` means end of file.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.Interrupted
  /// * IoErrorKind.IsADirectory
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.Uncategorized
  pub fn read(*self, buf: *String) Result[usize, IoError] {
    @os[windows] {
      let chunk: [256]char = @uninit();
      let got: WinDWORD = 0;
      let ok = ReadFile(
        @as(WinHANDLE, self.handle),
        @as(*void, &chunk[0]),
        256,
        &got,
        nullptr,
      );

      if (ok == 0) {
        return Result.Err(IoError.last_os_error());
      };

      if (got == 0) {
        return Result.Ok(@as(usize, 0));
      };

      (*buf).push_str(chunk[0..@as(usize, got)]);

      return Result.Ok(@as(usize, got));
    } else {
      let chunk: [256]char = @uninit();
      const got = read(self.fd, @as(*void, &chunk[0]), 256);

      if (got < 0) {
        return Result.Err(IoError.last_os_error());
      };

      if (got == 0) {
        return Result.Ok(@as(usize, 0));
      };

      (*buf).push_str(chunk[0..@as(usize, got)]);

      return Result.Ok(@as(usize, got));
    }
  }

  /// Read exactly `n` bytes, appending them to buffer.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.Interrupted
  /// * IoErrorKind.IsADirectory
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.UnexpectedEof
  /// * IoErrorKind.Uncategorized
  pub fn read_exact(*self, buf: *String, n: usize) Result[usize, IoError] {
    @os[windows] {
      let total: usize = 0;

      while (total < n) {
        let chunk: [256]char = @uninit();
        let want: usize = 256;

        if (n - total < want) {
          want = n - total;
        };

        let got: WinDWORD = 0;
        let ok = ReadFile(
          @as(WinHANDLE, self.handle),
          @as(*void, &chunk[0]),
          @as(WinDWORD, want),
          &got,
          nullptr,
        );

        if (ok == 0) {
          return Result.Err(IoError.last_os_error());
        };

        if (got == 0) {
          return Result.Err(IoError.new(IoErrorKind.UnexpectedEof, "early end of file"));
        };

        (*buf).push_str(chunk[0..@as(usize, got)]);
        total += @as(usize, got);
      };

      return Result.Ok(total);
    } else {
      let total: usize = 0;

      while (total < n) {
        let chunk: [256]char = @uninit();
        let want: usize = 256;

        if (n - total < want) {
          want = n - total;
        };

        const got = read(self.fd, @as(*void, &chunk[0]), want);

        if (got < 0) {
          return Result.Err(IoError.last_os_error());
        };

        if (got == 0) {
          return Result.Err(IoError.new(IoErrorKind.UnexpectedEof, "early end of file"));
        };

        (*buf).push_str(chunk[0..@as(usize, got)]);
        total += @as(usize, got);
      };

      return Result.Ok(total);
    }
  }

  /// Read the whole file into buffer.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.Interrupted
  /// * IoErrorKind.IsADirectory
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.Uncategorized
  pub fn read_to_string(*self, buf: *String) Result[usize, IoError] {
    let total: usize = 0;

    while (true) {
      const got = self.read(buf)?;

      if (got == 0) {
        break;
      } else {
        total += got;
      }
    };

    return Result.Ok(total);
  }

  /// Write some bytes from the slice.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.Interrupted
  /// * IoErrorKind.Uncategorized
  pub fn write(*self, buf: []const char) Result[usize, IoError] {
    @os[windows] {
      let written: WinDWORD = 0;
      let ok = WriteFile(
        @as(WinHANDLE, self.handle),
        @as(*const void, buf.ptr),
        @as(WinDWORD, buf.len),
        &written,
        nullptr,
      );

      if (ok == 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(@as(usize, written));
    } else {
      const n = write(self.fd, @as([*]const void, buf.ptr), buf.len);

      if (n < 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(@as(usize, n));
    }
  }

  /// Write the whole slice, retrying short writes.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.Interrupted
  /// * IoErrorKind.WriteZero
  /// * IoErrorKind.Uncategorized
  pub fn write_all(*self, buf: []const char) Result[usize, IoError] {
    let total: usize = 0;

    while (total < buf.len) {
      const rest = buf[total..buf.len];

      const n = self.write(rest)?;

      if (n == 0) {
        return Result.Err(IoError.new(IoErrorKind.WriteZero, "failed to write whole buffer"));
      } else {
        total += n;
      }
    };

    return Result.Ok(total);
  }

  /// Flush file contents to disk.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.Interrupted
  /// * IoErrorKind.Uncategorized
  pub fn sync_all(*const self) Result[void, IoError] {
    @os[windows] {
      if (FlushFileBuffers(@as(WinHANDLE, self.handle)) == 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(.{});
    } else {
      if (fsync(self.fd) != 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(.{});
    }
  }

  /// Metadata of this file.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.Uncategorized
  pub fn metadata(*const self) Result[Metadata, IoError] {
    @os[windows] {
      let high: WinDWORD = 0;
      let low = GetFileSize(@as(WinHANDLE, self.handle), &high);

      if (low == INVALID_FILE_ATTRIBUTES && GetLastError() != 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(Metadata {
        ._len = (@as(u64, high) << @as(u64, 32)) | @as(u64, low),
        ._is_dir = false,
        ._is_file = true,
        ._is_symlink = false,
        ._mode = 0,
        ._atime = 0,
        ._mtime = 0,
        ._ctime = 0,
      });
    } else {
      let st: c_Stat = @uninit();

      if (fstat(self.fd, &st) != 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(metadata_of(&st));
    }
  }

  /// Move the read/write cursor.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.InvalidInput
  /// * IoErrorKind.Uncategorized
  pub fn seek(*self, from: SeekFrom) Result[u64, IoError] {
    @os[windows] {
      let method: WinDWORD = FILE_BEGIN;
      let distance: i64 = 0;

      switch (from) {
        .Start(value) => {
          distance = @as(i64, value);
        },
        .End(value) => {
          method = FILE_END;
          distance = value;
        },
        .Current(value) => {
          method = FILE_CURRENT;
          distance = value;
        },
      };

      const move = c_LargeInteger {
        .low = @as(WinDWORD, @as(u32, distance)),
        .high = @as(c_long, distance >> @as(i64, 32)),
      };
      let out: c_LargeInteger = @uninit();

      if (SetFilePointerEx(@as(WinHANDLE, self.handle), move, &out, method) == 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok((@as(u64, out.high) << @as(u64, 32)) | @as(u64, out.low));
    } else {
      let whence: c_int = SEEK_SET;
      let offset: c_off_t = 0;

      switch (from) {
        .Start(value) => {
          offset = @as(c_off_t, value);
        },
        .End(value) => {
          whence = SEEK_END;
          offset = @as(c_off_t, value);
        },
        .Current(value) => {
          whence = SEEK_CUR;
          offset = @as(c_off_t, value);
        },
      };

      const pos = lseek(self.fd, offset, whence);

      if (pos < 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(@as(u64, pos));
    }
  }

  /// Truncate or extend the file to `size` bytes.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.InvalidInput
  /// * IoErrorKind.Uncategorized
  pub fn set_len(*self, size: u64) Result[void, IoError] {
    @os[windows] {
      const distance: i64 = @as(i64, size);
      const move = c_LargeInteger {
        .low = @as(WinDWORD, @as(u32, distance)),
        .high = @as(c_long, distance >> @as(i64, 32)),
      };
      let out: c_LargeInteger = @uninit();

      if (SetFilePointerEx(@as(WinHANDLE, self.handle), move, &out, FILE_BEGIN) == 0) {
        return Result.Err(IoError.last_os_error());
      };

      if (SetEndOfFile(@as(WinHANDLE, self.handle)) == 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(.{});
    } else {
      if (ftruncate(self.fd, @as(c_off_t, size)) != 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(.{});
    }
  }

  /// Duplicate the handle, sharing the same open file.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.Uncategorized
  pub fn try_clone(*const self) Result[File, IoError] {
    @os[windows] {
      let out: WinHANDLE = nullptr;
      const process = GetCurrentProcess();

      if (DuplicateHandle(process, @as(WinHANDLE, self.handle), process, &out, 0, 0, DUPLICATE_SAME_ACCESS) == 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(File { .fd = -1, .handle = @as(*void, out) });
    } else {
      const fd = dup(self.fd);

      if (fd < 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(File { .fd = fd, .handle = nullptr });
    }
  }

  /// Read up to and including the next newline, appending it to `buf`.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.Interrupted
  /// * IoErrorKind.IsADirectory
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.Uncategorized
  pub fn read_line(*self, buf: *String) Result[usize, IoError] {
    let total: usize = 0;
    let done = false;

    while (!done) {
      let chunk: [1]char = @uninit();

      @os[windows] {
        let got: WinDWORD = 0;
        const ok = ReadFile(@as(WinHANDLE, self.handle), @as(*void, &chunk[0]), 1, &got, nullptr);

        if (ok == 0) {
          return Result.Err(IoError.last_os_error());
        };

        if (got == 0) {
          return Result.Ok(total);
        };

        (*buf).push(chunk[0]);
        total += 1;
        done = chunk[0] == '\n';
      } else {
        const got = read(self.fd, @as(*void, &chunk[0]), 1);

        if (got < 0) {
          return Result.Err(IoError.last_os_error());
        };

        if (got == 0) {
          return Result.Ok(total);
        };

        (*buf).push(chunk[0]);
        total += 1;
        done = chunk[0] == '\n';
      }
    };

    return Result.Ok(total);
  }
}

implement Drop : File {
  fn drop(self) {
    @os[windows] {
      let _ = CloseHandle(self.handle);
    } else {
      let _ = close(self.fd);
    }
  }
}

/// File open options builder.
pub struct OpenOptions {
  _read: bool,
  _write: bool,
  _append: bool,
  _truncate: bool,
  _create: bool,
  _create_new: bool,
  _mode: u32,
}

implement OpenOptions {
  /// Options for a readonly open.
  pub fn new() Self {
    Self {
      ._read = false,
      ._write = false,
      ._append = false,
      ._truncate = false,
      ._create = false,
      ._create_new = false,
      ._mode = 0o666,
    }
  }

  /// Sets the read flag.
  pub fn read(self, value: bool) Self {
    let opts = self;
    opts._read = value;
    opts
  }

  /// Sets the write flag.
  pub fn write(self, value: bool) Self {
    let opts = self;
    opts._write = value;
    opts
  }

  /// Sets the append flag.
  pub fn append(self, value: bool) Self {
    let opts = self;
    opts._append = value;
    opts
  }

  /// Sets the truncate flag.
  pub fn truncate(self, value: bool) Self {
    let opts = self;
    opts._truncate = value;
    opts
  }

  /// Sets the create flag.
  pub fn create(self, value: bool) Self {
    let opts = self;
    opts._create = value;
    opts
  }

  /// Sets the create flag that fails on an existing file.
  pub fn create_new(self, value: bool) Self {
    let opts = self;
    opts._create_new = value;
    opts
  }

  /// Sets the permission bits for a new file.
  pub fn mode(self, value: u32) Self {
    let opts = self;
    opts._mode = value;
    opts
  }

  /// Open a file with these options.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.NotFound
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.AlreadyExists
  /// * IoErrorKind.IsADirectory
  /// * IoErrorKind.NotADirectory
  /// * IoErrorKind.Uncategorized
  pub fn open(*const self, path: []const char) Result[File, IoError] {
    @os[windows] {
      let access = GENERIC_READ;

      if (self._write) {
        access = GENERIC_WRITE;
      };

      if (self._read && self._write) {
        access = GENERIC_READ | GENERIC_WRITE;
      };

      let disposition = OPEN_EXISTING;

      if (self._create_new) {
        disposition = CREATE_NEW;
      } else if (self._create && self._truncate) {
        disposition = CREATE_ALWAYS;
      } else if (self._create) {
        disposition = OPEN_ALWAYS;
      } else if (self._truncate) {
        disposition = TRUNCATE_EXISTING;
      };

      let c = cpath(path);
      let handle = CreateFileA(
        @as([*]const c_char, c.slice(..).ptr),
        access,
        FILE_SHARE_READ | FILE_SHARE_WRITE,
        nullptr,
        disposition,
        FILE_ATTRIBUTE_NORMAL,
        nullptr,
      );

      if (handle == INVALID_HANDLE_VALUE) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(File { .fd = -1, .handle = @as(*void, handle) });
    } else {
      let flags = O_RDONLY;

      if (self._write) {
        flags = O_WRONLY;
      };

      if (self._read && self._write) {
        flags = O_RDWR;
      };

      if (self._append) {
        flags = flags | O_APPEND;
      };

      if (self._truncate) {
        flags = flags | O_TRUNC;
      };

      if (self._create) {
        flags = flags | O_CREAT;
      };

      if (self._create_new) {
        flags = flags | O_CREAT | O_EXCL;
      };

      let c = cpath(path);
      const fd = open(@as([*]const char, c.slice(..).ptr), flags, @as(c_mode_t, self._mode));

      if (fd < 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(File { .fd = fd, .handle = nullptr });
    }
  }
}

/// File metadata snapshot.
pub struct Metadata {
  _len: u64,
  _is_dir: bool,
  _is_file: bool,
  _is_symlink: bool,
  _mode: u32,
  _atime: i64,
  _mtime: i64,
  _ctime: i64,
}

implement Metadata {
  /// File size in bytes.
  pub fn len(*const self) u64 {
    self._len
  }

  /// Checks that the size is zero.
  pub fn is_empty(*const self) bool {
    self._len == 0
  }

  /// Checks a directory.
  pub fn is_dir(*const self) bool {
    self._is_dir
  }

  /// Checks a regular file.
  pub fn is_file(*const self) bool {
    self._is_file
  }

  /// Checks a symlink.
  pub fn is_symlink(*const self) bool {
    self._is_symlink
  }

  /// Permission bits.
  pub fn mode(*const self) u32 {
    self._mode
  }

  /// Kind of the entry.
  pub fn file_type(*const self) FileType {
    if (self._is_dir) {
      return FileType.Dir;
    };

    if (self._is_symlink) {
      return FileType.Symlink;
    };

    if (self._is_file) {
      return FileType.File;
    };

    return FileType.Other;
  }

  /// Last access time in seconds since the epoch.
  pub fn accessed(*const self) i64 {
    self._atime
  }

  /// Last modification time in seconds since the epoch.
  pub fn modified(*const self) i64 {
    self._mtime
  }

  /// Creation time in seconds since the epoch.
  pub fn created(*const self) i64 {
    self._ctime
  }
}

@os[linux | android | darwin | freebsd] {
  fn metadata_of(st: *const c_Stat) Metadata {
    const kind = (*st).st_mode & S_IFMT;

    Metadata {
      ._len = @as(u64, (*st).st_size),
      ._is_dir = kind == S_IFDIR,
      ._is_file = kind == S_IFREG,
      ._is_symlink = kind == S_IFLNK,
      ._mode = @as(u32, (*st).st_mode),
      ._atime = @as(i64, (*st).st_atime),
      ._mtime = @as(i64, (*st).st_mtime),
      ._ctime = @as(i64, (*st).st_ctime),
    }
  }
}

/// One directory entry: name plus full path.
pub struct DirEntry {
  _name: String,
  _path: String,
  _is_dir: bool,
  _is_file: bool,
  _is_symlink: bool,
}

implement DirEntry {
  /// Entry name without the directory part.
  pub fn into_name(self) String {
    self._name
  }

  /// Full path of the entry.
  pub fn into_path(self) String {
    self._path
  }

  /// Full path of the entry as a borrowed slice.
  pub fn path(*const self) []const char {
    self._path.slice(..)
  }

  /// Checks a directory.
  pub fn is_dir(*const self) bool {
    self._is_dir
  }

  /// Checks a regular file.
  pub fn is_file(*const self) bool {
    self._is_file
  }

  /// Checks a symlink.
  pub fn is_symlink(*const self) bool {
    self._is_symlink
  }
}

/// Permission flags of a filesystem entry.
pub struct Permissions {
  _readonly: bool,
}

implement Permissions {
  /// Writable permissions.
  pub fn new() Self {
    return Self { ._readonly = false };
  }

  /// Read-only or writable.
  pub fn from_readonly(value: bool) Self {
    return Self { ._readonly = value };
  }

  /// Checks that writes are denied.
  pub fn readonly(*const self) bool {
    return self._readonly;
  }

  /// Makes the entry read-only or writable.
  pub fn set_readonly(*self, value: bool) {
    self._readonly = value;
  }
}

/// Filesystem helpers on paths.
/// Static methods on purpose: plain free functions would collide
/// with user names once imported.
pub struct Fs {
  /// Metadata of the file at `path`, following symlinks.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.NotFound
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.NotADirectory
  /// * IoErrorKind.Uncategorized
  pub fn metadata(path: []const char) Result[Metadata, IoError] {
    @os[windows] {
      let c = cpath(path);
      let data: c_FileAttrData = @uninit();

      if (GetFileAttributesExA(@as([*]const c_char, c.slice(..).ptr), 0, &data) == 0) {
        return Result.Err(IoError.last_os_error());
      };

      let dir = (data.attributes & FILE_ATTRIBUTE_DIRECTORY) != 0;

      return Result.Ok(Metadata {
        ._len = (@as(u64, data.size_high) << @as(u64, 32)) | @as(u64, data.size_low),
        ._is_dir = dir,
        ._is_file = !dir,
        ._is_symlink = false,
        ._mode = 0,
        ._atime = filetime_seconds(data.accessed),
        ._mtime = filetime_seconds(data.written),
        ._ctime = filetime_seconds(data.created),
      });
    } else {
      let c = cpath(path);
      let st: c_Stat = @uninit();

      if (stat(@as([*]const char, c.slice(..).ptr), &st) != 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(metadata_of(&st));
    }
  }

  /// Metadata of the link at `path` itself.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.NotFound
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.NotADirectory
  /// * IoErrorKind.Unsupported
  /// * IoErrorKind.Uncategorized
  pub fn symlink_metadata(path: []const char) Result[Metadata, IoError] {
    @os[windows] {
      return Result.Err(IoError.new(IoErrorKind.Unsupported, "symlink_metadata needs reparse points"));
    } else {
      let c = cpath(path);
      let st: c_Stat = @uninit();

      if (lstat(@as([*]const char, c.slice(..).ptr), &st) != 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(metadata_of(&st));
    }
  }

  /// `true` when `path` can be stated.
  pub fn exists(path: []const char) bool {
    @os[windows] {
      let c = cpath(path);

      return GetFileAttributesA(@as([*]const c_char, c.slice(..).ptr)) != INVALID_FILE_ATTRIBUTES;
    } else {
      let c = cpath(path);
      let st: c_Stat = @uninit();

      return stat(@as([*]const char, c.slice(..).ptr), &st) == 0;
    }
  }

  /// Delete a file.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.NotFound
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.IsADirectory
  /// * IoErrorKind.Uncategorized
  pub fn remove_file(path: []const char) Result[void, IoError] {
    @os[windows] {
      let c = cpath(path);

      if (DeleteFileA(@as([*]const c_char, c.slice(..).ptr)) == 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(.{});
    } else {
      let c = cpath(path);

      if (unlink(@as([*]const char, c.slice(..).ptr)) != 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(.{});
    }
  }

  /// Delete an empty directory.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.NotFound
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.NotADirectory
  /// * IoErrorKind.Uncategorized
  pub fn remove_dir(path: []const char) Result[void, IoError] {
    @os[windows] {
      let c = cpath(path);

      if (RemoveDirectoryA(@as([*]const c_char, c.slice(..).ptr)) == 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(.{});
    } else {
      let c = cpath(path);

      if (rmdir(@as([*]const char, c.slice(..).ptr)) != 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(.{});
    }
  }

  /// Create a directory with mode `0o755`.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.AlreadyExists
  /// * IoErrorKind.NotADirectory
  /// * IoErrorKind.Uncategorized
  pub fn create_dir(path: []const char) Result[void, IoError] {
    @os[windows] {
      let c = cpath(path);

      if (CreateDirectoryA(@as([*]const c_char, c.slice(..).ptr), nullptr) == 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(.{});
    } else {
      let c = cpath(path);

      if (mkdir(@as([*]const char, c.slice(..).ptr), 0o755) != 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(.{});
    }
  }

  /// Move a file or directory to a new path.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.NotFound
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.AlreadyExists
  /// * IoErrorKind.Uncategorized
  pub fn rename(from: []const char, to: []const char) Result[void, IoError] {
    @os[windows] {
      let cfrom = cpath(from);
      let cto = cpath(to);

      if (MoveFileA(@as([*]const c_char, cfrom.slice(..).ptr), @as([*]const c_char, cto.slice(..).ptr)) == 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(.{});
    } else {
      let cfrom = cpath(from);
      let cto = cpath(to);

      if (rename(@as([*]const char, cfrom.slice(..).ptr), @as([*]const char, cto.slice(..).ptr)) != 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(.{});
    }
  }

  /// List directory entries, skipping `.` and `..`.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.NotFound
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.NotADirectory
  /// * IoErrorKind.Uncategorized
  pub fn read_dir(path: []const char) Result[List[DirEntry], IoError] {
    @os[windows] {
      let pattern = String.from(path);
      pattern.push('/');
      pattern.push('*');
      let cpattern = cpath(pattern.slice(..));

      let data: c_FindData = @uninit();
      let dir = FindFirstFileA(@as([*]const c_char, cpattern.slice(..).ptr), &data);

      if (dir == INVALID_HANDLE_VALUE) {
        return Result.Err(IoError.last_os_error());
      };

      let out = List#[DirEntry].new();

      while (true) {
        let raw = @as([*]const char, &data.name[0]);

        if (raw[0] == '.') {
          if (raw[1] == '\0') {
            if (FindNextFileA(dir, &data) == 0) {
              break;
            };
            continue;
          };

          if (raw[1] == '.' && raw[2] == '\0') {
            if (FindNextFileA(dir, &data) == 0) {
              break;
            };
            continue;
          };
        };

        let name = String.from_cstr(raw);

        let full = String.from(path);
        full.push('/');
        full.push_str(name.slice(..));

        let dir_flag = (data.attributes & FILE_ATTRIBUTE_DIRECTORY) != 0;

        out.push(DirEntry {
          ._name = name,
          ._path = full,
          ._is_dir = dir_flag,
          ._is_file = !dir_flag,
          ._is_symlink = false,
        });

        if (FindNextFileA(dir, &data) == 0) {
          break;
        };
      };

      let _ = FindClose(dir);

      return Result.Ok(out);
    } else {
      let c = cpath(path);
      const dir = opendir(@as([*]const char, c.slice(..).ptr));

      if (dir == nullptr) {
        return Result.Err(IoError.last_os_error());
      };

      let out = List#[DirEntry].new();

      while (true) {
        let e = readdir(dir);

        if (e == nullptr) {
          break;
        };

        const raw = @as([*]const char, &(*e).d_name[0]);

        if (raw[0] == '.') {
          if (raw[1] == '\0') {
            continue;
          };

          if (raw[1] == '.' && raw[2] == '\0') {
            continue;
          };
        };

        let name = String.from_cstr(raw);

        let full = String.from(path);
        full.push('/');
        full.push_str(name.slice(..));

        const dtype = (*e).d_type;

        out.push(DirEntry {
          ._name = name,
          ._path = full,
          ._is_dir = dtype == DT_DIR,
          ._is_file = dtype == DT_REG,
          ._is_symlink = dtype == DT_LNK,
        });
      };

      let _ = closedir(dir);

      return Result.Ok(out);
    }
  }

  /// Read the whole file at `path` into a new string.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.NotFound
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.IsADirectory
  /// * IoErrorKind.Interrupted
  /// * IoErrorKind.Uncategorized
  pub fn read_to_string(path: []const char) Result[String, IoError] {
    switch (File.open(path)) {
      .Ok(f) => {
        let buf = String.new();
        let mut_file = f;

        switch (mut_file.read_to_string(&buf)) {
          .Ok(_bytes) => Result.Ok(buf),
          .Err(e) => {
            return Result.Err(e);
          }
        }
      },
      .Err(e) => {
        return Result.Err(e);
      }
    }
  }

  /// Create or truncate the file at `path` and write `contents` into it.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.IsADirectory
  /// * IoErrorKind.Interrupted
  /// * IoErrorKind.WriteZero
  /// * IoErrorKind.Uncategorized
  pub fn write(path: []const char, contents: []const char) Result[usize, IoError] {
    switch (File.create(path)) {
      .Ok(f) => {
        let mut_file = f;

        switch (mut_file.write_all(contents)) {
          .Ok(n) => Result.Ok(n),
          .Err(e) => {
            return Result.Err(e);
          }
        }
      },
      .Err(e) => {
        return Result.Err(e);
      }
    }
  }

  /// Create a directory and any missing parents.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.NotADirectory
  /// * IoErrorKind.Uncategorized
  pub fn create_dir_all(path: []const char) Result[void, IoError] {
    if (path.len == 0) {
      return Result.Ok(.{});
    };

    switch (Fs.metadata(path)) {
      .Ok(meta) => {
        if (meta.is_dir()) {
          return Result.Ok(.{});
        };

        return Result.Err(IoError.new(IoErrorKind.NotADirectory, "path exists and is not a directory"));
      },
      .Err(&_) => {},
    }

    const up = Path.new(path).parent();

    if (up.is_some()) {
      const base = up.unwrap().as_str();

      if (base.len > 0) {
        switch (Fs.create_dir_all(base)) {
          .Ok(_) => {},
          .Err(e) => {
            return Result.Err(e);
          },
        }
      };
    };

    switch (Fs.create_dir(path)) {
      .Ok(_) => Result.Ok(.{}),
      .Err(e) => {
        if (Fs.exists(path)) {
          return Result.Ok(.{});
        };

        return Result.Err(e);
      },
    }
  }

  /// Delete a directory with everything inside it.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.NotFound
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.NotADirectory
  /// * IoErrorKind.Uncategorized
  pub fn remove_dir_all(path: []const char) Result[void, IoError] {
    let is_link = false;

    switch (Fs.symlink_metadata(path)) {
      .Ok(meta) => {
        is_link = meta.is_symlink();
      },
      .Err(&_) => {},
    }

    switch (Fs.metadata(path)) {
      .Ok(meta) => {
        if (is_link || !meta.is_dir()) {
          return Fs.remove_file(path);
        };
      },
      .Err(e) => {
        return Result.Err(e);
      },
    }

    switch (Fs.read_dir(path)) {
      .Ok(entries) => {
        let rest = entries;

        while (true) {
          const next = rest.pop();

          if (next.is_none()) {
            break;
          };

          const entry = next.unwrap();
          const is_dir = entry.is_dir();
          const is_entry_link = entry.is_symlink();
          const child = entry.into_path();

          if (is_dir && !is_entry_link) {
            switch (Fs.remove_dir_all(child.slice(..))) {
              .Ok(_) => {},
              .Err(e) => {
                return Result.Err(e);
              },
            }
          } else {
            switch (Fs.remove_file(child.slice(..))) {
              .Ok(_) => {},
              .Err(e) => {
                return Result.Err(e);
              },
            }
          };
        };
      },
      .Err(e) => {
        return Result.Err(e);
      },
    }

    return Fs.remove_dir(path);
  }

  /// Copy the file at `from` over `to`, returning the copied size.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.NotFound
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.IsADirectory
  /// * IoErrorKind.Uncategorized
  pub fn copy(from: []const char, to: []const char) Result[u64, IoError] {
    switch (Fs.read_to_string(from)) {
      .Ok(contents) => {
        switch (Fs.write(to, contents.slice(..))) {
          .Ok(size) => Result.Ok(@as(u64, size)),
          .Err(e) => Result.Err(e),
        }
      },
      .Err(e) => Result.Err(e),
    }
  }

  /// Create an additional directory entry for an existing file.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.NotFound
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.AlreadyExists
  /// * IoErrorKind.Uncategorized
  pub fn hard_link(from: []const char, to: []const char) Result[void, IoError] {
    @os[windows] {
      let cfrom = cpath(from);
      let cto = cpath(to);

      if (CreateHardLinkA(@as([*]const c_char, cto.slice(..).ptr), @as([*]const c_char, cfrom.slice(..).ptr), nullptr) == 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(.{});
    } else {
      let cfrom = cpath(from);
      let cto = cpath(to);

      if (linkat(AT_FDCWD, @as([*]const char, cfrom.slice(..).ptr), AT_FDCWD, @as([*]const char, cto.slice(..).ptr), 0) != 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(.{});
    }
  }

  /// Create a symbolic link at `link_path` pointing to `target`.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.AlreadyExists
  /// * IoErrorKind.Uncategorized
  pub fn symlink(target: []const char, link_path: []const char) Result[void, IoError] {
    @os[windows] {
      let ctarget = cpath(target);
      let clink = cpath(link_path);

      if (CreateSymbolicLinkA(@as([*]const c_char, clink.slice(..).ptr), @as([*]const c_char, ctarget.slice(..).ptr), 0) == 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(.{});
    } else {
      let ctarget = cpath(target);
      let clink = cpath(link_path);

      if (symlink(@as([*]const char, ctarget.slice(..).ptr), @as([*]const char, clink.slice(..).ptr)) != 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(.{});
    }
  }

  /// Target of the symbolic link at `path`.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.NotFound
  /// * IoErrorKind.InvalidInput
  /// * IoErrorKind.Unsupported
  /// * IoErrorKind.Uncategorized
  pub fn read_link(path: []const char) Result[String, IoError] {
    @os[windows] {
      return Result.Err(IoError.new(IoErrorKind.Unsupported, "read_link needs reparse points"));
    } else {
      let c = cpath(path);
      let buf: [4096]char = @uninit();
      const got = readlink(@as([*]const char, c.slice(..).ptr), @as([*]char, &buf[0]), 4096);

      if (got < 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(String.from(buf[0..@as(usize, got)]));
    }
  }

  /// Absolute path with `.` and `..` resolved.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.NotFound
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.InvalidInput
  /// * IoErrorKind.Uncategorized
  pub fn canonicalize(path: []const char) Result[String, IoError] {
    @os[windows] {
      let c = cpath(path);
      let buf: [4096]char = @uninit();
      const got = GetFullPathNameA(@as([*]const c_char, c.slice(..).ptr), 4096, &buf[0], nullptr);

      if (got == 0 || got >= 4096) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(String.from(buf[0..@as(usize, got)]));
    } else {
      let c = cpath(path);
      const resolved = realpath(@as([*]const char, c.slice(..).ptr), @as([*]char, nullptr));

      if (resolved == nullptr) {
        return Result.Err(IoError.last_os_error());
      };

      const out = String.from_cstr(@as([*]const char, resolved));
      let _ = free(@as(*void, resolved));

      return Result.Ok(out);
    }
  }

  /// Replace the permission flags of `path`.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.NotFound
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.Uncategorized
  pub fn set_permissions(path: []const char, perms: Permissions) Result[void, IoError] {
    @os[windows] {
      let c = cpath(path);
      let attrs = GetFileAttributesA(@as([*]const c_char, c.slice(..).ptr));

      if (attrs == INVALID_FILE_ATTRIBUTES) {
        return Result.Err(IoError.last_os_error());
      };

      if (perms.readonly()) {
        attrs = attrs | FILE_ATTRIBUTE_READONLY;
      } else {
        attrs = attrs & ~FILE_ATTRIBUTE_READONLY;
      };

      if (SetFileAttributesA(@as([*]const c_char, c.slice(..).ptr), attrs) == 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(.{});
    } else {
      let c = cpath(path);
      let st: c_Stat = @uninit();

      if (stat(@as([*]const char, c.slice(..).ptr), &st) != 0) {
        return Result.Err(IoError.last_os_error());
      };

      let mode = @as(u32, st.st_mode) & 0o777;

      if (perms.readonly()) {
        mode = mode & ~@as(u32, 0o222);
      } else {
        mode = mode | 0o200;
      };

      if (chmod(@as([*]const char, c.slice(..).ptr), @as(c_mode_t, mode)) != 0) {
        return Result.Err(IoError.last_os_error());
      };

      return Result.Ok(.{});
    }
  }

  /// Every entry below `path`, parents before children.
  ///
  /// Possible IoError variants:
  /// * IoErrorKind.NotFound
  /// * IoErrorKind.PermissionDenied
  /// * IoErrorKind.NotADirectory
  /// * IoErrorKind.Uncategorized
  pub fn walk(path: []const char) Result[List[DirEntry], IoError] {
    let out = List#[DirEntry].new();

    switch (Fs.walk_into(path, &out)) {
      .Ok(_) => Result.Ok(out),
      .Err(e) => Result.Err(e),
    }
  }

  fn walk_into(path: []const char, out: *List[DirEntry]) Result[void, IoError] {
    switch (Fs.read_dir(path)) {
      .Ok(entries) => {
        let rest = entries;

        while (true) {
          const next = rest.pop();

          if (next.is_none()) {
            break;
          };

          const entry = next.unwrap();
          const is_dir = entry.is_dir();
          const is_entry_link = entry.is_symlink();

          if (is_dir && !is_entry_link) {
            const child = String.from(entry.path());

            (*out).push(entry);

            switch (Fs.walk_into(child.slice(..), out)) {
              .Ok(_) => {},
              .Err(e) => {
                return Result.Err(e);
              },
            }
          } else {
            (*out).push(entry);
          };
        };
      },
      .Err(e) => {
        return Result.Err(e);
      },
    }

    return Result.Ok(.{});
  }
}
