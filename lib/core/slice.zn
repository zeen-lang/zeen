// @zeen-core

/// Ranges variations:
/// * `lo..hi` - `{ start: Some, end: Some }`
/// * `lo..=hi` - `{ start: Some, end: Some + 1 }`
/// * `lo..` - `{ start: Some, end: None }`
/// * `..hi` - `{ start: None, end: Some }`
/// * `..=hi` - `{ start: None, end: Some + 1 }`
/// * `..` - `{ start: None, end: None }`
pub struct Range {
  pub start: Option[usize],
  pub end: Option[usize],
}

implement Range {
  /// Lower bound, `None` means an open start.
  pub fn first(*const self) Option[usize] {
    self.start
  }

  /// Upper bound, `None` means an open end.
  pub fn last(*const self) Option[usize] {
    self.end
  }
}

implement Copy : Range {}

implement Iterator : Range {
  alias Item = usize;

  /// Yields the next index in the range.
  pub fn next(*self) Option[usize] {
    const start = self.start.unwrap_or(0);
    const done = self.end.is_some() && start >= self.end.unwrap_or(0);

    if (!done) {
      self.start = Option.Some(start + 1);
      return Option.Some(start);
    };

    Option.None
  }
}

/// Container that supports `container[range]` slicing.
pub interface[T] Sliceable {
  /// Borrows `range` of the container.
  pub fn slice(*const self, range: Range) []T;
}
