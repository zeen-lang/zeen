// @zeen-core

/// Container that `Iterator.collect` can build.
pub interface FromIterator {
  alias Item;

  /// Empty container with `Item` already fixed.
  pub fn empty() Self;

  /// Appends one item.
  pub fn push(*self, item: Item);
}

/// Main Iterator interface.
pub interface Iterator {
  alias Item;

  /// Yields the next item.
  pub fn next(*self) Option[Item];

  /// Transforms every item with `f`.
  pub fn map[U, F: Callable(Item) U](self, f: F) MapIter[Self, U, F] {
    return MapIter#[Self, U, F] { .inner = self, .f = f };
  }

  /// Yields only items accepted by `pred`.
  pub fn filter[P: Callable(Item) bool](self, pred: P) FilterIter[Self, P] {
    return FilterIter#[Self, P] { .inner = self, .pred = pred };
  }

  /// Yields at most `count` items.
  pub fn take(self, count: usize) TakeIter[Self] {
    return TakeIter#[Self] { .inner = self, .remaining = count };
  }

  /// Drops the first `count` items.
  pub fn skip(self, count: usize) SkipIter[Self] {
    return SkipIter#[Self] { .inner = self, .remaining = count };
  }

  /// Checks that some item is accepted by `pred`.
  pub fn any[P: Callable(Item) bool](self, pred: P) bool {
    while (true) {
      switch (self.next()) {
        .Some(item) => {
          if (pred(item)) {
            return true;
          }
        },
        .None => { return false; },
      }
    }

    return false;
  }

  /// Checks that every item is accepted by `pred`.
  pub fn all[P: Callable(Item) bool](self, pred: P) bool {
    while (true) {
      switch (self.next()) {
        .Some(item) => {
          if (!pred(item)) {
            return false;
          }
        },
        .None => { return true; },
      }
    }

    return true;
  }

  /// Consumes the iterator and returns its last item.
  pub fn last_item(self) Option[Item] {
    let last: Option[Item] = Option.None;

    while (true) {
      switch (self.next()) {
        .Some(item) => { last = Option.Some(item); },
        .None => { break; },
      }
    }

    return last;
  }

  /// Consumes items up to `index` and returns that one.
  pub fn nth(self, index: usize) Option[Item] {
    let current: usize = 0;

    while (true) {
      switch (self.next()) {
        .Some(item) => {
          if (current == index) {
            return Option.Some(item);
          }

          current += 1;
        },
        .None => { return Option.None; },
      }
    }

    return Option.None;
  }

  /// Drains the iterator into a `FromIterator` container.
  pub fn collect[C: FromIterator](self) C
    where C.Item = Item {
    let out = C.empty();

    while (true) {
      switch (self.next()) {
        .Some(item) => { out.push(item); },
        .None => { break; },
      }
    }

    return out;
  }

  /// Consumes the iterator and counts its items.
  pub fn count(self) usize {
    let total: usize = 0;

    while (true) {
      switch (self.next()) {
        .Some(&_) => { total += 1; },
        .None => { break; },
      }
    }

    return total;
  }

  /// Calls `f` for every item.
  pub fn for_each[F: Callable(Item) void](self, f: F) {
    while (true) {
      switch (self.next()) {
        .Some(item) => { f(item); },
        .None => { break; },
      }
    }
  }

  /// Folds the items into one value with `f`.
  pub fn fold[Acc, F: Callable(Acc, Item) Acc](self, init: Acc, f: F) Acc {
    let acc = init;

    while (true) {
      switch (self.next()) {
        .Some(item) => { acc = f(acc, item); },
        .None => { break; },
      }
    }

    return acc;
  }
}

/// Iterator returned by `Iterator.map`.
pub struct MapIter[I: Iterator, U, F] {
  inner: I,
  f: F,
}

/// Iterator returned by `Iterator.filter`.
pub struct FilterIter[I: Iterator, P] {
  inner: I,
  pred: P,
}

implement[I: Iterator, U, F: Callable(I.Item) U] Iterator : MapIter[I, U, F] {
  alias Item = U;

  fn next(*self) Option[U] {
    switch (self.inner.next()) {
      .Some(item) => { return Option.Some((self.f)(item)); },
      .None => { return Option.None; },
    }
  }
}

implement[I: Iterator, P: Callable(I.Item) bool] Iterator : FilterIter[I, P] {
  alias Item = I.Item;

  fn next(*self) Option[I.Item] {
    while (true) {
      switch (self.inner.next()) {
        .Some(item) => {
          if ((self.pred)(item)) {
            return Option.Some(item);
          }
        },
        .None => { return Option.None; },
      }
    }

    return Option.None;
  }
}

/// Iterator returned by `Iterator.take`.
pub struct TakeIter[I: Iterator] {
  inner: I,
  remaining: usize,
}

implement[I: Iterator] Iterator : TakeIter[I] {
  alias Item = I.Item;

  fn next(*self) Option[I.Item] {
    if (self.remaining == 0) {
      return Option.None;
    }

    self.remaining -= 1;

    return self.inner.next();
  }
}

/// Iterator returned by `Iterator.skip`.
pub struct SkipIter[I: Iterator] {
  inner: I,
  remaining: usize,
}

implement[I: Iterator] Iterator : SkipIter[I] {
  alias Item = I.Item;

  fn next(*self) Option[I.Item] {
    while (self.remaining > 0) {
      self.remaining -= 1;

      switch (self.inner.next()) {
        .Some(&_) => {},
        .None => { return Option.None; },
      }
    }

    return self.inner.next();
  }
}

/// Returns struct that implements `Iterator` with pointer access.
pub interface PtrIterator {
  alias Iter: Iterator;

  /// Borrows an iterator over the items.
  pub fn iter(*const self) Iter;
}

/// Mutable borrowed iteration over a container.
pub interface MutPtrIterator {
  alias Iter: Iterator;

  /// Borrows an iterator with writable items.
  pub fn iter_mut(*self) Iter;
}

/// Converter from ownership `self` to struct with `Iterator` implementation.
pub interface OwnedIterator {
  alias Iter: Iterator;

  /// Takes the items out as an iterator.
  pub fn into_iter(self) Iter;
}
