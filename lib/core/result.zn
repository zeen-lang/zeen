// @zeen-core

/// Fallible value, either `Ok` or `Err`.
pub enum Result[T, E] {
  Ok: T,
  Err: E,
}

implement[T, E] Result[T, E] {
  /// Checks that the result holds `Ok`.
  pub fn is_ok(*const self) bool {
    @enumTag(self) == 0
  }

  /// Checks that the result holds `Err`.
  pub fn is_err(*const self) bool {
    @enumTag(self) == 1
  }

  /// Returns the `Ok` value or panics on `Err`.
  pub fn unwrap(self) T {
    switch (self) {
      .Ok(value) => value,
      .Err(_error) => @panic("Called `unwrap()` on `Err` result"),
    }
  }

  /// Returns the `Err` value or panics on `Ok`.
  pub fn unwrap_err(self) E {
    switch (self) {
      .Ok(_value) => @panic("Called `unwrap_err()` on `Ok` result"),
      .Err(error) => error,
    }
  }

  /// Returns the `Ok` value or `default`.
  pub fn unwrap_or(self, default: T) T {
    switch (self) {
      .Ok(value) => value,
      .Err(_error) => default,
    }
  }

  /// Returns the `Ok` value or the result of `f`.
  pub fn unwrap_or_else[F: CallableOnce() T](self, f: F) T {
    switch (self) {
      .Ok(value) => value,
      .Err(_error) => f(),
    }
  }

  /// Returns the `Ok` value or panics with `msg`.
  pub fn expect(self, msg: []const char) T {
    switch (self) {
      .Ok(value) => value,
      .Err(_error) => @panic("{}", msg),
    }
  }

  /// Returns the `Err` value or panics with `msg`.
  pub fn expect_err(self, msg: []const char) E {
    switch (self) {
      .Ok(_value) => @panic("{}", msg),
      .Err(error) => error,
    }
  }

  /// Converts the `Ok` value into `Option`.
  pub fn ok(self) Option[T] {
    switch (self) {
      .Ok(value) => Option.Some(value),
      .Err(_error) => Option#[T].None,
    }
  }

  /// Converts the `Err` value into `Option`.
  pub fn err(self) Option[E] {
    switch (self) {
      .Ok(_value) => Option.None,
      .Err(error) => Option.Some(error),
    }
  }

  /// Transforms the `Ok` value with `f`.
  pub fn map[U, F: CallableOnce(T) U](self, f: F) Result[U, E] {
    switch (self) {
      .Ok(value) => Result.Ok(f(value)),
      .Err(error) => Result.Err(error),
    }
  }

  /// Transforms the `Ok` value with `f` and wraps `default` on error.
  pub fn map_or[U, F: CallableOnce(T) U](self, f: F, default: U) Result[U, E] {
    switch (self) {
      .Ok(value) => Result.Ok(f(value)),
      .Err(_error) => Result.Ok(default),
    }
  }

  /// Transforms the `Err` value with `f`.
  pub fn map_err[G, F: CallableOnce(E) G](self, f: F) Result[T, G] {
    switch (self) {
      .Ok(value) => Result.Ok(value),
      .Err(error) => Result.Err(f(error)),
    }
  }

  /// Chains another fallible step with `f`.
  pub fn and_then[U, F: CallableOnce(T) Result[U, E]](self, f: F) Result[U, E] {
    switch (self) {
      .Ok(value) => f(value),
      .Err(error) => Result.Err(error),
    }
  }

  /// Calls `f` with a pointer to the `Ok` value and keeps the result.
  pub fn inspect[F: CallableOnce(*T) void](self, f: F) Self {
    switch (self) {
      .Ok(&value) => f(value),
      .Err(_error) => {},
    };

    self
  }

  /// Calls `f` with a pointer to the `Err` value and keeps the result.
  pub fn inspect_err[F: CallableOnce(*E) void](self, f: F) Self {
    switch (self) {
      .Ok(_value) => {},
      .Err(&error) => f(error),
    };

    self
  }
}

implement[T: Copy, E: Copy] Copy : Result[T, E] {}
