// @zeen-core

pub enum Option[T] {
  None,
  Some: T,
}

implement[T] Option[T] {
  pub fn is_some(*const self) bool {
    @enumTag(self) == 1
  }

  pub fn is_none(*const self) bool {
    @enumTag(self) == 0
  }

  pub fn unwrap(self) T {
    switch (self) {
      .None => @panic("Called `unwrap()` on `None` option"),
      .Some(value) => value,
    }
  }

  pub fn unwrap_or(self, default: T) T {
    switch (self) {
      .None => default,
      .Some(value) => value,
    }
  }

  pub fn unwrap_or_else[F: CallableOnce() T](self, f: F) T {
    switch (self) {
      .None => f(),
      .Some(value) => value,
    }
  }

  pub fn expect(self, msg: []const char) T {
    switch (self) {
      .Some(value) => value,
      .None => @panic("{}", msg),
    }
  }

  pub fn map[U, F: CallableOnce(T) U](self, f: F) Option[U] {
    switch (self) {
      .Some(value) => Option.Some(f(value)),
      .None => Option.None,
    }
  }

  pub fn map_or[U, F: CallableOnce(T) U](self, f: F, default: U) Option[U] {
    switch (self) {
      .Some(value) => Option.Some(f(value)),
      .None => Option.Some(default),
    }
  }

  pub fn inspect[F: CallableOnce(*T) void](self, f: F) Option[T] {
    switch (self) {
      .Some(&value) => f(value),
      .None => {}
    };

    self
  }

  pub fn ok_or[E](self, err: E) Result[T, E] {
    switch (self) {
      .Some(value) => Result.Ok(value),
      .None => Result.Err(err),
    }
  }

  pub fn ok_or_else[E, F: CallableOnce() E](self, f: F) Result[T, E] {
    switch (self) {
      .Some(value) => Result.Ok(value),
      .None => Result.Err(f()),
    }
  }

  pub fn and_then[U, F: CallableOnce(T) Option[U]](self, f: F) Option[U] {
    switch (self) {
      .Some(value) => f(value),
      .None => Option.None,
    }
  }

  pub fn filter[P: CallableOnce(*T) bool](self, predicate: P) Option[T] {
    switch (self) {
      .Some(value) => if (predicate(&value)) self else Option.None,
      .None => Option.None,
    }
  }
}

implement[T: Copy] Copy : Option[T] {}
