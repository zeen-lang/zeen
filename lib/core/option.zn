// @zeen-core

/// Optional value, either `None` or `Some`.
pub enum Option[T] {
  None,
  Some: T,
}

implement[T] Option[T] {
  /// Checks that a value is present.
  pub fn is_some(*const self) bool {
    @enumTag(self) == 1
  }

  /// Checks that no value is present.
  pub fn is_none(*const self) bool {
    @enumTag(self) == 0
  }

  /// Returns the value or panics on `None`.
  pub fn unwrap(self) T {
    switch (self) {
      .None => @panic("Called `unwrap()` on `None` option"),
      .Some(value) => value,
    }
  }

  /// Returns the value or `default`.
  pub fn unwrap_or(self, default: T) T {
    switch (self) {
      .None => default,
      .Some(value) => value,
    }
  }

  /// Returns the value or the result of `f`.
  pub fn unwrap_or_else[F: CallableOnce() T](self, f: F) T {
    switch (self) {
      .None => f(),
      .Some(value) => value,
    }
  }

  /// Returns the value or panics with `msg`.
  pub fn expect(self, msg: []const char) T {
    switch (self) {
      .Some(value) => value,
      .None => @panic("{}", msg),
    }
  }

  /// Transforms the value with `f`.
  pub fn map[U, F: CallableOnce(T) U](self, f: F) Option[U] {
    switch (self) {
      .Some(value) => Option.Some(f(value)),
      .None => Option.None,
    }
  }

  /// Transforms the value with `f` and wraps `default` when empty.
  pub fn map_or[U, F: CallableOnce(T) U](self, f: F, default: U) Option[U] {
    switch (self) {
      .Some(value) => Option.Some(f(value)),
      .None => Option.Some(default),
    }
  }

  /// Calls `f` with a pointer to the value and keeps the option.
  pub fn inspect[F: CallableOnce(*T) void](self, f: F) Option[T] {
    switch (self) {
      .Some(&value) => f(value),
      .None => {}
    };

    self
  }

  /// Converts into `Result` with `err` for `None`.
  pub fn ok_or[E](self, err: E) Result[T, E] {
    switch (self) {
      .Some(value) => Result.Ok(value),
      .None => Result.Err(err),
    }
  }

  /// Converts into `Result` with the result of `f` for `None`.
  pub fn ok_or_else[E, F: CallableOnce() E](self, f: F) Result[T, E] {
    switch (self) {
      .Some(value) => Result.Ok(value),
      .None => Result.Err(f()),
    }
  }

  /// Chains another optional step with `f`.
  pub fn and_then[U, F: CallableOnce(T) Option[U]](self, f: F) Option[U] {
    switch (self) {
      .Some(value) => f(value),
      .None => Option.None,
    }
  }

  /// Keeps the value only when `predicate` accepts it.
  pub fn filter[P: CallableOnce(*T) bool](self, predicate: P) Option[T] {
    switch (self) {
      .Some(value) => if (predicate(&value)) self else Option.None,
      .None => Option.None,
    }
  }
}

implement[T: Copy] Copy : Option[T] {}
